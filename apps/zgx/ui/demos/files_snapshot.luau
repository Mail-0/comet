		["apps/zgx/ui/screens/settings/browser_history.luau"] = "-- Settings → Browser → History: the pages you've visited in the panel's\n-- browser, kept for your account on this Mac (screens/panel/browser_data).\n-- One card for what's kept (whether, and clearing a span of it); under it\n-- the pages themselves, searched from one field and laid out by day, as a\n-- browser's history is read: each row the site's icon (its initial until\n-- the tab has fetched one), the page's title and address, and the time it\n-- was visited, at the row's end in the clock's figures. A page's × shows as\n-- the row is pointed at or reached from the keys, so a long list reads as\n-- pages, not as a column of buttons.\n\nlocal ds = require(\"@ds\")\nlocal toast = require(\"@ds/toast\")\nlocal locale = require(\"@ds/locale\")\nlocal IconButton = require(\"@ds/icon_button\").IconButton\nlocal search = require(\"@app/screens/settings/search\")\nlocal data = require(\"@app/screens/panel/browser_data\")\n\nlocal M = {}\n\nM.ID = \"browser_history\"\nM.TITLE = \"History\"\n\nsearch.index(M.ID, ui.t(\"settings.browser_history.title\"), ui.t(\"settings.browser.history_terms\"), {\n\t{ key = \"keep_history\", title = ui.t(\"settings.browser.keep_history.label\"), terms = ui.t(\"settings.browser.keep_history.terms\") },\n\t{ key = \"clear_history\", title = ui.t(\"settings.browser.clear_history.label\"), terms = ui.t(\"settings.browser.clear_history.terms\") },\n\t{ key = \"history\", title = ui.t(\"settings.browser.history_search\"), terms = ui.t(\"settings.browser.history_terms\") },\n})\n\nlocal function row(key: string, props: any): Node\n\treturn search.anchor(key, ds.Settings.Row(props))\nend\n\n-- The spans history clears over, and how far back each reaches.\nlocal SPANS: { [string]: number? } = { hour = 3600, day = 86400, week = 7 * 86400, month = 28 * 86400, all = nil }\nlocal function span_options(): { { value: string, label: string } }\n\treturn {\n\t\t{ value = \"hour\", label = ui.t(\"settings.browser.span.hour\"):get() },\n\t\t{ value = \"day\", label = ui.t(\"settings.browser.span.day\"):get() },\n\t\t{ value = \"week\", label = ui.t(\"settings.browser.span.week\"):get() },\n\t\t{ value = \"month\", label = ui.t(\"settings.browser.span.month\"):get() },\n\t\t{ value = \"all\", label = ui.t(\"settings.browser.span.all\"):get() },\n\t}\nend\nlocal span = ui.state(\"settings_browser_span\", \"hour\")\nlocal query = ui.state(\"settings_browser_history_query\", \"\")\n-- How many visits the list shows (more as asked).\nlocal SHOWN = 50\nlocal shown = ui.state(\"settings_browser_history_shown\", SHOWN)\n\n-- The visits matching the filter, newest first, as many as shown.\nlocal visits = ui.computed(function(): { data.Visit }\n\tlocal profile = data.profile()\n\tif not profile then\n\t\treturn {}\n\tend\n\tlocal q = string.lower(string.match(query:get(), \"^%s*(.-)%s*$\") or \"\")\n\tlocal most = shown:get()\n\tlocal out: { data.Visit } = {}\n\tfor _, v in data.history(profile) do\n\t\tif q == \"\" or string.find(string.lower(`{v.url} {v.title or \"\"}`), q, 1, true) then\n\t\t\ttable.insert(out, v)\n\t\t\tif #out >= most then\n\t\t\t\tbreak\n\t\t\tend\n\t\tend\n\tend\n\treturn out\nend)\nlocal function total(): number\n\tlocal profile = data.profile()\n\treturn if profile then #data.history(profile) else 0\nend\n\n-- The start of `at`'s day, on this Mac's clock.\nlocal function day_of(at: number): number\n\tlocal d = os.date(\"*t\", math.floor(at)) :: any\n\td.hour, d.min, d.sec = 0, 0, 0\n\treturn os.time(d)\nend\n\n-- What a day is called over its pages: Today, Yesterday, else its date\n-- (with its year only when it isn't this one's).\nlocal function day_name(start: number, today: number): string\n\tif start == today then\n\t\treturn ui.t(\"settings.browser_history.today\"):get()\n\telseif start == day_of(today - 43200) then\n\t\treturn ui.t(\"settings.browser_history.yesterday\"):get()\n\tend\n\tlocal this_year = (os.date(\"*t\", today) :: any).year\n\tlocal year = (os.date(\"*t\", start) :: any).year\n\treturn if year == this_year\n\t\tthen `{locale.weekday(start)}, {locale.month_day(start)}`\n\t\telse locale.date(start)\nend\n\ntype Day = { key: string, name: string, visits: { data.Visit } }\n\n-- The visits shown, by day, the latest day first.\nlocal days = ui.computed(function(): { Day }\n\tlocal today = day_of(os.time())\n\tlocal out: { Day } = {}\n\tlocal by: { [number]: Day } = {}\n\tfor _, v in visits:get() do\n\t\tlocal start = day_of(v.at)\n\t\tlocal day = by[start]\n\t\tif not day then\n\t\t\tday = { key = tostring(start), name = day_name(start, today), visits = {} }\n\t\t\tby[start] = day\n\t\t\ttable.insert(out, day)\n\t\tend\n\t\ttable.insert(day.visits, v)\n\tend\n\treturn out\nend)\n\nfunction M.clear(which: string)\n\tlocal profile = data.profile()\n\tif not profile then\n\t\treturn\n\tend\n\tlocal back = SPANS[which]\n\tdata.clear_history(profile, if back then os.time() - back else nil)\n\ttoast.show { title = ui.t(\"settings.browser.cleared\"):get(), tone = \"success\" }\nend\n\nlocal function host_of(url: string): string\n\treturn string.match(url, \"^%a[%w+.-]*://([^/?#:]+)\") or url\nend\n\n-- A page's row (its visit followed in place: a title arriving, its icon).\nlocal VisitRow = ui.component(function(props: { visit: data.Visit, now: State<any> }): Node\n\tlocal now = props.now\n\tlocal over = ui.use_state(false)\n\tlocal focused = ui.use_state(false)\n\tlocal function it(): data.Visit\n\t\treturn now:get() :: data.Visit\n\tend\n\tlocal function lit(): boolean\n\t\treturn over:get() or focused:get()\n\tend\n\treturn ui.row {\n\t\tclass = \"browser-visit\",\n\t\tw_full = true,\n\t\ton_hover = function(inside: boolean)\n\t\t\tover:set(inside)\n\t\tend,\n\t\tds.Settings.Row {\n\t\t\ttruncate = true,\n\t\t\tlead = ds.Tile {\n\t\t\t\tsize = 20,\n\t\t\t\tlabel = function(): string?\n\t\t\t\t\treturn data.site_name(host_of(it().url))\n\t\t\t\tend,\n\t\t\t\tsrc = function(): string?\n\t\t\t\t\treturn it().icon\n\t\t\t\tend,\n\t\t\t},\n\t\t\tlabel = function(): string\n\t\t\t\tlocal v = it()\n\t\t\t\treturn if v.title and v.title ~= \"\" then v.title else data.short(v.url)\n\t\t\tend,\n\t\t\tdescription = function(): string\n\t\t\t\treturn data.short(it().url)\n\t\t\tend,\n\t\t\t-- When it was visited, on the controls' edge; pointed at (or\n\t\t\t-- reached from the keys), the × to let it go in its place.\n\t\t\tcontrol = ui.div {\n\t\t\t\trelative = true,\n\t\t\t\titems = \"end\",\n\t\t\t\tjustify = \"center\",\n\t\t\t\th = \"$zeron.icon_button.sm\",\n\t\t\t\tui.text {\n\t\t\t\t\tfunction(): string\n\t\t\t\t\t\treturn locale.clock(it().at)\n\t\t\t\t\tend,\n\t\t\t\t\tliteral = true,\n\t\t\t\t\ttabular = true,\n\t\t\t\t\ttext_size = \"$font.size.sm\",\n\t\t\t\t\tcolor = \"$text.tertiary\",\n\t\t\t\t\topacity = function(): number\n\t\t\t\t\t\treturn if lit() then 0 else 1\n\t\t\t\t\tend,\n\t\t\t\t\taria_hidden = true,\n\t\t\t\t},\n\t\t\t\tui.div {\n\t\t\t\t\tabsolute = true,\n\t\t\t\t\tright = 0,\n\t\t\t\t\ttop = 0,\n\t\t\t\t\tIconButton {\n\t\t\t\t\t\ticon = \"close\",\n\t\t\t\t\t\tsize = \"sm\",\n\t\t\t\t\t\tlabel = ui.t(\"settings.browser.forget\", { page = props.visit.title or data.short(props.visit.url) }),\n\t\t\t\t\t\topacity = function(): number\n\t\t\t\t\t\t\treturn if lit() then 1 else 0\n\t\t\t\t\t\tend,\n\t\t\t\t\t\ton_focus = function()\n\t\t\t\t\t\t\tfocused:set(true)\n\t\t\t\t\t\tend,\n\t\t\t\t\t\ton_blur = function()\n\t\t\t\t\t\t\tfocused:set(false)\n\t\t\t\t\t\tend,\n\t\t\t\t\t\ton_click = function()\n\t\t\t\t\t\t\tlocal profile = data.profile()\n\t\t\t\t\t\t\tif profile then\n\t\t\t\t\t\t\t\tdata.forget(profile, props.visit.url)\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\tend,\n\t\t\t\t\t},\n\t\t\t\t},\n\t\t\t},\n\t\t},\n\t}\nend)\n\nlocal function visit_row(v: data.Visit, _i: number, now: State<any>): Node\n\treturn VisitRow { visit = v, now = now }\nend\n\n-- A day: its name over its card of pages.\nlocal function day_block(day: Day, _i: number, now: State<any>): Node\n\tlocal pages = ui.computed(function(): { data.Visit }\n\t\treturn (now:get() :: Day).visits\n\tend)\n\treturn ui.column {\n\t\tclass = \"browser-history-day\",\n\t\tw_full = true,\n\t\tgap = \"$space.2\",\n\t\tui.row {\n\t\t\tw_full = true,\n\t\t\tpx = ds.Settings.inset(),\n\t\t\tds.SectionTitle {\n\t\t\t\tfunction(): string\n\t\t\t\t\treturn (now:get() :: Day).name\n\t\t\t\tend,\n\t\t\t},\n\t\t},\n\t\t-- (Each washed edge to edge under the pointer, as every list of\n\t\t-- things in a card is: Settings.CatalogRow.)\n\t\tds.Settings.Each(pages, visit_row, {\n\t\t\tkey = function(v: data.Visit): string\n\t\t\t\treturn v.url\n\t\t\tend,\n\t\t\twash = true,\n\t\t}),\n\t}\nend\n\nfunction M.view(): Node\n\treturn ds.Settings.Page {\n\t\ttitle = ui.t(\"settings.browser_history.title\"),\n\t\tdescription = ui.t(\"settings.browser.history_description\"),\n\t\tds.Settings.Section {\n\t\t\tds.Settings.Group {\n\t\t\t\trow(\"keep_history\", {\n\t\t\t\t\tlabel = ui.t(\"settings.browser.keep_history.label\"),\n\t\t\t\t\tdescription = ui.t(\"settings.browser.keep_history.description\"),\n\t\t\t\t\tcontrol = ds.Switch { value = data.keep_history, label = ui.t(\"settings.browser.keep_history.label\") },\n\t\t\t\t}),\n\t\t\t\trow(\"clear_history\", {\n\t\t\t\t\tlabel = ui.t(\"settings.browser.clear_history.label\"),\n\t\t\t\t\tdescription = function(): string\n\t\t\t\t\t\treturn ui.t(\"settings.browser.clear_history.description\", { n = total() }):get()\n\t\t\t\t\tend,\n\t\t\t\t\tcontrol = ui.row {\n\t\t\t\t\t\tgap = \"$space.2\",\n\t\t\t\t\t\titems = \"center\",\n\t\t\t\t\t\tui.div {\n\t\t\t\t\t\t\tid = \"settings-browser-span\",\n\t\t\t\t\t\t\tds.Select { value = span, name = ui.t(\"settings.browser.clear_history.span\"), w = 144, options = span_options },\n\t\t\t\t\t\t},\n\t\t\t\t\t\tds.Button {\n\t\t\t\t\t\t\tid = \"settings-browser-clear\",\n\t\t\t\t\t\t\ttone = \"secondary\",\n\t\t\t\t\t\t\tdisabled = function(): boolean\n\t\t\t\t\t\t\t\treturn total() == 0\n\t\t\t\t\t\t\tend,\n\t\t\t\t\t\t\ton_click = function()\n\t\t\t\t\t\t\t\tM.clear(span:peek())\n\t\t\t\t\t\t\tend,\n\t\t\t\t\t\t\tui.text { ui.t(\"settings.browser.clear_history.button\") },\n\t\t\t\t\t\t},\n\t\t\t\t\t},\n\t\t\t\t}),\n\t\t\t},\n\t\t},\n\t\tsearch.anchor(\"history\", ui.column {\n\t\t\tw_full = true,\n\t\t\tgap = \"$space.5\",\n\t\t\t-- Nothing kept: what will be here, or that it's off.\n\t\t\tui.show(function(): boolean\n\t\t\t\treturn total() == 0\n\t\t\tend, ui.column {\n\t\t\t\tw_full = true,\n\t\t\t\tpy = \"$space.6\",\n\t\t\t\tds.EmptyState {\n\t\t\t\t\ticon = \"clock-circle\",\n\t\t\t\t\tsize = \"sm\",\n\t\t\t\t\ttitle = ui.t(\"settings.browser_history.empty_title\"),\n\t\t\t\t\tbody = function(): string\n\t\t\t\t\t\treturn if data.keep_history:get()\n\t\t\t\t\t\t\tthen ui.t(\"settings.browser_history.empty\"):get()\n\t\t\t\t\t\t\telse ui.t(\"settings.browser_history.off\"):get()\n\t\t\t\t\tend,\n\t\t\t\t},\n\t\t\t}),\n\t\t\tui.show(function(): boolean\n\t\t\t\treturn total() > 0\n\t\t\tend, ds.SearchField {\n\t\t\t\tvalue = query,\n\t\t\t\tname = ui.t(\"settings.browser.history_search\"),\n\t\t\t\tplaceholder = ui.t(\"settings.browser.history_search\"),\n\t\t\t\tw_full = true,\n\t\t\t\tresults = function(): number\n\t\t\t\t\treturn #visits:get()\n\t\t\t\tend,\n\t\t\t}),\n\t\t\tui.each(days, day_block, {\n\t\t\t\tkey = function(day: Day): string\n\t\t\t\t\treturn day.key\n\t\t\t\tend,\n\t\t\t\tdirection = \"column\",\n\t\t\t\tgap = \"$space.5\",\n\t\t\t\tw_full = true,\n\t\t\t}),\n\t\t\tui.show(function(): boolean\n\t\t\t\treturn total() > 0 and #visits:get() == 0\n\t\t\tend, ui.row {\n\t\t\t\tw_full = true,\n\t\t\t\tjustify = \"center\",\n\t\t\t\tpy = \"$space.4\",\n\t\t\t\tds.Hint { ui.t(\"settings.browser.history_none_match\") },\n\t\t\t}),\n\t\t\tui.show(function(): boolean\n\t\t\t\treturn #visits:get() >= shown:get()\n\t\t\tend, ui.row {\n\t\t\t\tw_full = true,\n\t\t\t\tjustify = \"center\",\n\t\t\t\tds.Button {\n\t\t\t\t\tid = \"settings-browser-more\",\n\t\t\t\t\ttone = \"ghost\",\n\t\t\t\t\tsize = \"sm\",\n\t\t\t\t\ton_click = function()\n\t\t\t\t\t\tshown:set(shown:peek() + SHOWN)\n\t\t\t\t\tend,\n\t\t\t\t\tui.text { ui.t(\"settings.browser.history_more\") },\n\t\t\t\t},\n\t\t\t}),\n\t\t}),\n\t}\nend\n\nreturn M\n",
		["apps/zgx/ui/screens/settings/host.luau"] = "-- Settings' calls to the host (src/settings.rs, src/auth.rs, src/agents.rs),\n-- through one place, so a fixture can answer them as the host would\n-- (ui/settings_stub.luau). `call` returns the host's promise: `:after(ok,\n-- err)`, `err.message` an outcome word.\n\nlocal M = {}\n\nfunction M.call(name: string, arg: any?): any\n\treturn ui.call(name, arg)\nend\n\nfunction M.invoke(name: string, arg: any?)\n\tui.invoke(name, arg)\nend\n\n-- Files the person picks (`ui.open_files`): a promise of a list (empty if\n-- they cancel).\nfunction M.open_files(opts: FilePickerOptions): Promise<{ File }>\n\treturn ui.open_files(opts)\nend\n\nreturn M\n",
		["apps/zgx/ui/screens/settings/projects.luau"] = "-- Settings → Projects: the folders your sessions work in, under the device\n-- each is on (this one first, then your other computers, then Cloud's),\n-- each with its tile, its sessions and its folder, found by name or path.\n-- Each row's ⋯ renames it in place (every device then shows the name),\n-- changes its icon and color in the window's one Edit project (its tile\n-- does too, at a click), shows this device's folder in Finder, and removes\n-- it: Zeron forgets the\n-- project and deletes its sessions, as the sidebar's Remove and the\n-- shipping app's `delete_space` do (`deleteSpace`); the folder and its\n-- files stay where they are, which the confirmation says plainly. Sessions\n-- running in it are stopped first, wherever they run, so none carries on\n-- unseen with no row of its own.\n--\n-- The groups and their rows are keyed (`ui.each`, `Settings.Each`), so a\n-- project arriving, renamed or removed changes its row alone. Before the\n-- engine answers, skeleton rows hold their place; with no engine, a callout\n-- says so; none at all, the way to add one.\n\nlocal ds = require(\"@ds\")\nlocal Menu = require(\"@ds/menu\")\nlocal locale = require(\"@ds/locale\")\nlocal toast = require(\"@ds/toast\")\nlocal sessions = require(\"@account/sessions\")\nlocal projects = require(\"@account/projects\")\nlocal search = require(\"@app/screens/settings/search\")\nlocal rename = require(\"@app/screens/settings/rename_row\")\nlocal look = require(\"@app/screens/shell/project_look\")\nlocal files = require(\"@app/screens/files/api\")\n\nlocal M = {}\n\nM.ID = \"projects\"\nM.TITLE = \"Projects\"\n\nsearch.index(M.ID, ui.t(\"settings.projects.title\"), ui.t(\"settings.projects.terms\"), {\n\t{ key = \"projects\", title = ui.t(\"settings.projects.yours.label\"), terms = ui.t(\"settings.projects.yours.terms\") },\n\t{ key = \"projects\", title = ui.t(\"settings.projects.rename_one.label\"), terms = ui.t(\"settings.projects.rename_one.terms\") },\n\t{ key = \"projects\", title = ui.t(\"settings.projects.remove_one.label\"), terms = ui.t(\"settings.projects.remove_one.terms\") },\n})\n\nlocal query = ui.state(\"settings_projects_query\", \"\")\n-- Renaming: which project (its id; \"\" none) and the name being typed.\nlocal renaming = ui.state(\"settings_project_renaming\", \"\")\nlocal new_name = ui.state(\"settings_project_name\", \"\")\n-- Names saved and not yet back from the engine, by project.\nlocal pending = ui.state(\"settings_project_pending_names\", {} :: { [string]: string })\n-- Removing: which one is asked about, and whether that's on its way.\nlocal removing = ui.state(\"settings_project_removing\", \"\")\n-- (What it said as it was asked about: the dialog keeps it while it leaves,\n-- the project gone by then.)\nlocal removing_name = ui.state(\"settings_project_removing_name\", \"\")\nlocal said_last = \"\"\nlocal removing_open = ui.state(\"settings_project_removing_open\", false)\nlocal removing_busy = ui.state(\"settings_project_removing_busy\", false)\n\n-- A session's live states that hold a run open on its device.\nlocal RUNNING: { [string]: boolean } = { working = true, waiting = true, input = true }\n\nlocal function trimmed(s: string): string\n\treturn string.match(s, \"^%s*(.-)%s*$\") or \"\"\nend\n\nlocal function project(id: string): sessions.Project?\n\tfor _, p in sessions.projects:get() do\n\t\tif p.id == id then\n\t\t\treturn p\n\t\tend\n\tend\n\treturn nil\nend\n\nlocal function name_of(p: sessions.Project): string\n\treturn pending:get()[p.id] or p.name\nend\n\nlocal function set_pending(id: string, name: string?)\n\tpending:set_key(id, name)\nend\n\n-- What the engine sends back settles a pending name.\nui.effect(function()\n\tfor id, name in pending:get() do\n\t\tlocal p = project(id)\n\t\tif not p or p.name == name then\n\t\t\tset_pending(id, nil)\n\t\tend\n\tend\nend)\n\n-- Its sessions, archived ones too (a removal deletes them all), and those\n-- running now.\nlocal function sessions_in(id: string): ({ sessions.Chat }, { sessions.Chat })\n\tlocal all: { sessions.Chat } = {}\n\tlocal running: { sessions.Chat } = {}\n\tlocal now = sessions.now:get()\n\tfor _, list in { now.chats, now.archived or {} } do\n\t\tfor _, c in list do\n\t\t\tif c.project == id then\n\t\t\t\ttable.insert(all, c)\n\t\t\t\tif c.status and RUNNING[c.status] then\n\t\t\t\t\ttable.insert(running, c)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\treturn all, running\nend\n\n-- How many sessions each project has, archived ones too: counted once a\n-- change, for every row (the chats change every few seconds while they run).\nlocal counts = ui.computed(function(): { [string]: number }\n\tlocal out: { [string]: number } = {}\n\tlocal now = sessions.now:get()\n\tfor _, list in { now.chats, now.archived or {} } do\n\t\tfor _, c in list do\n\t\t\tif c.project then\n\t\t\t\tout[c.project] = (out[c.project] or 0) + 1\n\t\t\tend\n\t\tend\n\tend\n\treturn out\nend)\n\ntype Row = sessions.Project & { key: string?, members: { sessions.Project }? }\n\n-- A project row and its removal target.\nlocal function row_of(key: string): (sessions.Project?, { sessions.Project })\n\tlocal p = project(key)\n\treturn p, if p then { p } else {}\nend\n\n-- The device a project is on, as its group heads it.\ntype Group = { id: string, name: string, here: boolean, gone: boolean, projects: { Row } }\n\nlocal function by_name(a: Row, b: Row): boolean\n\tlocal x, y = string.lower(name_of(a)), string.lower(name_of(b))\n\tif x ~= y then\n\t\treturn x < y\n\tend\n\treturn a.id < b.id\nend\n\n-- The groups shown: this device's, your other computers' (as Devices lists\n-- them), Cloud's (one group, a repository once), then any on a device since\n-- removed; each with the projects the search finds, by name (Cloud's, by\n-- repository too).\nlocal groups = ui.computed(function(): { Group }\n\tlocal q = string.lower(trimmed(query:get()))\n\tlocal by_device: { [string]: { Row } } = {}\n\tfor _, p in sessions.projects:get() do\n\t\tlocal hay = string.lower(`{name_of(p)} {p.path}`)\n\t\tif q == \"\" or string.find(hay, q, 1, true) then\n\t\t\tby_device[p.device] = by_device[p.device] or {}\n\t\t\ttable.insert(by_device[p.device], p :: Row)\n\t\tend\n\tend\n\tfor _, list in by_device do\n\t\ttable.sort(list, by_name)\n\tend\n\tlocal out: { Group } = {}\n\tlocal placed: { [string]: boolean } = {}\n\tlocal function add(id: string, name: string, here: boolean, gone: boolean)\n\t\tif by_device[id] and not placed[id] then\n\t\t\tplaced[id] = true\n\t\t\ttable.insert(out, { id = id, name = name, here = here, gone = gone, projects = by_device[id] })\n\t\tend\n\tend\n\tlocal all = sessions.devices:get()\n\tfor _, d in sessions.computers(all) do\n\t\tadd(d.id, d.name, d.here == true, false)\n\tend\n\tlocal rest: { string } = {}\n\tfor id in by_device do\n\t\tif not placed[id] then\n\t\t\ttable.insert(rest, id)\n\t\tend\n\tend\n\ttable.sort(rest)\n\tfor _, id in rest do\n\t\tadd(id, ui.t(\"settings.projects.device_gone\"):get(), false, true)\n\tend\n\treturn out\nend)\n\n-- Why a change didn't go, in words.\nlocal function why(err: any): string\n\tlocal word = if type(err) == \"string\" then err elseif type(err) == \"table\" or type(err) == \"userdata\" then err.message else nil\n\tif word == \"offline\" then\n\t\treturn ui.t(\"settings.engine.offline\"):get()\n\telseif type(word) == \"string\" and word ~= \"\" and word ~= \"failed\" and #word <= 160 then\n\t\t-- (The engine's own words, a preview's refusal among them.)\n\t\treturn word\n\tend\n\treturn ui.t(\"settings.devices.try_later\"):get()\nend\n\n-- A row's sessions: those of every project it stands for.\nlocal function sessions_of(members: { sessions.Project }): ({ sessions.Chat }, { sessions.Chat })\n\tlocal all: { sessions.Chat } = {}\n\tlocal running: { sessions.Chat } = {}\n\tfor _, m in members do\n\t\tlocal a, r = sessions_in(m.id)\n\t\ttable.move(a, 1, #a, #all + 1, all)\n\t\ttable.move(r, 1, #r, #running + 1, running)\n\tend\n\treturn all, running\nend\n\n-- (A Cloud row's name: given to each of its projects.)\nlocal function save_rename(key: string)\n\tlocal name = trimmed(new_name:peek())\n\trenaming:set(\"\")\n\tlocal p, members = row_of(key)\n\tif not p or name == \"\" or name == name_of(p) then\n\t\treturn\n\tend\n\tlocal said = false\n\tfor _, m in members do\n\t\tif name_of(m) ~= name then\n\t\t\tlocal id = m.id\n\t\t\tset_pending(id, name)\n\t\t\tsessions.rename_project_or_say(id, name):after(function() end, function(err: any)\n\t\t\t\tset_pending(id, nil)\n\t\t\t\tif not said then\n\t\t\t\t\tsaid = true\n\t\t\t\t\ttoast.show { title = ui.t(\"settings.projects.couldnt_rename\"):get(), body = why(err), tone = \"danger\" }\n\t\t\t\tend\n\t\t\tend)\n\t\tend\n\tend\nend\n\nlocal function remove()\n\tlocal key = removing:peek()\n\tif key == \"\" or removing_busy:peek() then\n\t\treturn\n\tend\n\tlocal _, members = row_of(key)\n\tremoving_busy:set(true)\n\tlocal function done(err: any?)\n\t\tui.batch(function()\n\t\t\tremoving_busy:set(false)\n\t\t\tremoving_open:set(false)\n\t\tend)\n\t\tif err ~= nil then\n\t\t\ttoast.show { title = ui.t(\"settings.projects.couldnt_remove\"):get(), body = why(err), tone = \"danger\" }\n\t\tend\n\tend\n\t-- (A Cloud row's: each of its projects; done when they all are, the\n\t-- first refusal said.)\n\tlocal function go()\n\t\tlocal left, failed = #members, nil :: any\n\t\tif left == 0 then\n\t\t\tdone(nil)\n\t\t\treturn\n\t\tend\n\t\tlocal function one(err: any?)\n\t\t\tif err ~= nil and failed == nil then\n\t\t\t\tfailed = err\n\t\t\tend\n\t\t\tleft -= 1\n\t\t\tif left == 0 then\n\t\t\t\tdone(failed)\n\t\t\tend\n\t\tend\n\t\tfor _, m in members do\n\t\t\tprojects.delete(m.id):after(function()\n\t\t\t\tone(nil)\n\t\t\tend, function(err: any)\n\t\t\t\tone(err or \"failed\")\n\t\t\tend)\n\t\tend\n\tend\n\t-- Its running sessions stopped first, on whichever device runs them:\n\t-- the removal deletes their rows, and a run with none would carry on\n\t-- where nothing shows it. (One that can't be reached isn't running.)\n\tlocal _, running = sessions_of(members)\n\tlocal left = #running\n\tif left == 0 then\n\t\tgo()\n\t\treturn\n\tend\n\tfor _, c in running do\n\t\tsessions.stop(c.id):after(function()\n\t\t\tleft -= 1\n\t\t\tif left == 0 then\n\t\t\t\tgo()\n\t\t\tend\n\t\tend, function()\n\t\t\tleft -= 1\n\t\t\tif left == 0 then\n\t\t\t\tgo()\n\t\t\tend\n\t\tend)\n\tend\nend\n\n-- The confirmation's words: what goes, what's stopped, and what stays.\nlocal function removal_words(): string\n\tlocal p, members = row_of(removing:get())\n\tif not p then\n\t\treturn said_last\n\tend\n\tlocal all, running = sessions_of(members)\n\tlocal parts = {\n\t\tif #all == 0 then ui.t(\"settings.projects.remove_none\"):get() else ui.t(\"settings.projects.remove_sessions\", { n = #all }):get(),\n\t}\n\tif #running > 0 then\n\t\t-- (Its only session, or some of several.)\n\t\ttable.insert(\n\t\t\tparts,\n\t\t\tif #all == 1 then ui.t(\"settings.projects.remove_running_only\"):get() else ui.t(\"settings.projects.remove_running\", { n = #running }):get()\n\t\t)\n\tend\n\tlocal where: string? = nil\n\tfor _, d in sessions.devices:get() do\n\t\tif d.id == p.device then\n\t\t\twhere = d.name\n\t\tend\n\tend\n\ttable.insert(parts, ui.t(\"settings.projects.remove_keeps_folder\", { path = p.path, device = where or ui.t(\"settings.projects.its_device\"):get() }):get())\n\tsaid_last = table.concat(parts, \" \")\n\treturn said_last\nend\n\nlocal function project_row(_p: Row, _i: number, p: State<Row>): Node\n\t-- The project's stable row id.\n\tlocal id = p:peek().key or p:peek().id\n\tlocal merged = p:peek().members ~= nil\n\tlocal menu_open = ui.use_state(false)\n\tlocal trigger = ui.ref()\n\tlocal function refocus()\n\t\tui.after(0, function()\n\t\t\tlocal el = trigger:peek()\n\t\t\tif el then\n\t\t\t\tel:focus()\n\t\t\tend\n\t\tend)\n\tend\n\tlocal more = ds.IconButton {\n\t\ticon = \"more-horizontal\",\n\t\tlabel = ui.t(\"settings.projects.more_for\", { name = p:peek().name }),\n\t\tsize = \"md\",\n\t\ttone = \"quiet\",\n\t\ton_click = function()\n\t\t\tmenu_open:set(not menu_open:peek())\n\t\tend,\n\t}\n\t-- Its name and icon in the window's one editor (Edit project: the\n\t-- sidebar's, screens/shell/project_editor), on every device. (A Cloud\n\t-- row's: what's saved goes to each of its projects.)\n\tlocal function edit()\n\t\tlocal now = p:peek()\n\t\tlocal others: { string }? = nil\n\t\tif now.members then\n\t\t\tothers = {}\n\t\t\tfor _, m in now.members do\n\t\t\t\tif m.id ~= now.id then\n\t\t\t\t\ttable.insert(others :: { string }, m.id)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\trequire(\"@app/screens/shell/sidebar\").edit_project(now.id, nil, others)\n\tend\n\tlocal function face(): Node\n\t\treturn ds.Tile {\n\t\t\tsize = 28,\n\t\t\tproject = if merged\n\t\t\t\tthen function(): string?\n\t\t\t\t\treturn p:get().id\n\t\t\t\tend\n\t\t\t\telse id,\n\t\t\tlabel = function(): string\n\t\t\t\treturn name_of(p:get())\n\t\t\tend,\n\t\t\thue = function(): string?\n\t\t\t\treturn look.of(p:get()).hue\n\t\t\tend,\n\t\t\tsrc = function(): string?\n\t\t\t\treturn look.of(p:get()).src\n\t\t\tend,\n\t\t\temoji = function(): string?\n\t\t\t\treturn look.of(p:get()).emoji\n\t\t\tend,\n\t\t}\n\tend\n\t-- The tile edits its icon at a click (or Space), as the editor's preview\n\t-- is the tile itself.\n\tlocal function tile(): Node\n\t\treturn ui.div {\n\t\t\tshrink = 0,\n\t\t\trole = \"button\",\n\t\t\tlabel = ui.t(\"settings.projects.icon_of\", { name = p:peek().name }),\n\t\t\ttooltip = ui.t(\"settings.projects.change_icon_tip\"):get(),\n\t\t\tfocusable = true,\n\t\t\tcursor = \"pointer\",\n\t\t\trounded = \"$radius.md\",\n\t\t\thover = { opacity = 0.85 },\n\t\t\tactive = { opacity = 0.7 },\n\t\t\tfocus = { outline = \"$zeron.focus.width\", outline_color = \"$zeron.focus.ring\", outline_offset = 2 },\n\t\t\ton_click = edit,\n\t\t\tface(),\n\t\t}\n\tend\n\tlocal menu = ui.menu(Menu.panel {\n\t\topen = menu_open,\n\t\tanchor = more,\n\t\tplacement = { side = \"bottom\", align = \"end\", offset = 4 },\n\t\tw = 220,\n\t\tMenu.Group {\n\t\t\tMenu.Row {\n\t\t\t\ticon = \"pen\",\n\t\t\t\tlabel = locale.s(\"settings.projects.rename\"),\n\t\t\t\ton_click = function()\n\t\t\t\t\tmenu_open:set(false)\n\t\t\t\t\tnew_name:set(name_of(p:peek()))\n\t\t\t\t\trenaming:set(id)\n\t\t\t\tend,\n\t\t\t},\n\t\t\tMenu.Row {\n\t\t\t\ticon = \"palette\",\n\t\t\t\tlabel = locale.s(\"settings.projects.change_icon\"),\n\t\t\t\ton_click = function()\n\t\t\t\t\tmenu_open:set(false)\n\t\t\t\t\tedit()\n\t\t\t\tend,\n\t\t\t},\n\t\t\t-- (A folder on this device: shown where it is.)\n\t\t\tui.show(\n\t\t\t\tfunction(): boolean\n\t\t\t\t\treturn p:get().device == sessions.here:get()\n\t\t\t\tend,\n\t\t\t\tMenu.Row {\n\t\t\t\t\ticon = \"folder\",\n\t\t\t\t\tlabel = locale.s(\"settings.projects.show\"),\n\t\t\t\t\ton_click = function()\n\t\t\t\t\t\tmenu_open:set(false)\n\t\t\t\t\t\tlocal now = p:peek()\n\t\t\t\t\t\tfiles.reveal({ space = now.id, device = now.device, root = now.path }, \"\"):after(function() end, function(err: any)\n\t\t\t\t\t\t\ttoast.show { title = ui.t(\"settings.projects.couldnt_show\"):get(), body = why(err), tone = \"danger\" }\n\t\t\t\t\t\tend)\n\t\t\t\t\tend,\n\t\t\t\t}\n\t\t\t),\n\t\t},\n\t\tMenu.Rule {},\n\t\tMenu.Group {\n\t\t\tMenu.Row {\n\t\t\t\ticon = \"trash-bin-minimalistic\",\n\t\t\t\tlabel = locale.s(\"settings.projects.remove\"),\n\t\t\t\tdanger = true,\n\t\t\t\ton_click = function()\n\t\t\t\t\tmenu_open:set(false)\n\t\t\t\t\tremoving:set(id)\n\t\t\t\t\tremoving_name:set(name_of(p:peek()))\n\t\t\t\t\tremoving_open:set(true)\n\t\t\t\tend,\n\t\t\t},\n\t\t},\n\t})\n\treturn rename.Row {\n\t\trow = ds.Settings.Row {\n\t\t\tlabel = function(): string\n\t\t\t\treturn name_of(p:get())\n\t\t\tend,\n\t\t\t-- How many sessions, then its folder (fading where it's long).\n\t\t\tdescription = function(): string\n\t\t\t\tlocal now = p:get()\n\t\t\t\tlocal n = 0\n\t\t\t\tlocal all = counts:get()\n\t\t\t\tfor _, m in now.members or { now } do\n\t\t\t\t\tn += all[m.id] or 0\n\t\t\t\tend\n\t\t\t\tlocal count = if n == 0 then ui.t(\"settings.projects.no_sessions\"):get() else ui.t(\"settings.projects.sessions\", { n = n }):get()\n\t\t\t\tlocal where = now.path\n\t\t\t\treturn if where and where ~= \"\" then `{count} · {where}` else count\n\t\t\tend,\n\t\t\tlead = tile(),\n\t\t\ttruncate = true,\n\t\t\tcontrol = ui.div { ref = trigger, menu },\n\t\t},\n\t\tlead = face,\n\t\tediting = function(): boolean\n\t\t\treturn renaming:get() == id\n\t\tend,\n\t\tvalue = new_name,\n\t\tname = ui.t(\"settings.projects.name_of\", { name = p:peek().name }),\n\t\tcan_save = function(): boolean\n\t\t\treturn trimmed(new_name:get()) ~= \"\"\n\t\tend,\n\t\ton_save = function()\n\t\t\tsave_rename(id)\n\t\t\trefocus()\n\t\tend,\n\t\ton_cancel = function()\n\t\t\trenaming:set(\"\")\n\t\t\trefocus()\n\t\tend,\n\t}\nend\n\n-- A device's projects, under its name.\nlocal function group(_g: Group, _i: number, g: State<Group>): Node\n\tlocal list = ui.computed(function(): { Row }\n\t\treturn g:get().projects\n\tend)\n\tlocal function name(): string\n\t\treturn g:get().name\n\tend\n\t-- A Settings.Section, its \"This device\" right after the name as Devices'\n\t-- row has it (a section's own `trail` stands at the far edge).\n\treturn ui.column {\n\t\tw_full = true,\n\t\tgap = \"$space.2\",\n\t\trole = \"group\",\n\t\tlabel = name,\n\t\tui.row {\n\t\t\tpx = ds.Settings.inset(),\n\t\t\tgap = \"$space.2\",\n\t\t\titems = \"center\",\n\t\t\tds.SectionTitle { name, heading = 2 },\n\t\t\tui.show(function(): boolean\n\t\t\t\treturn g:get().here\n\t\t\tend, ds.Badge { ui.t(\"settings.devices.this_device\"), size = \"sm\" }),\n\t\t},\n\t\tds.Settings.Each(list, project_row, {\n\t\t\tkey = function(p: Row): string\n\t\t\t\treturn p.key or p.id\n\t\t\tend,\n\t\t}),\n\t}\nend\n\nlocal function add_project()\n\trequire(\"@app/screens/shell/add_project\").open()\nend\n\nlocal function list_kind(): string\n\tif #groups:get() > 0 then\n\t\treturn \"projects\"\n\tend\n\tlocal s = sessions.state:get()\n\tif #sessions.projects:get() > 0 then\n\t\treturn \"nothing_found\"\n\tend\n\treturn if s == \"offline\" then \"offline\" elseif s == \"ready\" then \"none\" else \"loading\"\nend\n\nlocal function list_body(kind: string): Node\n\tif kind == \"loading\" then\n\t\t-- (Said, not only drawn: the bars are hidden from assistive technology.)\n\t\treturn ui.column {\n\t\t\tw_full = true,\n\t\t\tlabel = ui.t(\"common.loading\"),\n\t\t\tlive = \"polite\",\n\t\t\tds.Settings.Group {\n\t\t\t\tds.SkeletonRow { trail = 28 },\n\t\t\t\tds.SkeletonRow { title = 110, line = 220, trail = 28 },\n\t\t\t\tds.SkeletonRow { title = 130, line = 200, trail = 28 },\n\t\t\t},\n\t\t}\n\telseif kind == \"offline\" then\n\t\treturn ds.Callout {\n\t\t\ttone = \"danger\",\n\t\t\ttitle = ui.t(\"settings.projects.offline_title\") :: any,\n\t\t\tbody = ui.t(\"settings.engine.offline\") :: any,\n\t\t}\n\telseif kind == \"none\" then\n\t\treturn ds.EmptyState {\n\t\t\ticon = \"folder-with-files\",\n\t\t\ttitle = ui.t(\"settings.projects.empty_title\") :: any,\n\t\t\tbody = ui.t(\"settings.projects.empty_body\") :: any,\n\t\t\tsize = \"sm\",\n\t\t\taction = { label = ui.t(\"settings.projects.add\") :: any, on_click = add_project },\n\t\t}\n\telseif kind == \"nothing_found\" then\n\t\treturn ds.EmptyState {\n\t\t\ticon = \"search\",\n\t\t\ttitle = ui.t(\"settings.projects.nothing_found\") :: any,\n\t\t\tbody = ui.t(\"settings.projects.nothing_found_body\") :: any,\n\t\t\tsize = \"sm\",\n\t\t}\n\tend\n\treturn ui.each(groups, group, {\n\t\tkey = function(g: Group): string\n\t\t\treturn g.id\n\t\tend,\n\t\tw_full = true,\n\t\tgap = \"$space.6\",\n\t})\nend\n\nfunction M.view(): Node\n\treturn ui.column {\n\t\tw_full = true,\n\t\titems = \"center\",\n\t\tds.Settings.Page {\n\t\t\ttitle = ui.t(\"settings.projects.title\"),\n\t\t\tdescription = ui.t(\"settings.projects.description\"),\n\t\t\t-- The search beside the one action, over the list it filters.\n\t\t\ttrail = ui.row {\n\t\t\t\tgap = \"$space.2\",\n\t\t\t\titems = \"center\",\n\t\t\t\tds.SearchField {\n\t\t\t\t\tvalue = query,\n\t\t\t\t\tplaceholder = ui.t(\"settings.projects.find\") :: any,\n\t\t\t\t\tsize = \"sm\",\n\t\t\t\t\tw = 180,\n\t\t\t\t\tname = ui.t(\"settings.projects.find\") :: any,\n\t\t\t\t},\n\t\t\t\tds.Button { ui.t(\"settings.projects.add\"), size = \"sm\", on_click = add_project },\n\t\t\t},\n\t\t\tsearch.anchor(\n\t\t\t\t\"projects\",\n\t\t\t\tui.presence(list_kind, list_body, {\n\t\t\t\t\tw_full = true,\n\t\t\t\t\tenter = { opacity = { 0, 1 }, duration = 120 },\n\t\t\t\t\texit = { opacity = 0, duration = 60 },\n\t\t\t\t\tmode = \"wait\",\n\t\t\t\t})\n\t\t\t),\n\t\t},\n\t\tds.Dialog {\n\t\t\topen = removing_open,\n\t\t\ttitle = (function(): string\n\t\t\t\treturn ui.t(\"settings.projects.remove_title\", { name = removing_name:get() }):get()\n\t\t\tend) :: any,\n\t\t\tbody = removal_words :: any,\n\t\t\ttone = \"danger\",\n\t\t\tsize = \"sm\",\n\t\t\tconfirm = {\n\t\t\t\tlabel = ui.t(\"settings.projects.remove_confirm\"),\n\t\t\t\tkeep_open = true,\n\t\t\t\tbusy = function(): boolean\n\t\t\t\t\treturn removing_busy:get()\n\t\t\t\tend,\n\t\t\t\ton_click = remove,\n\t\t\t},\n\t\t},\n\t}\nend\n\nreturn M\n",
		["apps/zgx/ui/screens/settings/sign_in_terminal.luau"] = "-- An agent's sign-in that asks for typed input (a key pasted, a choice\n-- made), in a terminal: the panel's terminal (screens/panel/terminal_api,\n-- src/terminal.rs) on the agent's device, its home folder, its sign-in\n-- command typed in for you. Settings → Providers opens it from the card's\n-- failed sign-in (\"Open a terminal\"); Done closes the terminal and the card\n-- looks again.\n--\n--   sign_in_terminal.show { id, name, command, device? }\n--   sign_in_terminal.Dialog(on_done)   once, beside the page\n\nlocal ds = require(\"@ds\")\nlocal api = require(\"@app/screens/panel/terminal_api\")\n\nlocal M = {}\n\nexport type Who = { id: string, name: string, command: string, device: string?, device_name: string }\n\nlocal open = ui.state(\"settings_sign_in_terminal_open\", false)\nlocal who = ui.state(\"settings_sign_in_terminal_who\", nil :: Who?)\n-- Each opening its own terminal (zgx keeps a session by its key).\nlocal opened = ui.state(\"settings_sign_in_terminal_n\", 0)\n\nfunction M.show(w: Who)\n\twho:set(w)\n\topened:set(opened:peek() + 1)\n\topen:set(true)\nend\n\n-- The terminal, opened as the dialog opens: its bridge started, then, once\n-- the engine's terminal is claimed, the sign-in typed into it.\nlocal Terminal = ui.component(function(props: { who: Who, key: string, on_terminal: (id: string?) -> () }): Node\n\tlocal w = props.who\n\t-- The bridge's command once there is one; why it couldn't open.\n\tlocal bridge = ui.use_state(\"\")\n\tlocal failed = ui.use_state(\"\")\n\tui.after(0, function()\n\t\tapi.start({ chat = `acp-sign-in:{w.id}`, device = w.device }):after(function(r: any)\n\t\t\tbridge:set(r.command)\n\t\t\tapi.claimed(r.claim):after(function(terminal: string)\n\t\t\t\tprops.on_terminal(terminal)\n\t\t\t\tapi.write(terminal, w.device, w.command .. \"\\n\"):after(function() end, function() end)\n\t\t\tend, function(err: any)\n\t\t\t\tfailed:set(if type(err) == \"table\" then tostring(err.message) else tostring(err))\n\t\t\tend)\n\t\tend, function(err: any)\n\t\t\tlocal m = if type(err) == \"table\" then tostring(err.message) else tostring(err)\n\t\t\tfailed:set(if m == \"offline\" then ui.t(\"panel.terminal.offline\"):get() else m)\n\t\tend)\n\tend)\n\tlocal function kind(): string\n\t\tif failed:get() ~= \"\" then\n\t\t\treturn \"failed\"\n\t\tend\n\t\treturn if bridge:get() ~= \"\" then \"ready\" else \"opening\"\n\tend\n\treturn ui.column {\n\t\tw_full = true,\n\t\th = 320,\n\t\trounded = \"$radius.md\",\n\t\toverflow = \"hidden\",\n\t\tbg = \"$zeron.secondary.bg\",\n\t\tui.presence(kind, function(k: string): Node\n\t\t\tif k == \"failed\" then\n\t\t\t\treturn ds.EmptyState {\n\t\t\t\t\ticon = \"terminal\",\n\t\t\t\t\tsize = \"sm\",\n\t\t\t\t\tfill = true,\n\t\t\t\t\ttitle = ui.t(\"panel.terminal.failed\") :: any,\n\t\t\t\t\tbody = failed:peek(),\n\t\t\t\t}\n\t\t\telseif k == \"opening\" then\n\t\t\t\treturn ui.column { w_full = true, grow = 1 }\n\t\t\tend\n\t\t\tlocal term = api.term(props.key, { command = bridge:peek(), cwd = \"~\" })\n\t\t\tui.after(0, function()\n\t\t\t\tif term and term.focus then\n\t\t\t\t\tterm:focus()\n\t\t\t\tend\n\t\t\tend)\n\t\t\t-- (Its rows placed from its own box: `relative`, padded outside it.)\n\t\t\treturn ui.column {\n\t\t\t\tw_full = true,\n\t\t\t\tgrow = 1,\n\t\t\t\tmin_h = 0,\n\t\t\t\tp = \"$space.2\",\n\t\t\t\tapi.view {\n\t\t\t\t\tterm = term,\n\t\t\t\t\tlabel = ui.t(\"settings.providers.add.terminal.label\", { name = w.name }),\n\t\t\t\t\trelative = true,\n\t\t\t\t\tw_full = true,\n\t\t\t\t\tgrow = 1,\n\t\t\t\t\tmin_h = 0,\n\t\t\t\t},\n\t\t\t}\n\t\tend, { w_full = true, grow = 1, min_h = 0 }),\n\t}\nend)\n\n-- The dialog, beside the page: `on_done(id)` once it closes (the agent's\n-- id), for the card to look again.\nfunction M.Dialog(on_done: (id: string) -> ()): Node\n\t-- The terminal it opened, ended as it closes.\n\tlocal terminal: string? = nil\n\tlocal session: string? = nil\n\tlocal was_open = open:peek()\n\tui.effect(function()\n\t\tlocal now = open:get()\n\t\tif was_open and not now then\n\t\t\tlocal w = who:peek()\n\t\t\tif session then\n\t\t\t\tlocal ok, t = pcall(api.term, session)\n\t\t\t\tif ok and t then\n\t\t\t\t\tpcall(function()\n\t\t\t\t\t\tt:close()\n\t\t\t\t\tend)\n\t\t\t\tend\n\t\t\tend\n\t\t\tif terminal and w then\n\t\t\t\tapi.close(terminal, w.device):after(function() end, function() end)\n\t\t\tend\n\t\t\tterminal, session = nil, nil\n\t\t\tif w then\n\t\t\t\ton_done(w.id)\n\t\t\tend\n\t\tend\n\t\twas_open = now\n\tend)\n\treturn ds.Dialog {\n\t\topen = open,\n\t\tsize = \"lg\",\n\t\ttitle = function(): string\n\t\t\tlocal w = who:get()\n\t\t\treturn if w then ui.t(\"settings.providers.add.terminal.title\", { name = w.name }):get() else \"\"\n\t\tend,\n\t\tbody = function(): string\n\t\t\tlocal w = who:get()\n\t\t\treturn if w then ui.t(\"settings.providers.add.terminal.body\", { name = w.name, device = w.device_name }):get() else \"\"\n\t\tend,\n\t\tcancel = false,\n\t\tconfirm = { label = ui.t(\"settings.providers.done\") },\n\t\tbuild = function(): Node\n\t\t\tlocal w = who:peek()\n\t\t\tif not w then\n\t\t\t\treturn ui.div {}\n\t\t\tend\n\t\t\tlocal key = `acp-sign-in:{w.id}:{opened:peek()}`\n\t\t\tsession = key\n\t\t\treturn Terminal {\n\t\t\t\twho = w,\n\t\t\t\tkey = key,\n\t\t\t\ton_terminal = function(id: string?)\n\t\t\t\t\tterminal = id\n\t\t\t\tend,\n\t\t\t}\n\t\tend,\n\t}\nend\n\nreturn M\n",
		["apps/zgx/ui/screens/shell/activity.luau"] = "-- The Activity sidebar: one list of the chats that need you, the one that\n-- came back last at the top. A chat under way folds into Working (running,\n-- or waiting on background work that will wake it), one put to sleep into\n-- Asleep until its time or until it asks for you, and archived ones sit on\n-- the Archived shelf. The three shelves stand at the list's end, folded\n-- until opened.\n--\n-- What a chat is doing and its sleep are the engine's (synced, the same on\n-- every device: `sessions.now`'s chats carry `status`, `waiting`,\n-- `sleep_until` and `woke`). The view and its settings are this device's.\n--\n-- Cheap by design: nothing here runs on a session's change but what the\n-- sidebar reads (`shelf`, `rank`); its one timer ticks once a minute and\n-- does work only while a chat is asleep (its countdown) or auto-archive is\n-- on (its sweep).\n--\n--   activity.on                 the view (a persisted boolean)\n--   activity.working_shelf      chats under way fold into Working\n--   activity.archive_after      days idle before a chat is archived (0: never)\n--   activity.shelf(c, status)   \"working\", \"asleep\" or nil (the list)\n--   activity.rank(c, shelf)     its place: higher, nearer the top\n--   activity.sleep(id, until)   asleep until `until` (Unix seconds)\n--   activity.wake(id)           awake now\n--   activity.presets()          Sleep's choices: { id, label, detail, until }\n--   activity.wakes_in(until)    how soon that is, as a row's corner says it\n\nlocal sessions = require(\"@account/sessions\")\nlocal locale = require(\"@ds/locale\")\nlocal toast = require(\"@ds/toast\")\nlocal route = require(\"@app/screens/shell/route\")\n\nlocal M = {}\n\n-- (The sidebar Zeron opens with; turned off, it lists by project, then device.)\nM.on = ui.persist(\"shell_sidebar_activity\", true)\nM.working_shelf = ui.persist(\"activity_working_shelf\", true)\nM.archive_after = ui.persist(\"activity_archive_after\", 0)\n\n-- Under way: running, or waiting on work that will wake it.\nlocal UNDER_WAY: { [string]: boolean } = { working = true, connecting = true, waiting = true }\n-- What needs you: a chat in one is never archived on its own.\nlocal NEEDS_YOU: { [string]: boolean } = { input = true, approval = true, failed = true, limited = true, woke = true }\n\n-- The minute, while something reads by it (a sleeper's countdown, the\n-- archive sweep); still otherwise.\nlocal minute = ui.state(\"activity_minute\", 0)\n\nfunction M.shelf(c: sessions.Chat, status: string?): string?\n\tif not M.on:get() then\n\t\treturn nil\n\tend\n\tif c.sleep_until then\n\t\treturn \"asleep\"\n\tend\n\tif M.working_shelf:get() and status and UNDER_WAY[status] then\n\t\treturn \"working\"\n\tend\n\treturn nil\nend\n\n-- Higher stands nearer the top: the list by when it last came back (its own\n-- last move, or waking); Asleep by how soon it wakes.\nfunction M.rank(c: sessions.Chat, shelf: string?): number\n\tif shelf == \"asleep\" then\n\t\treturn -(c.sleep_until or 0)\n\tend\n\treturn math.max(c.updated or 0, c.woke or 0)\nend\n\n-- A sleep or a wake its host refused says so: never a click that does\n-- nothing. (An engine from before Sleep doesn't know the request at all:\n-- that one says what would let it.)\nlocal function said(waking: boolean): (any) -> ()\n\treturn function(err: any)\n\t\tlocal outdated = err == \"outdated\"\n\t\ttoast.show {\n\t\t\ttitle = locale.s(if waking then \"shell.activity.wake_failed\" else \"shell.activity.sleep.failed\"),\n\t\t\tbody = if outdated then locale.s(\"shell.activity.sleep.needs_update\") else nil,\n\t\t\ttone = \"danger\",\n\t\t}\n\tend\nend\n\nfunction M.sleep(id: string, until_at: number)\n\tsessions.sleep(id, until_at):after(function() end, said(false))\nend\n\nfunction M.wake(id: string)\n\tsessions.sleep(id, nil):after(function() end, said(true))\nend\n\n-- How soon `until_at` is, as a row's corner says it: \"45m\", \"3h\", \"2d\".\nfunction M.wakes_in(until_at: number): string\n\tminute:get()\n\tlocal left = math.max(0, until_at - os.time())\n\tif left < 3600 then\n\t\treturn locale.s(\"time.short.minutes\", { n = math.max(1, math.ceil(left / 60)) })\n\telseif left < 86400 then\n\t\treturn locale.s(\"time.short.hours\", { n = math.ceil(left / 3600) })\n\tend\n\treturn locale.s(\"time.short.days\", { n = math.ceil(left / 86400) })\nend\n\n-- Local calendar fields as a moment. (Luau's `os.time` reads a table as UTC:\n-- the zone's offset at that moment is taken back out, worked out again at\n-- the moment found so a daylight-saving change between now and then lands\n-- on the wall-clock time asked for.)\nlocal function local_time(fields: { [string]: number }): number\n\tlocal as_utc = os.time(fields :: any)\n\tlocal function offset(t: number): number\n\t\treturn os.time(os.date(\"*t\", t) :: any) - t\n\tend\n\tlocal guess = as_utc - offset(as_utc)\n\treturn as_utc - offset(guess)\nend\nM.local_time = local_time\n\n-- Sleep's choices, soonest first, one a minute: in an hour, in three, this\n-- evening (6 PM, while it's still ahead), tomorrow at 9, next Monday at 9.\n-- Each says when it wakes: its time, and its day where its name doesn't.\nexport type Preset = { id: string, label: string, detail: string, until_at: number }\nfunction M.presets(): { Preset }\n\tlocal t = os.time()\n\tlocal today = os.date(\"*t\", t) :: any\n\tlocal function at(days: number, hour: number): number\n\t\treturn local_time({ year = today.year, month = today.month, day = today.day + days, hour = hour, min = 0, sec = 0 })\n\tend\n\tlocal out: { Preset } = {}\n\tlocal function add(id: string, key: string, until_at: number, names_day: boolean)\n\t\tif until_at <= t then\n\t\t\treturn\n\t\tend\n\t\tlocal same_day = os.date(\"%Y-%m-%d\", until_at) == os.date(\"%Y-%m-%d\", t)\n\t\tlocal detail = if names_day or same_day then locale.clock(until_at) else `{locale.weekday(until_at)} {locale.clock(until_at)}`\n\t\ttable.insert(out, { id = id, label = locale.s(key), detail = detail, until_at = until_at })\n\tend\n\tadd(\"hour\", \"shell.activity.sleep.in_hour\", t + 3600, false)\n\tadd(\"hours\", \"shell.activity.sleep.in_hours\", t + 3 * 3600, false)\n\tadd(\"evening\", \"shell.activity.sleep.evening\", at(0, 18), true)\n\tadd(\"tomorrow\", \"shell.activity.sleep.tomorrow\", at(1, 9), true)\n\t-- (Monday: a week on from a Monday; the next one from any other day.)\n\tlocal to_monday = (9 - today.wday) % 7\n\tadd(\"week\", \"shell.activity.sleep.next_week\", at(if to_monday == 0 then 7 else to_monday, 9), false)\n\ttable.sort(out, function(a: Preset, b: Preset): boolean\n\t\treturn a.until_at < b.until_at\n\tend)\n\tlocal seen: { [number]: boolean } = {}\n\tlocal kept: { Preset } = {}\n\tfor _, p in out do\n\t\tlocal m = math.floor(p.until_at / 60)\n\t\tif not seen[m] then\n\t\t\tseen[m] = true\n\t\t\ttable.insert(kept, p)\n\t\tend\n\tend\n\treturn kept\nend\n\n-- The days Settings offers before an idle chat is archived (0: never).\nM.ARCHIVE_AFTER = { 0, 1, 3, 7, 14, 30 }\n\n-- Chats brought back from Archived, by id: when (Unix seconds). One counts\n-- as just moved, so being old doesn't send it straight back. Kept across\n-- launches (a sweep after a reload must know too), pruned to the chats there.\nlocal back = ui.persist(\"activity_unarchived\", {} :: { [string]: number })\n-- The archived ones as the last sweep saw them (none yet: the first sweep\n-- after a launch only looks).\nlocal seen_archived: { [string]: boolean }? = nil\n\n-- Auto-archive: each chat idle longer than the days set goes to Archived\n-- (one click from back). Never one that's pinned, open now, asleep, under\n-- way or needing you; nothing until the places are known (or a pinned chat\n-- could look unpinned).\nlocal function sweep()\n\tlocal days = M.archive_after:peek()\n\tlocal now_state = sessions.now:peek()\n\tif now_state.state ~= \"ready\" or not now_state.places_ready then\n\t\treturn\n\tend\n\tlocal t = os.time()\n\tlocal archived: { [string]: boolean } = {}\n\tfor _, c in now_state.archived or {} do\n\t\tarchived[c.id] = true\n\tend\n\tlocal was = seen_archived\n\tseen_archived = archived\n\tlocal came_back: { [string]: number } = table.clone(back:peek())\n\tlocal changed = false\n\tlocal here: { [string]: boolean } = {}\n\tfor _, c in now_state.chats do\n\t\there[c.id] = true\n\t\tif was and was[c.id] then\n\t\t\tcame_back[c.id] = t\n\t\t\tchanged = true\n\t\tend\n\tend\n\tfor id in came_back do\n\t\tif not here[id] then\n\t\t\tcame_back[id] = nil\n\t\t\tchanged = true\n\t\tend\n\tend\n\tif changed then\n\t\tback:set(came_back)\n\tend\n\t-- (The first sweep after a launch only looks: what came back meanwhile\n\t-- is unknown until the next. Turned off, it only looks too.)\n\tif not was or not M.on:peek() or type(days) ~= \"number\" or days <= 0 then\n\t\treturn\n\tend\n\tlocal pinned: { [string]: boolean } = {}\n\tfor _, id in now_state.places.pinned do\n\t\tpinned[id] = true\n\tend\n\tlocal open = route.chat:peek().session\n\tlocal cutoff = t - days * 86400\n\tfor _, c in now_state.chats do\n\t\tlocal st = c.status\n\t\tlocal idle_since = math.max(c.updated or 0, came_back[c.id] or 0)\n\t\tif\n\t\t\tnot pinned[c.id]\n\t\t\tand c.id ~= open\n\t\t\tand not c.sleep_until\n\t\t\tand not c.woke\n\t\t\tand not (st and (UNDER_WAY[st] or NEEDS_YOU[st]))\n\t\t\tand idle_since > 0\n\t\t\tand idle_since < cutoff\n\t\tthen\n\t\t\tsessions.archive(c.id)\n\t\tend\n\tend\nend\n\n-- The minute beat: one timer for the module, armed here and not in an\n-- effect (an effect owns the timers it arms, and every run of one would\n-- cancel and restart it: a busy minute of session changes would starve it).\n-- Each tick does something only while something reads it: a sleeper's\n-- countdown moves while one is asleep, and the sweep runs while\n-- auto-archive is on. A reload numbers the beat anew; the old one stops.\nlocal beat_gen = ui.state(\"activity_beat_gen\", 0)\nbeat_gen:set(beat_gen:peek() + 1)\nlocal my_beat = beat_gen:peek()\nlocal function beat()\n\tui.after(60 * 1000, function()\n\t\tif beat_gen:peek() ~= my_beat then\n\t\t\treturn\n\t\tend\n\t\tif M.on:peek() then\n\t\t\tfor _, c in sessions.now:peek().chats do\n\t\t\t\tif c.sleep_until then\n\t\t\t\t\tminute:set(minute:peek() + 1)\n\t\t\t\t\tbreak\n\t\t\t\tend\n\t\t\tend\n\t\t\tsweep()\n\t\tend\n\t\tbeat()\n\tend)\nend\nbeat()\n-- (Auto-archive turned on, or its days changed: a sweep now, not a minute\n-- on.)\nui.effect(function()\n\tM.on:get()\n\tM.archive_after:get()\n\tui.after(0, sweep)\nend)\n\nreturn M\n",
		["apps/zgx/ui/screens/shell/fit_policy.luau"] = "-- Zeron's panel fit, the policy alone (no state): its widths and which\n-- columns a window has room for. screens/shell/fit holds the window's and\n-- reads it; see there. (crates/ui settings.rs, shell/panel_layout.rs\n-- `horizontal_panel_fit`, shell.rs `content_split`, `right_pane_max_width`,\n-- `right_pane_takeover_width`.)\n\nlocal M = {}\n\n-- Zeron's widths (crates/ui settings.rs), in points. (The sidebar's default\n-- a step wider than Zeron's 256: Gaël's.)\nM.SIDEBAR_MIN, M.SIDEBAR_MAX, M.SIDEBAR_DEFAULT = 242, 400, 272\nM.FILES_PANEL_MIN, M.FILES_PANEL_DEFAULT, M.FILES_PANEL_MAX = 220, 286, 440\nM.RIGHT_PANE_MIN, M.RIGHT_PANE_DEFAULT = 360, 520\nM.CHAT_PANEL_MIN = 300\n-- A chat's card at the page's least: the window's three gaps round it (each\n-- side, and before the panel) come out of CHAT_PANEL_MIN. What a split's panes\n-- each want beside the two sides: it leaves a draft 93 points of the\n-- composer's line beside its controls (45 at 240, 5 at 200, then the line\n-- opens out with its controls overlapping) and the reply a 240-point column.\nM.PANE_MIN = 288\n-- What stands round a split's panes beside the sidebar and the panel: the window's\n-- edge each side (5) and the gaps after the sidebar and before the panel (4).\nM.PAGE_EDGES = 18\n\nexport type Column = { open: boolean, at: number }\nexport type Fit = { sidebar: boolean, right: boolean, files: boolean, sidebar_limit: number }\n\n-- What the page wants: `across` panes side by side (panes stacked in a column\n-- are one across), each at its least, the gaps between them and the window's\n-- round them. One across is the chat's least.\nfunction M.page_floor(across: number, gap: number): number\n\tif across <= 1 then\n\t\treturn M.CHAT_PANEL_MIN\n\tend\n\treturn M.PAGE_EDGES + across * M.PANE_MIN + (across - 1) * gap\nend\n\n-- What the page asks of the sidebar: its panes no narrower than the panel\n-- beside them. The sidebar gives way before they are, though they can narrow\n-- to their least (`PANE_MIN`) and past it.\nfunction M.page_comfort(page_floor: number): number\n\tif page_floor <= M.CHAT_PANEL_MIN then\n\t\treturn page_floor\n\tend\n\t-- (`gap` is small beside a pane: the count comes out whole.)\n\tlocal across = math.round((page_floor - M.PAGE_EDGES) / M.PANE_MIN - 0.02)\n\treturn page_floor + across * (M.RIGHT_PANE_MIN - M.PANE_MIN)\nend\n\n-- Whether the page has what it wants beside columns this wide.\nfunction M.panes_fit(viewport: number, page_floor: number, sidebar: number, panel: number): boolean\n\treturn page_floor + sidebar + panel <= viewport\nend\n\n-- The policy: which of the columns show in a window `viewport` wide, the\n-- sidebar preferring `sidebar_width`, the panel expanded or not. (`files_min`:\n-- Files' least, Zeron's unless an app's Files column is wider.)\nfunction M.panels(\n\tviewport: number,\n\tsidebar_width: number,\n\tsidebar: Column,\n\tright: Column,\n\tfiles: Column,\n\texpanded: boolean,\n\tfiles_min: number?\n): Fit\n\tlocal FILES = files_min or M.FILES_PANEL_MIN\n\tlocal names = { \"sidebar\", \"right\", \"files\" }\n\tlocal open = { sidebar.open, right.open, files.open }\n\tlocal at = { sidebar.at, right.at, files.at }\n\tviewport = math.max(viewport, 0)\n\t-- Expanded spends only the chat's width on the panel: the other columns\n\t-- fit as ever. Below the chat's and the panel's least, the panel alone\n\t-- may still take over.\n\tlocal narrow_takeover = expanded and right.open and viewport < M.CHAT_PANEL_MIN + M.RIGHT_PANE_MIN\n\tif narrow_takeover then\n\t\topen[1], open[3] = false, false\n\tend\n\twhile true do\n\t\tlocal chat_floor = if open[2] and narrow_takeover then 0 else M.CHAT_PANEL_MIN\n\t\tlocal minimum = chat_floor\n\t\t\t+ (if open[1] then M.SIDEBAR_MIN else 0)\n\t\t\t+ (if open[2] then M.RIGHT_PANE_MIN else 0)\n\t\t\t+ (if open[3] then FILES else 0)\n\t\tif minimum <= viewport then\n\t\t\treturn {\n\t\t\t\tsidebar = open[1],\n\t\t\t\tright = open[2],\n\t\t\t\tfiles = open[3],\n\t\t\t\tsidebar_limit = if open[1]\n\t\t\t\t\tthen math.min(\n\t\t\t\t\t\tviewport\n\t\t\t\t\t\t\t- chat_floor\n\t\t\t\t\t\t\t- (if open[2] then M.RIGHT_PANE_MIN else 0)\n\t\t\t\t\t\t\t- (if open[3] then FILES else 0),\n\t\t\t\t\t\tsidebar_width\n\t\t\t\t\t)\n\t\t\t\t\telse 0,\n\t\t\t}\n\t\tend\n\t\t-- The least recently opened goes; an expanded panel after the rest.\n\t\tlocal victim: number? = nil\n\t\tlocal best: { number }? = nil\n\t\tfor i = 1, 3 do\n\t\t\tif open[i] then\n\t\t\t\tlocal key = { if expanded and names[i] == \"right\" then 1 else 0, at[i] }\n\t\t\t\tif best == nil or key[1] < best[1] or (key[1] == best[1] and key[2] < best[2]) then\n\t\t\t\t\tvictim, best = i, key\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tif victim == nil then\n\t\t\treturn { sidebar = false, right = false, files = false, sidebar_limit = 0 }\n\t\tend\n\t\topen[victim] = false\n\tend\nend\n\n-- The panel's share of `available` (what the tools leave the chat and the\n-- panel): half, the panel keeping its least and the page as much of what it\n-- wants (`page_floor`, one chat's least unless it's split) as fits.\nfunction M.content_split(available: number, page_floor: number?): number\n\treturn math.min(math.max(available / 2, M.RIGHT_PANE_MIN), math.max(available - (page_floor or M.CHAT_PANEL_MIN), M.RIGHT_PANE_MIN))\nend\n\n-- The most the panel's part beside its tree may take: what leaves the page\n-- what it wants, but never under the panel's least. Past that the panes narrow.\nfunction M.panel_room(viewport: number, sidebar: number, tree: number, page_floor: number): number\n\treturn math.max(viewport - sidebar - tree - page_floor, M.RIGHT_PANE_MIN - tree)\nend\n\n-- The widest the panel may be dragged: the chat keeps its least.\nfunction M.right_pane_max_width(viewport: number, sidebar: number, chat_floor: number): number\n\treturn math.max(viewport - sidebar - chat_floor, 0)\nend\n\n-- The panel expanded: all of the chat's room.\nfunction M.right_pane_takeover_width(viewport: number, sidebar: number): number\n\treturn math.max(viewport - sidebar, 0)\nend\n\nreturn M\n",
		["apps/zgx/ui/screens/shell/project_default.luau"] = "-- A project's default tile, the same on every device: a copy of a repository\n-- (its `repository` identity shared by every clone, the key its name and icon\n-- are shared under) takes its hue from that identity, and its artwork from\n-- the repository's copies in one order. A `local:` identity is one device's\n-- own and a folder has none: those keep to their own id, as before.\n--\n--   default.shared(repository)   the identity copies share, nil if none\n--   default.key(p)               what its default follows: `repo:<identity>`,\n--                                else its id\n--   default.hue_of(key)          the hue a key has, the same every time\n--   default.hue(p)               its default hue\n--   default.copies(p, all)       where its artwork is looked for, in order:\n--                                the repository's copies, oldest first (id\n--                                breaking ties), else itself\n--\n-- Pure: no state, no host.\n\nlocal M = {}\n\n-- (The default's order, kept as it was so no project's colour changes.)\nlocal DEFAULT_HUES = { \"violet\", \"blue\", \"emerald\", \"sky\", \"amber\", \"rose\", \"lime\", \"teal\", \"orange\", \"indigo\", \"pink\", \"cyan\" }\n\nexport type Copy = { id: string, repository: string?, created: number? }\n\nfunction M.shared(repository: string?): string?\n\tif repository == nil or repository == \"\" or string.sub(repository, 1, 6) == \"local:\" then\n\t\treturn nil\n\tend\n\treturn repository\nend\n\nfunction M.key(p: Copy): string\n\tlocal identity = M.shared(p.repository)\n\treturn if identity then `repo:{identity}` else p.id\nend\n\nfunction M.hue_of(key: string): string\n\tlocal n = 0\n\tfor i = 1, #key do\n\t\tn = (n * 31 + string.byte(key, i)) % 9973\n\tend\n\treturn DEFAULT_HUES[n % #DEFAULT_HUES + 1]\nend\n\nfunction M.hue(p: Copy): string\n\treturn M.hue_of(M.shared(p.repository) or p.id)\nend\n\nfunction M.copies<T>(p: T & Copy, all: { T & Copy }): { T & Copy }\n\tlocal identity = M.shared(p.repository)\n\tif not identity then\n\t\treturn { p }\n\tend\n\tlocal out = {}\n\tfor _, q in all do\n\t\tif q.repository == identity then\n\t\t\ttable.insert(out, q)\n\t\tend\n\tend\n\tif #out == 0 then\n\t\treturn { p }\n\tend\n\ttable.sort(out, function(a, b): boolean\n\t\tlocal x, y = a.created or math.huge, b.created or math.huge\n\t\tif x ~= y then\n\t\t\treturn x < y\n\t\tend\n\t\treturn a.id < b.id\n\tend)\n\treturn out\nend\n\nreturn M\n",
		["apps/zgx/ui/screens/shell/title_bar.luau"] = "-- The main window's title bar: the design system's (ds.TitleBar: the\n-- window's buttons, the sidebar's toggle, back and forward, at Zeron's\n-- places), over the window's top, its island showing while the sidebar is\n-- collapsed over a new chat's wallpaper. At its other end, the page's own\n-- controls: on a session, its panel's toggle. Plugins place theirs by\n-- `#titlebar-actions`.\n--\n-- `TitleBar { collapsed = state, files = state, art = fn }`\n\nlocal ds = require(\"@ds\")\nlocal route = require(\"@app/screens/shell/route\")\nlocal fit = require(\"@app/screens/shell/fit\")\nlocal boundary = require(\"@app/screens/shell/boundary\")\nlocal locale = require(\"@ds/locale\")\n\n-- The actions' last width, kept across a reload of the scripts.\nlocal actions_width = ui.state(\"shell_titlebar_actions_w\", 0)\n\nexport type Props = {\n\tcollapsed: State<boolean>,\n\tfiles: State<boolean>,\n\t-- Whether the bar stands over a wallpaper (its island shows, collapsed).\n\tart: () -> boolean,\n\tcaption_over_art: boolean?,\n\t-- A new chat's page has a panel too (v3's).\n\tpanel_on_home: boolean?,\n}\n\n-- Production's \"corner card\" glyph (icons.rs `corner_card_glyph`): the\n-- sidebar glyph's frame, a card in its top right.\nlocal function corner_card(size: number): Node\n\tlocal s = size / 24\n\tlocal stroke = 1.75\n\tlocal function raw(v: number): any\n\t\treturn ui.raw(v, \"the glyph's own geometry, scaled from its 24-unit source\")\n\tend\n\treturn ui.div {\n\t\tw = size,\n\t\th = size,\n\t\tshrink = 0,\n\t\tui.div {\n\t\t\tabsolute = true,\n\t\t\tleft = (3 - stroke / 2) * s,\n\t\t\ttop = (4 - stroke / 2) * s,\n\t\t\tw = (18 + stroke) * s,\n\t\t\th = (16 + stroke) * s,\n\t\t\trounded = raw((4 + stroke / 2) * s),\n\t\t\tborder = \"$zeron.glyph.stroke\",\n\t\t\tborder_color = \"$zeron.bar.ink\",\n\t\t},\n\t\tui.div {\n\t\t\tabsolute = true,\n\t\t\tright = 6.5 * s,\n\t\t\ttop = 7.5 * s,\n\t\t\tw = 5.5 * s,\n\t\t\th = 4.5 * s,\n\t\t\trounded = raw(0.875 * s),\n\t\t\tbg = \"$zeron.bar.ink\",\n\t\t},\n\t}\nend\n\nreturn function(props: Props): Node\n\tlocal size = ds.island.metrics().control\n\t-- The session's lanes (side chats, subagents: screens/chat/lanes), where\n\t-- that screen is there.\n\tlocal function lanes(): any\n\t\treturn boundary.load(\"@app/screens/chat/lanes\")\n\tend\n\tlocal function badge(): number\n\t\tlocal l = lanes()\n\t\treturn if l and l.badge then (l.badge :: any)() else 0\n\tend\n\tlocal actions = ui.row {\n\t\tid = \"titlebar-actions\",\n\t\titems = \"center\",\n\t\tgap = \"$zeron.island.gap\",\n\t\t-- The session's details (its lanes: side chats and subagents), as\n\t\t-- Zeron's titlebar toggle: its count while any run, open or not.\n\t\tui.show(\n\t\t\tfunction(): boolean\n\t\t\t\tlocal l = lanes()\n\t\t\t\t-- (Off while the card is: `lanes.on`.)\n\t\t\t\treturn route.current:get().name == \"session\" and l ~= nil and l.on ~= nil and (l.on :: any)() == true\n\t\t\tend,\n\t\t\tui.div {\n\t\t\t\trelative = true,\n\t\t\t\tds.IconButton {\n\t\t\t\t\tid = \"titlebar-session-details\",\n\t\t\t\t\tlabel = function(): string\n\t\t\t\t\t\tlocal l = lanes()\n\t\t\t\t\t\tlocal open = l and l.shown and (l.shown :: any)()\n\t\t\t\t\t\treturn locale.s(if open then \"shell.title_bar.hide_details\" else \"shell.title_bar.show_details\")\n\t\t\t\t\tend,\n\t\t\t\t\ttooltip_side = \"bottom\",\n\t\t\t\t\tw = size,\n\t\t\t\t\th = size,\n\t\t\t\t\ttone = \"bar\",\n\t\t\t\t\tlit = function(): boolean\n\t\t\t\t\t\tlocal l = lanes()\n\t\t\t\t\t\treturn l ~= nil and l.shown ~= nil and (l.shown :: any)() == true\n\t\t\t\t\tend,\n\t\t\t\t\ton_click = function()\n\t\t\t\t\t\tlocal l = lanes()\n\t\t\t\t\t\tif l and l.toggle then\n\t\t\t\t\t\t\t(l.toggle :: any)()\n\t\t\t\t\t\tend\n\t\t\t\t\tend,\n\t\t\t\t\tcorner_card(16),\n\t\t\t\t},\n\t\t\t\tui.show(\n\t\t\t\t\tfunction(): boolean\n\t\t\t\t\t\treturn badge() > 0\n\t\t\t\t\tend,\n\t\t\t\t\tui.row {\n\t\t\t\t\t\tabsolute = true,\n\t\t\t\t\t\tright = -2,\n\t\t\t\t\t\ttop = -2,\n\t\t\t\t\t\th = 13,\n\t\t\t\t\t\tmin_w = 13,\n\t\t\t\t\t\tpx = ui.raw(3, \"production's titlebar count badge (running_pill.rs): its digits 3 in from its round ends\"),\n\t\t\t\t\t\titems = \"center\",\n\t\t\t\t\t\tjustify = \"center\",\n\t\t\t\t\t\trounded = \"$radius.full\",\n\t\t\t\t\t\tbg = \"$zeron.status.working\",\n\t\t\t\t\t\tpointer_events = \"none\",\n\t\t\t\t\t\tui.text {\n\t\t\t\t\t\t\tfunction(): string\n\t\t\t\t\t\t\t\tlocal n = badge()\n\t\t\t\t\t\t\t\treturn if n > 99 then \"99+\" else tostring(n)\n\t\t\t\t\t\t\tend,\n\t\t\t\t\t\t\ttext_size = \"$font.size.xs\",\n\t\t\t\t\t\t\tweight = \"$font.weight.medium\",\n\t\t\t\t\t\t\tcolor = \"$background\",\n\t\t\t\t\t\t\ttabular = true,\n\t\t\t\t\t\t},\n\t\t\t\t\t}\n\t\t\t\t),\n\t\t\t}\n\t\t),\n\t\tui.show(\n\t\t\tfunction(): boolean\n\t\t\t\t-- (A plugin's page has a panel of its own too.)\n\t\t\t\t-- (Under settings, as the chats stand there: in v3 it's beside them.)\n\t\t\t\tlocal name = if props.panel_on_home == true then route.chat:get().name else route.current:get().name\n\t\t\t\treturn name == \"session\" or name == \"plugin\" or (props.panel_on_home == true and name == \"home\")\n\t\t\tend,\n\t\t\t-- The session's panel: the sidebar's glyph mirrored (its panel at\n\t\t\t-- the right), narrowing as the panel closes, as the left one does.\n\t\t\tds.IconButton {\n\t\t\t\tlabel = ui.t(\"shell.title_bar.panel\"),\n\t\t\t\ttooltip = locale.s(\"shell.title_bar.panel_tooltip\", { key = ui.shortcut_text(\"cmd+r\") }),\n\t\t\t\ttooltip_side = \"bottom\",\n\t\t\t\tw = size,\n\t\t\t\th = size,\n\t\t\t\ttone = \"bar\",\n\t\t\t\ton_click = function()\n\t\t\t\t\tfit.toggle_panel()\n\t\t\t\tend,\n\t\t\t\tds.SidebarIcon { open = props.files, side = \"right\", size = 16, ink = \"$zeron.bar.ink\" },\n\t\t\t}\n\t\t),\n\t}\n\treturn ui.div {\n\t\tid = \"titlebar\",\n\t\tabsolute = true,\n\t\tleft = 0,\n\t\tright = 0,\n\t\ttop = 0,\n\t\t-- (Over the sidebar's top and the page's: the pointer goes through\n\t\t-- to them, but for the bar's own controls.)\n\t\tpointer_events = \"none\",\n\t\tds.TitleBar {\n\t\t\tcollapsed = props.collapsed,\n\t\t\ton_toggle = fit.toggle_sidebar,\n\t\t\t-- Glass behind the window's buttons and the controls while the\n\t\t\t-- sidebar is collapsed over a wallpaper (v2's new chat). Zeron's own\n\t\t\t-- look has no art here (`art` false): they stand on its top bar.\n\t\t\tisland = function(): boolean\n\t\t\t\treturn props.collapsed:get() and props.art()\n\t\t\tend,\n\t\t\tcan_back = route.can_back,\n\t\t\tcan_forward = route.can_forward,\n\t\t\ton_back = route.back,\n\t\t\ton_forward = route.forward,\n\t\t\tactions = actions,\n\t\t\t-- (Over a new chat's wallpaper, what's in it (a plugin's) stands on\n\t\t\t-- the island's glass, the sidebar open or not.)\n\t\t\tactions_island = props.art,\n\t\t\tcaption_over_art = props.caption_over_art,\n\t\t\tactions_width = actions_width,\n\t\t},\n\t}\nend\n",
		["apps/zgx/ui/screens/templates/state.luau"] = "--!strict\n-- Your templates, as the host publishes them (src/plugins/live.rs): Zeron's\n-- own first, then each one made here, which is in use, and how each stands.\n--\n--   state.now:get()   { state = \"loading\" | \"ready\", active = id, dir,\n--                       list = { Template } }\n--   state.previews:get()  each template's preview themes by its id: one a\n--                         changed appearance (light, then dark), Zeron's\n--                         own two for one that changes none\n--   state.use(id)            a promise: the window changes to it, in place\n--   state.create(name)       a promise of the new one's id (a copy of Zeron's)\n--   state.duplicate(id)      a promise of the copy's id\n--   state.delete(id)         a promise (Zeron's own can't be)\n--   state.open_folder(id)    its folder in Finder\n--   state.yours(t)           whether you (or your agents) made it\n--   state.export(id, path)   a promise of `{ path, files }`: it, signed as\n--                            yours, as one .zeron-template file\n--   state.import(from)       from a file (`path`, or `{ path }`) or a link\n--                            (`{ url }`: a .zeron-template's, or a GitHub\n--                            repository or release with one): a promise of\n--                            `{ installed = id, name }` (yours), or\n--                            `{ pending = name }` (someone else's: the host\n--                            opens Zeron's consent window for it)\n--   state.check_updates()    a promise: each one from a package checked\n--                            where it came from for a newer version\n--   state.update(id)         a promise of `{ updated, name, version, from }`:\n--                            the update found for it, in its place\n--   state.review(name)       a waiting package's consent window\n--   state.pending:get()      packages waiting for you to allow them\n\nlocal palettes = require(\"@ds/palettes\")\n\nlocal M = {}\n\nexport type Template = {\n\tid: string,\n\tname: string,\n\tdescription: string?,\n\tauthor: string?,\n\tversion: string?,\n\t-- The Zeron it was made from.\n\tzeron_version: string?,\n\tbuiltin: boolean,\n\tactive: boolean,\n\t-- \"ok\" | \"broken\" (it can't run: Zeron's own shows) | \"errors\" (some of\n\t-- its files fall back) | \"out_of_date\" (made for another Zeron: Zeron\n\t-- has updated since)\n\tstatus: string,\n\terror: string?,\n\t-- Installed from someone's package: who signed it (`author.kind` \"you\",\n\t-- \"verified\" with `username`, or \"unknown\" with `reason`).\n\t-- `source`: where it came from (`{ kind, url?, ref? }`).\n\timported: { key: string, author: any, source: any? }?,\n\t-- A newer version found where it came from (`{ version, refused? }`).\n\tupdate: { version: string, refused: string? }?,\n\t-- The colours its preview is drawn in (src/plugins/looks.rs): each\n\t-- appearance it changes, as its theme file and its palette over it.\n\t-- None for one that changes no colour of Zeron's.\n\tlook: Look?,\n}\nexport type Scheme = { theme: { type: string?, extends: string?, tokens: any }?, palette: any? }\nexport type Look = { stamp: string, light: Scheme?, dark: Scheme? }\n-- A package waiting for you to allow it.\n-- (`here`: its window opened as it came, so it has no notice in the corner.)\nexport type Pending = { pending: string, name: string, source: string?, files: number?, ignored: { string }?, here: boolean? }\nexport type Now = { state: string, active: string?, dir: string?, list: { Template }?, pending: { Pending }? }\n\nM.now = ui.shared(\"templates\", { state = \"loading\" } :: Now)\n\nM.list = ui.computed(function(): { Template }\n\treturn M.now:get().list or {}\nend)\n\nM.pending = ui.computed(function(): { Pending }\n\treturn M.now:get().pending or {}\nend)\n\n-- Each template's preview themes: its look registered once a change, each\n-- appearance it changes as a theme of its own (its theme file over zgx's,\n-- its palette over that or over Zeron's, through ds/palettes as the window\n-- wears it), so its preview is drawn in its tokens as the window would be.\nlocal registered: { [string]: string } = {}\nlocal function register(name: string, stamp: string, spec: any)\n\tif registered[name] ~= stamp then\n\t\tregistered[name] = stamp\n\t\tui.theme.register(spec)\n\tend\nend\n\nlocal function wear(id: string, look: Look, base: { light: string, dark: string }): { string }\n\tlocal names = {}\n\tfor _, scheme in { \"light\", \"dark\" } do\n\t\tlocal entry = (look :: any)[scheme] :: Scheme?\n\t\tif entry then\n\t\t\tlocal name = `preview-{id}-{scheme}`\n\t\t\tlocal under = (base :: any)[scheme]\n\t\t\tif entry.theme then\n\t\t\t\tlocal file = if entry.palette then `{name}-file` else name\n\t\t\t\tlocal theme = entry.theme :: any\n\t\t\t\tregister(file, look.stamp, { name = file, type = theme.type or scheme, extends = theme.extends or `zgx-{scheme}`, tokens = theme.tokens or {} })\n\t\t\t\tunder = file\n\t\t\tend\n\t\t\tif entry.palette then\n\t\t\t\tlocal p = table.clone(entry.palette)\n\t\t\t\tp.kind = scheme\n\t\t\t\tregister(name, look.stamp, { name = name, type = scheme, extends = under, tokens = (palettes.tokens(p)) or {} })\n\t\t\tend\n\t\t\ttable.insert(names, name)\n\t\tend\n\tend\n\treturn names\nend\n\nM.previews = ui.state(\"templates_previews\", {} :: { [string]: { string } })\nui.effect(function()\n\tlocal list = M.list:get()\n\t-- Zeron's own first: what an appearance a template leaves alone shows.\n\t-- (Its own theme names until the host has said its look.)\n\tlocal own = { light = \"zeron-light\", dark = \"zeron-dark\" }\n\tlocal out: { [string]: { string } } = {}\n\tfor _, t in list do\n\t\tif t.id == \"zeron\" and t.look then\n\t\t\tlocal names = wear(t.id, t.look, own)\n\t\t\tif #names == 2 then\n\t\t\t\town = { light = names[1], dark = names[2] }\n\t\t\tend\n\t\tend\n\tend\n\tfor _, t in list do\n\t\tlocal names = if t.look and t.id ~= \"zeron\" then wear(t.id, t.look, own) else {}\n\t\tout[t.id] = if #names > 0 then names else { own.light, own.dark }\n\tend\n\tM.previews:set(out)\nend)\n\n-- Yours: made on this device, by you or an agent you asked (theirs say\n-- \"you\", or nothing, written by hand), or installed from a package you\n-- signed. Zeron's own is built in; someone else's says who.\nfunction M.yours(t: Template): boolean\n\tif t.builtin then\n\t\treturn false\n\tend\n\tif t.imported then\n\t\treturn t.imported.author ~= nil and t.imported.author.kind == \"you\"\n\tend\n\treturn t.author == nil or t.author == \"\" or t.author == \"you\"\nend\n\nfunction M.use(id: string): any\n\treturn ui.call(\"templates.use\", id)\nend\n\nfunction M.create(name: string): any\n\treturn ui.call(\"templates.create\", name)\nend\n\nfunction M.duplicate(id: string): any\n\treturn ui.call(\"templates.duplicate\", id)\nend\n\nfunction M.delete(id: string): any\n\treturn ui.call(\"templates.delete\", id)\nend\n\nfunction M.export(id: string, path: string): any\n\treturn ui.call(\"templates.export\", { id = id, path = path })\nend\n\nfunction M.import(from: string | { path: string?, url: string? }): any\n\treturn ui.call(\"templates.import\", from)\nend\n\nfunction M.check_updates(): any\n\treturn ui.call(\"templates.check_updates\", nil)\nend\n\nfunction M.update(id: string): any\n\treturn ui.call(\"templates.update\", id)\nend\n\nfunction M.review(name: string)\n\tui.invoke(\"templates.review\", name)\nend\n\nfunction M.open_folder(id: string)\n\tui.invoke(\"templates.open_folder\", id)\nend\n\nreturn M\n",
		["apps/zgx/ui/segmented_fixture.luau"] = "-- Segmented controls in a column that stretches its children, at several\n-- widths: filling (a dialog's three equal choices), fixed segments, and\n-- segments as wide as their labels. What tests/segmented.test.luau measures:\n-- the thumb's inset from its track, the same on every side.\n\nui.theme.strict(\"warn\")\nlocal ds = require(\"@ds\")\nds.setup()\n\nlocal three = { { value = \"a\", label = \"Default\" }, { value = \"b\", label = \"Emoji\" }, { value = \"c\", label = \"Image\" } }\nlocal two = { { value = \"light\", label = \"Light\" }, { value = \"dark\", label = \"Dark\" } }\n\nlocal function stretched(w: number, child: Node): Node\n\t-- (A column stretches what's in it: the case that left room past the\n\t-- last segment.)\n\treturn ui.column { w = w, items = \"stretch\", child }\nend\n\nreturn ui.column {\n\tw = 640,\n\th = 520,\n\tp = 20,\n\tgap = 16,\n\tbg = \"$background\",\n\tstretched(410, ds.Segmented { id = \"fill-410\", value = ui.state(\"seg_fill_410\", \"c\"), options = three, fill = true }),\n\tstretched(300, ds.Segmented { id = \"fill-300\", value = ui.state(\"seg_fill_300\", \"b\"), options = three, fill = true }),\n\tstretched(600, ds.Segmented { id = \"fill-600\", value = ui.state(\"seg_fill_600\", \"a\"), options = two, fill = true }),\n\tstretched(410, ds.Segmented { id = \"fixed-410\", value = ui.state(\"seg_fixed_410\", \"c\"), options = three, segment = 96 }),\n\tstretched(410, ds.Segmented { id = \"labels-410\", value = ui.state(\"seg_labels_410\", \"dark\"), options = two }),\n}\n",
		["apps/zgx/ui/table_fixture.luau"] = "-- Tables as a reply draws them, for ds/markdown's table tests and pictures:\n-- the four shapes that matter, each in the reply's own column, in a page that\n-- scrolls as a transcript does. `only_<name>` shows one alone; `width_<n>`\n-- narrows the column; `theme_*`, `opaque` and `frosted` wear the others.\n\nui.theme.strict(\"warn\")\nlocal ds = require(\"@ds\")\nds.setup()\nlocal DataTable = require(\"@ds/data_table\")\nlocal Markdown = require(\"@ds/markdown\")\nlocal material = require(\"@ds/material\")\n\nlocal TABLES: { [string]: string } = {\n\t-- Two columns of prose, as in a reply weighing a change.\n\ttwo = [[\n| Cost of #1520 | Does #1523 offset it? |\n| --- | --- |\n| Keyed row reconciliation adds an allocation per row on every streamed token | Mostly: the keyed cache removes the per-row allocation for rows that stayed, so only new rows pay |\n| The veil keeps a chunk list per paragraph until it finishes fading | No, but the list is short and goes when the reply settles |\n| A wider retained tree makes hit testing walk more nodes | Yes, the spatial index skips whole columns once #1523 lands |\n]],\n\t-- A 30-character label beside prose, as in a reply listing its chats: the\n\t-- label's room is its words' own, the prose takes the rest.\n\trunning = [[\n| Chat | Doing |\n| --- | --- |\n| **a1b2c3d4**, engine hang | Getting function names into the hang capture, which lock froze and whose code holds it, then a fix in a separate worktree. It won't deploy, restart the engine or push. It will say whether the build should go back to the previous release until there's a fix. |\n| **e5f6a7b8**, nightly CI builds | The first full build on GitHub passed: Linux in 17m and Windows in 43m29s. It's rerunning to measure how fast a second build is once cached. |\n| **c9d0e1f2**, sidebar icon | Building it. |\n]],\n\t-- A 38-character label beside long prose with bold and code, as in a\n\t-- reply giving where things stand (the table Wing couldn't scroll).\n\tstatus = [[\n| Area | Status |\n|---|---|\n| **Beta.5** | Windows and both Linux builds passed. macOS has been building, signing and notarizing for about 40 minutes; notarization usually takes the longest. It publishes right after. |\n| **Memory** | Two of the three fixes are merged in zgx (#1960, #1981); #1945 merges after its checks. Together they bring memory after heavy use to about **264 MB** (was 315, and beta.1 was 271). The memory chat is now chasing the remaining ~50 MB stuck in partly used memory pages. |\n| **Streaming** | ff4bff4f's three zgx PRs are open and in CI: append-only text, styled text that follows state, and the fade-in drawn as one piece. Next is the GPU-run fade-in under the glass, worked out with the render chat. Your staging app's build is at 5.9% (from 7.1%), with about 4–4.5% as the next target. |\n| **Scrolling** | Waiting on zgx CI: accessibility updates (#1931), zgx's built-in scroll bar (#1961), and the \"scrolling stopped\" timer (#1975). The Zeron side of each is ready on branches. The working-rings fix is merged. |\n| **The scroll-skip / overlapping-rows bug** | Not reproduced, and no cause yet. Tests are in place. If it happens again, send a screenshot and the chat name before navigating away. |\n]],\n\t-- Short labels and numbers beside a column of prose.\n\tmixed = [[\n| Build | Size | Change | Notes |\n| --- | ---: | ---: | --- |\n| v0.2.115 | 41.2 MB | -3.1% | Dropped the second copy of the emoji table, which both the picker and the composer's mentions had been carrying |\n| v0.2.116 | 41.9 MB | +1.7% | Long transcripts split their messages so the engine socket doesn't drop |\n]],\n\t-- More columns than a reply's width can ever hold in words.\n\tmany = [[\n| Harness | Model | Region | Turns | Input tokens | Output tokens | Cached share | Median first token |\n| --- | --- | --- | ---: | ---: | ---: | ---: | ---: |\n| copilot | opus-5-5 | us-west-2 | 128 | 1,482,190 | 96,204 | 81% | 1.24 s |\n| mock | gpt-5.5-mock | us-east-1 | 94 | 902,441 | 71,880 | 66% | 1.61 s |\n| opencode | sonnet-5-5 | eu-central-1 | 41 | 318,007 | 28,512 | 42% | 1.08 s |\n| muse | muse-spark | us-west-2 | 12 | 77,300 | 9,014 | 0% | 2.47 s |\n]],\n\t-- Words the source sets on their right, numbers or not.\n\tsaid = [[\n| Plan | Note |\n| ---: | --- |\n| Free | Yours to keep |\n| Team of many | Billed by seat |\n]],\n\t-- A column of prose short of a wrap beside numbers: the table is\n\t-- narrower than the reply until its prose column takes what's left.\n\tloose = [[\n| Changes | Frames |\n| --- | --- |\n| layout box easing | 3 |\n| sideways wheel and drift latch | 12 |\n| `~~` only | 1 |\n]],\n\t-- A cell whose code can't break anywhere.\n\tcode = [[\n| Setting | Where it's read |\n| --- | --- |\n| Scroll | `application.rs::ScrollResampler::push_wheel_with_a_very_long_name_that_cannot_wrap::and_goes_on_past_any_reply_width::as_generated_code_does` |\n| Theme | `ds/tokens.luau` |\n]],\n}\n\n-- `ui.table` in a visual (ds/data_table), whose columns share the width.\nlocal DATA = {\n\t{ \"Keyed row reconciliation adds an allocation per row on every streamed token\", \"1,482\" },\n\t{ \"The veil keeps a chunk list per paragraph\", \"96\" },\n}\n\nlocal only = ui.state(\"table_only\", \"all\")\nlocal width = ui.state(\"table_width\", 760)\n\nfor name in TABLES do\n\tui.command { id = `only_{name}`, title = name, run = function()\n\t\tonly:set(name)\n\tend }\nend\nui.command { id = \"only_data\", title = \"data\", run = function()\n\tonly:set(\"data\")\nend }\nui.command { id = \"only_all\", title = \"all\", run = function()\n\tonly:set(\"all\")\nend }\nfor _, w in { 280, 360, 400, 480, 560, 620, 680, 760, 860 } do\n\tui.command { id = `width_{w}`, title = `{w}`, run = function()\n\t\twidth:set(w)\n\tend }\nend\nui.command { id = \"theme_light\", title = \"Light\", run = function()\n\tui.theme.follow_system(false)\n\tui.theme.current:set(\"zeron-light\")\nend }\nui.command { id = \"theme_dark\", title = \"Dark\", run = function()\n\tui.theme.follow_system(false)\n\tui.theme.current:set(\"zeron-dark\")\nend }\nui.command { id = \"opaque\", title = \"Opaque\", run = function()\n\tmaterial.frosted:set(false)\nend }\nui.command { id = \"frosted\", title = \"Frosted\", run = function()\n\tmaterial.frosted:set(true)\nend }\n\nlocal function shown(name: string): Node\n\treturn ui.show(function(): boolean\n\t\treturn only:get() == \"all\" or only:get() == name\n\tend, ui.column {\n\t\tid = `case-{name}`,\n\t\tw_full = true,\n\t\tpb = \"$space.6\",\n\t\tMarkdown { text = TABLES[name] },\n\t})\nend\n\nreturn ui.column {\n\tid = \"stage\",\n\tw_full = true,\n\th_full = true,\n\tbg = function(): string\n\t\treturn if material.frosted:get() then \"$background\" else \"$zeron.window\"\n\tend,\n\tui.scroll {\n\t\tid = \"page\",\n\t\tgrow = 1,\n\t\tmin_h = 0,\n\t\tw_full = true,\n\t\tui.column {\n\t\t\tid = \"reply\",\n\t\t\tself = \"center\",\n\t\t\tp = \"$space.6\",\n\t\t\tw = function(): number\n\t\t\t\treturn width:get()\n\t\t\tend,\n\t\t\tshown(\"two\"),\n\t\t\tshown(\"running\"),\n\t\t\tshown(\"status\"),\n\t\t\tshown(\"mixed\"),\n\t\t\tshown(\"many\"),\n\t\t\tshown(\"code\"),\n\t\t\tshown(\"said\"),\n\t\t\tshown(\"loose\"),\n\t\t\tui.show(function(): boolean\n\t\t\t\treturn only:get() == \"all\" or only:get() == \"data\"\n\t\t\tend, ui.column {\n\t\t\t\tid = \"case-data\",\n\t\t\t\tw_full = true,\n\t\t\t\tpx = \"$space.3\",\n\t\t\t\tpb = \"$space.6\",\n\t\t\t\tDataTable {\n\t\t\t\t\tcolumns = {\n\t\t\t\t\t\t{ label = \"What a long heading says about what the column holds\" },\n\t\t\t\t\t\t{ label = \"Allocations per streamed token\", align = \"end\", w = 96 },\n\t\t\t\t\t},\n\t\t\t\t\trows = #DATA,\n\t\t\t\t\tcell = function(r: number, c: number): Node\n\t\t\t\t\t\treturn ui.text { class = \"data-text\", DATA[r][c], literal = true, wrap = true, min_w = 0 }\n\t\t\t\t\tend,\n\t\t\t\t},\n\t\t\t}),\n\t\t\tui.div { id = \"below\", w_full = true, h = 48, shrink = 0 },\n\t\t\tui.div { id = \"foot\", h = 1200, shrink = 0 },\n\t\t},\n\t},\n}\n",
		["apps/zgx/ui/templates_fixture.luau"] = "-- Settings → Templates, mounted on its own with templates made up here (no\n-- engine in a test host): the page tests/templates_in_place.test.luau\n-- drives. What the host would publish is set here; what the page asks is\n-- stubbed to change this data as the host would, and `ui.command`s change it\n-- as an agent's work would (a template made, one breaking).\n\nui.theme.strict(\"warn\")\nlocal ds = require(\"@ds\")\nds.setup()\nlocal state = require(\"@app/screens/templates/state\")\nlocal page = require(\"@app/screens/templates/page\")\n-- The command palette too, whose Templates rows use them (shell/palette).\n-- (No window chrome to restyle in a test host, as shell_fixture says.)\nlocal actions = require(\"@app/screens/onboarding/actions\");\n(actions :: any).apply_scheme = function() end\nlocal Palette = require(\"@app/screens/shell/palette\")\nlocal view = require(\"@app/screens/shell/view\")\n\n-- A template's own theme files (the hot pink one's, both; the night one's,\n-- only dark).\nlocal function theme(scheme: string, accent: string, window: string, text: string): state.Scheme\n\treturn { theme = { type = scheme, extends = `zgx-{scheme}`, tokens = { accent = accent, text = { primary = text }, zeron = { window = window } } } }\nend\n\nlocal model: { state.Template } = {\n\t{ id = \"zeron\", name = \"Keiki\", description = \"The default interface.\", author = \"Keiki\", version = \"0.2.131\", zeron_version = \"0.2.131\", builtin = true, active = true, status = \"ok\" },\n\t{ id = \"hot-pink\", name = \"Hot Pink\", description = \"Everything pink.\", author = \"you\", version = \"1.0.0\", builtin = false, active = false, status = \"ok\", look = { stamp = \"p1\", light = theme(\"light\", \"#d6247a\", \"#fff0f6\", \"#3d0a22\"), dark = theme(\"dark\", \"#ff3e9a\", \"#1a0010\", \"#ffe0ef\") } },\n\t{ id = \"night\", name = \"Night\", description = \"A darker dark.\", author = \"you\", version = \"1.0.0\", builtin = false, active = false, status = \"ok\", look = { stamp = \"n1\", dark = theme(\"dark\", \"#22ccaa\", \"#000000\", \"#e8fff9\") } },\n\t{ id = \"airy\", name = \"Airy\", description = \"More room between things.\", author = \"you\", version = \"1.0.0\", zeron_version = \"0.2.131\", builtin = false, active = false, status = \"ok\" },\n}\n\nlocal function find(id: string): state.Template\n\tfor _, t in model do\n\t\tif t.id == id then\n\t\t\treturn t\n\t\tend\n\tend\n\terror(`no template {id} in the fixture`)\nend\n\n-- Packages waiting for you (someone else's, brought in).\nlocal waiting: { state.Pending } = {}\n\nlocal function publish()\n\tlocal list: { state.Template } = {}\n\tlocal active = \"zeron\"\n\tfor _, t in model do\n\t\ttable.insert(list, table.clone(t))\n\t\tif t.active then\n\t\t\tactive = t.id\n\t\tend\n\tend\n\tstate.now:set({ state = \"ready\", active = active, dir = \"/tmp/templates\", list = list, pending = table.clone(waiting) })\nend\n\nlocal said: { string } = {}\nlocal calls = ui.state(\"calls\", \"\")\nlocal function note(what: string)\n\ttable.insert(said, what)\n\tcalls:set(table.concat(said, \",\"))\nend\nlocal stub = state :: any\nstub.use = function(id: string)\n\tnote(`use:{id}`)\n\tfor _, t in model do\n\t\tt.active = t.id == id\n\tend\n\tpublish()\nend\nstub.duplicate = function(id: string)\n\tnote(`duplicate:{id}`)\n\tlocal from = find(id)\n\ttable.insert(model, { id = `{id}-copy`, name = `{from.name} copy`, author = \"you\", builtin = false, active = false, status = \"ok\" })\n\tpublish()\nend\nstub.delete = function(id: string)\n\tnote(`delete:{id}`)\n\tfor i, t in model do\n\t\tif t.id == id then\n\t\t\ttable.remove(model, i)\n\t\t\tbreak\n\t\tend\n\tend\n\tpublish()\nend\nstub.create = function(name: string)\n\tnote(`create:{name}`)\n\tlocal id = string.lower((string.gsub(name, \"%W+\", \"-\")))\n\ttable.insert(model, { id = id, name = name, author = \"you\", version = \"1.0.0\", builtin = false, active = false, status = \"ok\" })\n\tpublish()\nend\nstub.open_folder = function(id: string)\n\tnote(`folder:{id}`)\nend\nstub.review = function(name: string)\n\tnote(`review:{name}`)\nend\n\n-- Installing and updating take a while, as from a link: each answers a\n-- promise the commands below settle (`settled_*`), so the page's busy\n-- dialog and row show meanwhile.\nlocal open_promise: any = nil\nlocal function later(): any\n\treturn {\n\t\tafter = function(_self: any, ok: (any) -> (), err: (any) -> ())\n\t\t\topen_promise = { ok = ok, err = err }\n\t\tend,\n\t}\nend\nlocal function settle(ok: boolean, value: any)\n\tlocal p = open_promise\n\topen_promise = nil\n\tif p then\n\t\tif ok then\n\t\t\tp.ok(value)\n\t\telse\n\t\t\tp.err(value)\n\t\tend\n\tend\nend\nstub.import = function(from: any)\n\tnote(`import:{if type(from) == \"table\" then (from.url or from.path or \"\") else tostring(from)}`)\n\treturn later()\nend\nstub.check_updates = function()\n\tnote(\"check\")\n\treturn nil\nend\nstub.update = function(id: string)\n\tnote(`update:{id}`)\n\treturn later()\nend\nui.command {\n\tid = \"installed_yours\",\n\ttitle = \"The install finishes: one of yours\",\n\trun = function()\n\t\ttable.insert(model, { id = \"dusk\", name = \"Dusk\", author = \"you\", version = \"1.0.0\", builtin = false, active = false, status = \"ok\" })\n\t\tpublish()\n\t\tsettle(true, { installed = \"dusk\", name = \"Dusk\" })\n\tend,\n}\nui.command {\n\tid = \"installed_theirs\",\n\ttitle = \"The install finishes: someone else's, waiting\",\n\trun = function()\n\t\ttable.insert(waiting, { pending = \"ledger-1700000001\", name = \"Ledger\", source = \"ledger.zeron-template\" })\n\t\tpublish()\n\t\tsettle(true, { pending = \"ledger-1700000001\", name = \"Ledger\", needs_consent = true })\n\tend,\n}\nui.command {\n\tid = \"install_failed\",\n\ttitle = \"The install fails\",\n\trun = function()\n\t\tsettle(false, { message = \"That repository has no release with a template in it\" })\n\tend,\n}\nui.command {\n\tid = \"update_found\",\n\ttitle = \"A newer Ledger is found where it came from\",\n\trun = function()\n\t\tlocal t: any = find(\"ledger\")\n\t\tt.update = { version = \"2.1.0\" }\n\t\tpublish()\n\tend,\n}\nui.command {\n\tid = \"update_refused\",\n\ttitle = \"A newer Ledger is found, signed by someone else\",\n\trun = function()\n\t\tlocal t: any = find(\"ledger\")\n\t\tt.update = { version = \"6.6.6\", refused = \"The new version is signed by someone else, so it won't be installed\" }\n\t\tpublish()\n\tend,\n}\nui.command {\n\tid = \"updated_ledger\",\n\ttitle = \"Ledger's update finishes\",\n\trun = function()\n\t\tlocal t: any = find(\"ledger\")\n\t\tt.version = \"2.1.0\"\n\t\tt.update = nil\n\t\tpublish()\n\t\tsettle(true, { updated = \"ledger\", name = \"Ledger\", version = \"2.1.0\", from = \"2.0.0\" })\n\tend,\n}\n\nui.command {\n\tid = \"made\",\n\ttitle = \"An agent makes a template\",\n\trun = function()\n\t\ttable.insert(model, { id = \"dusk\", name = \"Dusk\", author = \"you\", builtin = false, active = false, status = \"ok\" })\n\t\tpublish()\n\tend,\n}\nui.command {\n\tid = \"updated\",\n\ttitle = \"Keiki updates past Airy\",\n\trun = function()\n\t\tlocal t = find(\"airy\")\n\t\tt.status = \"out_of_date\"\n\t\tt.zeron_version = \"0.2.120\"\n\t\tpublish()\n\tend,\n}\nui.command {\n\tid = \"broke\",\n\ttitle = \"Airy's root stops running\",\n\trun = function()\n\t\tlocal t = find(\"airy\")\n\t\tt.status = \"broken\"\n\t\tt.error = \"app.luau:3: attempt to call a nil value\"\n\t\tpublish()\n\tend,\n}\n\nui.command {\n\tid = \"imported\",\n\ttitle = \"Ada's template is installed\",\n\trun = function()\n\t\ttable.insert(model, {\n\t\t\tid = \"ledger\",\n\t\t\tname = \"Ledger\",\n\t\t\tversion = \"2.0.0\",\n\t\t\tbuiltin = false,\n\t\t\tactive = false,\n\t\t\tstatus = \"ok\",\n\t\t\timported = { key = \"k-ada\", author = { kind = \"verified\", username = \"ada\" } },\n\t\t})\n\t\ttable.insert(model, {\n\t\t\tid = \"mystery\",\n\t\t\tname = \"Mystery\",\n\t\t\tbuiltin = false,\n\t\t\tactive = false,\n\t\t\tstatus = \"ok\",\n\t\t\timported = { key = \"k-who\", author = { kind = \"unknown\" }, source = { kind = \"release\", url = \"https://github.com/eve/mystery\" } },\n\t\t})\n\t\ttable.insert(model, {\n\t\t\tid = \"mine-again\",\n\t\t\tname = \"Mine again\",\n\t\t\tbuiltin = false,\n\t\t\tactive = false,\n\t\t\tstatus = \"ok\",\n\t\t\timported = { key = \"k-me\", author = { kind = \"you\" } },\n\t\t})\n\t\tpublish()\n\tend,\n}\nui.command {\n\tid = \"waiting\",\n\ttitle = \"Someone's template waits for you\",\n\trun = function()\n\t\ttable.insert(waiting, { pending = \"ledger-1700000000\", name = \"Ledger\", source = \"ledger.zeron-template\" })\n\t\tpublish()\n\tend,\n}\nui.command {\n\tid = \"answered\",\n\ttitle = \"The waiting template is answered\",\n\trun = function()\n\t\ttable.clear(waiting)\n\t\tpublish()\n\tend,\n}\n\npublish()\n\nui.command {\n\tid = \"palette\",\n\ttitle = \"Open the command palette\",\n\trun = function()\n\t\tview.palette:set(true)\n\tend,\n}\n\n-- The themes registered (the previews' among them), for the tests.\nlocal theme_names = ui.state(\"theme_names\", \"\")\nui.command { id = \"theme_names\", title = \"List the themes\", run = function() theme_names:set(table.concat(ui.theme.names(), \",\")) end }\n\n-- Light, for pictures of it (src/audit_shots.rs: `!theme_light`).\nui.command { id = \"theme_light\", title = \"Light theme\", run = function() ui.theme.follow_system(false); ui.theme.current:set(\"zeron-light\") end }\n\nreturn ui.div {\n\tw_full = true,\n\th_full = true,\n\tui.scroll {\n\t\tw_full = true,\n\t\th_full = true,\n\t\tui.column {\n\t\t\tw_full = true,\n\t\t\tpx = \"$space.6\",\n\t\t\tpt = \"$space.4\",\n\t\t\tpb = \"$space.8\",\n\t\t\titems = \"center\",\n\t\t\tpage.View(),\n\t\t},\n\t},\n\tPalette(),\n}\n",
		["apps/zgx/ui/tests/attached_chat_card.test.luau"] = "-- A chat attached in the composer (a session dropped from the sidebar, its\n-- card over the draft) is sent as an attachment: a card on the sent message\n-- with the chat's title and its agent's mark, as the composer showed it, not\n-- a mention in the words. Its link goes in a block after the words\n-- (screens/chat/carried.luau `with_chats`), which the engine reads out to the\n-- agent. A chat linked in the words themselves stays a chip in them.\n\nlocal function open(app: any)\n\tapp:resize(900, 700)\n\tapp:command(\"go_s2\")\n\tapp:frames(30)\nend\n\nlocal function send(app: any, words: string)\n\tapp:type('role:textbox \"Message\"', words)\n\tapp:key(\"Enter\")\n\tapp:frames(30)\nend\n\n-- How many times `text` shows in the transcript's tree.\nlocal function shown(app: any, text: string): number\n\tlocal _, n = string.gsub(app:tree(\"#transcript\"), text, \"\")\n\treturn n\nend\n\ntest(\"a chat attached in the composer is a card on the sent message, not a mention in its words\", function()\n\tlocal app = mount(\"chat_fixture.luau\")\n\topen(app)\n\tapp:command(\"mention_s1\")\n\tapp:frames(10)\n\tsend(app, \"Compare with\")\n\t-- What's sent: the words, then the chat in its block, for the agent.\n\tlocal calls = app:state(\"calls\")\n\texpect(calls).to_contain(\"send:s2:Compare with\\n\\nChats attached:\\n- [Long chat](zeron-chat:s1)\")\n\t-- The sent message: its words, and the chat as a card that opens it.\n\texpect(app:has('#transcript >> ~\"Compare with\"')).to_be(true)\n\texpect(app:has('#transcript >> role:button \"Long chat\"')).to_be(true)\n\t-- Its glyph on the card's tile (the agent's mark; the side chat's\n\t-- glyph for a chat whose agent this window doesn't know, as here).\n\texpect(app:tree('#transcript >> role:button \"Long chat\"')).to_contain(\"img\")\n\t-- Once: the card, no chip in the words.\n\texpect(shown(app, \"Long chat\")).to_be(1)\n\texpect(app:error()).to_be(nil)\nend)\n\ntest(\"a chat linked in the words stays a chip in them, with no card\", function()\n\tlocal app = mount(\"chat_fixture.luau\")\n\topen(app)\n\tsend(app, \"Compare with [Long chat](zeron-chat:s1) please\")\n\tlocal calls = app:state(\"calls\")\n\texpect(calls).to_contain(\"send:s2:Compare with [Long chat](zeron-chat:s1) please\")\n\texpect(string.find(calls, \"Chats attached:\", 1, true)).to_be(nil)\n\texpect(app:has('#transcript >> role:button \"Long chat\"')).to_be(false)\n\texpect(app:error()).to_be(nil)\nend)\n\n",
		["apps/zgx/ui/tests/browser_settings.test.luau"] = "-- Settings → Browser and what the browser tab does with it: the page's\n-- rows (Open links in moved here from General), history listed, filtered,\n-- one let go in place and cleared over a span, a search of your own, the\n-- home page refused when it isn't an address, sites' zooms reset; and on\n-- the tab, words typed search on the engine chosen, pages reached are kept\n-- as history for the account, each site's zoom goes on its page with its\n-- percentage in the field (which puts it back), the ⋯ menu's zoom and\n-- inspector, and a file the page can't show says so. Settings on the shell\n-- in ui/shell_fixture.luau (signed in as Ada: her profile is\n-- `zeron-ada@example.net`); the tab on the panel in ui/panel_fixture.luau, its page\n-- stood in for (signed out: `zeron-local`).\n\nlocal PAGE = \"#settings-page\"\nlocal NAV = \"#settings-nav\"\nlocal ADA = \"zeron-ada@example.net\"\n\nlocal function shows(app: any, scope: string, text: string): boolean\n\treturn app:tree(scope):find(text, 1, true) ~= nil\nend\n\n-- A node's identity by what it's called: `@id`.\nlocal function node(app: any, scope: string, label: string): string?\n\tfor line in app:tree(scope):gmatch(\"[^\\n]+\") do\n\t\tif line:find(`\"{label}\"`, 1, true) then\n\t\t\treturn line:match(\"@(%d+)\")\n\t\tend\n\tend\n\treturn nil\nend\n\n-- Settings, on one of the Browser heading's pages (\"Browsing\", \"History\").\nlocal function settings(page: string?): any\n\tlocal app = mount(\"shell_fixture.luau\")\n\tapp:resize(1200, 900)\n\tapp:frames(30)\n\tapp:command(\"settings_stub.sign_in\")\n\tapp:command(\"shell.settings\")\n\tapp:frames(20)\n\tapp:click(`{NAV} >> role:tab \"{page or \"Browsing\"}\"`)\n\tapp:frames(30)\n\treturn app\nend\n\nlocal function seed(app: any)\n\tlocal now = os.time()\n\tapp:set_state(\"browser_history\", {\n\t\t[ADA] = {\n\t\t\t{ url = \"https://react.dev/learn\", title = \"Quick Start – React\", at = now - 60, count = 2 },\n\t\t\t{ url = \"https://zeron.sh/\", title = \"Keiki\", at = now - 1800, count = 1 },\n\t\t\t{ url = \"https://example.com/\", title = \"Example Domain\", at = now - 3 * 86400, count = 1 },\n\t\t},\n\t})\n\tapp:frames(20)\nend\n\ntest(\"Browser settings: a heading of its own, Browsing and History, and General no longer has Open links in\", function()\n\tlocal app = settings()\n\texpect(app:has(`{NAV} >> \"Browser\"`)).to_be(true)\n\texpect(app:has(`{NAV} >> role:tab \"History\"`)).to_be(true)\n\texpect(app:state(\"shell_route_path\")).to_be(\"/settings/browser\")\n\tfor _, label in { \"Links and search\", \"Open links in\", \"Search engine\", \"Zoom\", \"Page zoom\", \"Developer\", \"Allow inspecting pages\" } do\n\t\texpect(shows(app, PAGE, label)).to_be(true)\n\tend\n\texpect(shows(app, PAGE, \"Keep history\")).to_be(false)\n\t-- (No home page: a new tab is the start page.)\n\texpect(shows(app, PAGE, \"New tab opens\")).to_be(false)\n\tapp:click(`{NAV} >> role:tab \"History\"`)\n\tapp:frames(30)\n\texpect(app:state(\"shell_route_path\")).to_be(\"/settings/browser_history\")\n\tfor _, label in { \"Keep history\", \"Clear history\", \"No history yet\" } do\n\t\texpect(shows(app, PAGE, label)).to_be(true)\n\tend\n\t-- Nothing kept yet: no filter, the count says so, the list says what goes there.\n\texpect(shows(app, PAGE, \"Nothing kept yet.\")).to_be(true)\n\texpect(shows(app, PAGE, \"Pages you visit in the browser show here.\")).to_be(true)\n\texpect(app:has(`{PAGE} >> role:textbox \"Search history\"`)).to_be(false)\n\tapp:click(`{NAV} >> role:tab \"General\"`)\n\tapp:frames(20)\n\texpect(shows(app, PAGE, \"Open links in\")).to_be(false)\n\t-- (Where a pull request opens is the GitHub plugin's setting.)\n\texpect(shows(app, PAGE, \"Open pull requests in\")).to_be(false)\nend)\n\ntest(\"Browser settings: history lists, filters, and lets one page go in place\", function()\n\tlocal app = settings(\"History\")\n\tseed(app)\n\texpect(app:wait(`{PAGE} >> \"Quick Start – React\"`, { timeout_ms = 5000 })).to_be(true)\n\texpect(shows(app, PAGE, \"Keiki\")).to_be(true)\n\texpect(shows(app, PAGE, \"Example Domain\")).to_be(true)\n\texpect(shows(app, PAGE, \"3 pages kept.\")).to_be(true)\n\t-- Laid out by day, the latest first, each with the time it was visited.\n\texpect(shows(app, PAGE, \"Today\")).to_be(true)\n\texpect(shows(app, PAGE, \" AM\\\"\") or shows(app, PAGE, \" PM\\\"\")).to_be(true)\n\t-- The filter: by address or title.\n\tapp:type(`{PAGE} >> role:textbox \"Search history\"`, \"react\")\n\tapp:frames(20)\n\texpect(shows(app, PAGE, \"Quick Start – React\")).to_be(true)\n\texpect(shows(app, PAGE, \"Example Domain\")).to_be(false)\n\tapp:type(`{PAGE} >> role:textbox \"Search history\"`, \"nothing-like-it\")\n\tapp:frames(20)\n\texpect(shows(app, PAGE, \"No pages match.\")).to_be(true)\n\tapp:set_state(\"settings_browser_history_query\", \"\")\n\tapp:frames(20)\n\t-- One let go: the others stay the same rows.\n\tlocal zeron = node(app, PAGE, \"Keiki\")\n\texpect(zeron).never.to_be_nil()\n\t-- (Its × shows as the row is pointed at, in its time's place.)\n\tlocal remove = `{PAGE} >> role:button \"Remove Example Domain from history\"`\n\texpect(app:tree(remove)).to_contain(\"hidden\")\n\tapp:hover(`{PAGE} >> \"Example Domain\"`)\n\tapp:frames(5)\n\texpect(app:tree(remove)).never.to_contain(\"hidden\")\n\tapp:click(remove)\n\tapp:frames(20)\n\texpect(shows(app, PAGE, \"Example Domain\")).to_be(false)\n\texpect(node(app, PAGE, \"Keiki\")).to_be(zeron)\n\tlocal kept = (app:state(\"browser_history\") :: any)[ADA]\n\texpect(#kept).to_be(2)\nend)\n\ntest(\"Browser settings: Clear history clears the span chosen, then all of it\", function()\n\tlocal app = settings(\"History\")\n\tseed(app)\n\t-- The last hour: the two recent go, the one three days back stays.\n\tapp:set_state(\"settings_browser_span\", \"hour\")\n\tapp:frames(10)\n\tapp:click(\"#settings-browser-clear\")\n\tapp:frames(20)\n\tlocal kept = (app:state(\"browser_history\") :: any)[ADA]\n\texpect(#kept).to_be(1)\n\texpect(kept[1].url).to_be(\"https://example.com/\")\n\texpect(shows(app, PAGE, \"1 page kept.\")).to_be(true)\n\tapp:set_state(\"settings_browser_span\", \"all\")\n\tapp:frames(10)\n\tapp:click(\"#settings-browser-clear\")\n\tapp:frames(20)\n\texpect((app:state(\"browser_history\") :: any)[ADA]).to_be_nil()\n\texpect(shows(app, PAGE, \"Nothing kept yet.\")).to_be(true)\nend)\n\ntest(\"Browser settings: a search of your own, checked for where its words go\", function()\n\tlocal app = settings()\n\texpect(app:has(\"#settings-browser-custom-engine\")).to_be(false)\n\tapp:set_state(\"browser_search_engine\", \"custom\")\n\tapp:frames(20)\n\texpect(app:has(\"#settings-browser-custom-engine\")).to_be(true)\n\tapp:type(\"#settings-browser-custom-engine\", \"https://search.example/%s\")\n\tapp:key(\"Enter\")\n\tapp:frames(10)\n\t-- (%s in the path is fine; one in the host is not.)\n\texpect(app:state(\"browser_custom_search\")).to_be(\"https://search.example/%s\")\n\tapp:set_state(\"browser_custom_search\", \"https://%s.example/\")\n\tapp:frames(10)\n\t-- (The tree cuts a long line short: its start.)\n\texpect(shows(app, PAGE, \"Use a web address with %s after the site\")).to_be(true)\nend)\n\ntest(\"Browser settings: sites with their own zoom, reset\", function()\n\tlocal app = settings()\n\texpect(app:has(\"#settings-browser-reset-zoom\")).to_be(false)\n\tapp:set_state(\"browser_site_zoom\", { [\"example.com\"] = 1.25, [\"zeron.sh\"] = 0.9 })\n\tapp:frames(20)\n\texpect(shows(app, PAGE, \"2 sites with their own zoom\")).to_be(true)\n\texpect(shows(app, PAGE, \"125%\")).to_be(true)\n\t-- One back to the default, in place; then all of them.\n\tapp:click(`{PAGE} >> role:button \"Reset zoom for zeron.sh\"`)\n\tapp:frames(20)\n\texpect(shows(app, PAGE, \"1 site with its own zoom\")).to_be(true)\n\texpect((app:state(\"browser_site_zoom\") :: any)[\"zeron.sh\"]).to_be_nil()\n\tapp:click(\"#settings-browser-reset-zoom\")\n\tapp:frames(20)\n\texpect(app:has(\"#settings-browser-reset-zoom\")).to_be(false)\nend)\n\n-- The tab ------------------------------------------------------------------\n\nlocal FIELD_ROLE = 'role:combobox \"Address\"'\n\nlocal function panel(): any\n\tlocal app = mount(\"panel_fixture.luau\")\n\tapp:resize(900, 640)\n\tapp:frames(10)\n\texpect(app:error()).to_be_nil()\n\texpect(app:wait(\"#panel-empty\", { timeout_ms = 15000 })).to_be(true)\n\tapp:click(\"#panel-open-browser\")\n\texpect(app:wait('role:combobox \"Address\"', { timeout_ms = 15000 })).to_be(true)\n\treturn app\nend\n\nlocal function eventually(app: any, ok: () -> boolean, ms: number?): boolean\n\tfor _ = 1, math.ceil((ms or 5000) / 50) do\n\t\tif ok() then\n\t\t\treturn true\n\t\tend\n\t\tapp:wait('\"never shown, only waited past\"', { timeout_ms = 50 })\n\tend\n\treturn ok()\nend\n\n-- An address typed and taken; once the page answers, the field shows its\n-- address (so the next typed replaces it), and the page's title has come.\nlocal function go(app: any, text: string, lands: string?)\n\t-- (What the field holds, replaced: it selects all as it takes the keyboard.)\n\tapp:click(\"#outside\")\n\tapp:frames(2)\n\tapp:type('role:combobox \"Address\"', text)\n\tapp:key(\"Enter\")\n\tapp:frames(10)\n\tif lands then\n\t\texpect(eventually(app, function(): boolean\n\t\t\t-- (The tree cuts a long value short: its start.)\n\t\t\treturn app:tree('role:combobox \"Address\"'):find(`=\"{string.sub(lands, 1, 36)}`, 1, true) ~= nil\n\t\tend)).to_be(true)\n\t\tapp:frames(5)\n\tend\nend\n\nlocal function history(app: any): { any }?\n\tlocal all = app:state(\"browser_history\") :: any\n\treturn if all then all[\"zeron-local\"] else nil\nend\n\nlocal function calls(app: any): string\n\treturn app:state(\"test_web_calls\") or \"\"\nend\n\ntest(\"browser tab: words search on the engine chosen; an address loads\", function()\n\tlocal app = panel()\n\tgo(app, \"react hooks\", \"https://www.google.com/search?q=react+hooks\")\n\tapp:set_state(\"browser_search_engine\", \"duckduckgo\")\n\tgo(app, \"zeron\", \"https://duckduckgo.com/?q=zeron\")\n\tgo(app, \"example.com\", \"https://example.com/\")\n\tgo(app, \"localhost:3000\", \"http://localhost:3000/\")\n\t-- (A path stays refused: there's no search a file should become.)\n\tgo(app, \"/etc/hosts\")\n\texpect(calls(app)).never.to_contain(\"hosts\")\n\texpect(calls(app)).never.to_contain(\"zoom\")\nend)\n\ntest(\"browser tab: pages reached are kept as the account's history, with their titles\", function()\n\tlocal app = panel()\n\tgo(app, \"example.com\", \"https://example.com/\")\n\texpect(eventually(app, function(): boolean\n\t\tlocal h = history(app)\n\t\treturn h ~= nil and h[1].title == \"Page at example.com\"\n\tend)).to_be(true)\n\texpect((history(app) :: any)[1].url).to_be(\"https://example.com/\")\n\tgo(app, \"zeron.sh\", \"https://zeron.sh/\")\n\texpect(eventually(app, function(): boolean\n\t\tlocal h = history(app)\n\t\treturn h ~= nil and h[1].url == \"https://zeron.sh/\"\n\tend)).to_be(true)\n\texpect((history(app) :: any)[2].url).to_be(\"https://example.com/\")\n\t-- Off, nothing more is kept.\n\tapp:set_state(\"browser_keep_history\", false)\n\tgo(app, \"react.dev\", \"https://react.dev/\")\n\tapp:wait('\"never shown, only waited past\"', { timeout_ms = 300 })\n\texpect((history(app) :: any)[1].url).to_be(\"https://zeron.sh/\")\nend)\n\ntest(\"browser tab: a site's zoom goes on its page, its percentage in the field puts it back\", function()\n\tlocal app = panel()\n\tapp:set_state(\"browser_site_zoom\", { [\"example.com\"] = 1.25 })\n\tgo(app, \"example.com\", \"https://example.com/\")\n\texpect(eventually(app, function(): boolean\n\t\treturn string.find(calls(app), \"zoom:125\", 1, true) ~= nil\n\tend)).to_be(true)\n\tlocal id = app:state(\"test_web_last_id\")\n\tlocal pill = `#panel-browser-zoom-{string.gsub(id, \"^panel%-browser%-\", \"\")}`\n\texpect(app:has(pill)).to_be(true)\n\texpect(app:tree(pill)).to_contain(\"125%\")\n\tapp:click(pill)\n\tapp:frames(10)\n\texpect(calls(app)).to_contain(\"zoom:100\")\n\texpect(app:has(pill)).to_be(false)\n\texpect((app:state(\"browser_site_zoom\") :: any)[\"example.com\"]).to_be_nil()\n\t-- ⌘+ is the page's while it has the keyboard, and kept for the site.\n\tapp:set_state(`test_web_focused_{id}`, true)\n\tapp:command(\"panel.zoom_in\")\n\tapp:frames(10)\n\texpect((app:state(\"browser_site_zoom\") :: any)[\"example.com\"]).to_be(1.1)\n\tapp:command(\"panel.zoom_reset\")\n\tapp:frames(10)\n\texpect((app:state(\"browser_site_zoom\") :: any)[\"example.com\"]).to_be_nil()\n\t-- Not while the keyboard is elsewhere.\n\tapp:set_state(`test_web_focused_{id}`, false)\n\tapp:command(\"panel.zoom_in\")\n\tapp:frames(10)\n\texpect((app:state(\"browser_site_zoom\") :: any)[\"example.com\"]).to_be_nil()\nend)\n\ntest(\"browser tab: the ⋯ menu opens the inspector and zooms\", function()\n\tlocal app = panel()\n\tgo(app, \"example.com\", \"https://example.com/\")\n\tapp:click('role:button \"More\"')\n\texpect(app:wait('role:menuitem \"Inspect Page\"', { timeout_ms = 3000 })).to_be(true)\n\t-- (A menu takes no pick in its first moments: time passes.)\n\tapp:wait('\"nothing\"', { timeout_ms = 400 })\n\tapp:click('role:menuitem \"Inspect Page\"')\n\t-- (It blinks, the menu closes, then it runs: real time.)\n\texpect(eventually(app, function(): boolean\n\t\treturn string.find(calls(app), \"devtools\", 1, true) ~= nil\n\tend, 3000)).to_be(true)\n\tapp:wait('\"nothing\"', { timeout_ms = 300 })\n\t-- Inspecting off: no such item. Zoom keeps the menu open.\n\tapp:set_state(\"browser_inspectable\", false)\n\tapp:click('role:button \"More\"')\n\texpect(app:wait('role:menuitem \"Zoom In\"', { timeout_ms = 3000 })).to_be(true)\n\texpect(app:has('role:menuitem \"Inspect Page\"')).to_be(false)\n\tapp:wait('\"nothing\"', { timeout_ms = 400 })\n\tapp:click('role:menuitem \"Zoom In\"')\n\tapp:frames(10)\n\texpect((app:state(\"browser_site_zoom\") :: any)[\"example.com\"]).to_be(1.1)\n\texpect(app:has('role:menuitem \"Zoom In\"')).to_be(true)\n\t-- Open in the default browser is the menu's (not a button on the bar).\n\tapp:click('role:menuitem \"Open in Browser\"')\n\texpect(eventually(app, function(): boolean\n\t\treturn string.find(calls(app), \"external:https://example.com/\", 1, true) ~= nil\n\tend, 3000)).to_be(true)\nend)\n\ntest(\"browser tab: the bar is back, forward, reload, the address, then the page's controls\", function()\n\tlocal app = panel()\n\tgo(app, \"example.com\", \"https://example.com/\")\n\tlocal function x(target: string): number\n\t\treturn tonumber(app:tree(target):match(\" (%d+),%d+ %d+x%d+\")) or -1\n\tend\n\tlocal fwd, reload, field = x('role:button \"Forward\"'), x('role:button \"Reload\"'), x(FIELD_ROLE)\n\texpect(fwd < reload and reload < field).to_be(true)\n\texpect(app:has('#panel-browser-bar-tab1 >> role:button \"Open in Browser\"')).to_be(false)\nend)\n\ntest(\"browser tab: a file the page can't show says so, and opens in the default browser\", function()\n\tlocal app = panel()\n\tgo(app, \"example.com/archive.zip\", \"https://example.com/archive.zip\")\n\tlocal id = app:state(\"test_web_last_id\")\n\tapp:set_state(`test_web_error_{id}`, \"Frame load interrupted\")\n\tapp:frames(20)\n\texpect(app:wait(\"\\\"This file can’t be shown here\\\"\", { timeout_ms = 3000 })).to_be(true)\n\tapp:click('role:button \"Open in Browser\"')\n\tapp:frames(10)\n\texpect(calls(app)).to_contain(\"external:https://example.com/archive.zip\")\nend)\n\n-- Suggestions ----------------------------------------------------------------\n\nlocal FIELD = 'role:combobox \"Address\"'\n\nlocal function seeded(): any\n\tlocal app = panel()\n\tlocal now = os.time()\n\tapp:set_state(\"browser_history\", {\n\t\t[\"zeron-local\"] = {\n\t\t\t{ url = \"https://react.dev/reference/react/useEffect\", title = \"useEffect – React\", at = now - 60, count = 3 },\n\t\t\t{ url = \"https://react.dev/\", title = \"React\", at = now - 3600, count = 6 },\n\t\t\t{ url = \"https://github.com/zeronsh/zeron/pull/1187\", title = \"Browser settings · Pull Request #1187\", at = now - 600, count = 2 },\n\t\t\t{ url = \"https://developer.apple.com/documentation/webkit\", title = \"WebKit | Apple Developer\", at = now - 86400 * 3, count = 1 },\n\t\t},\n\t})\n\tapp:frames(5)\n\treturn app\nend\n\n-- The rows the list shows, in order, by what each is called.\nlocal function rows(app: any): { string }\n\tlocal out = {}\n\tfor name in app:tree():gmatch('option \"([^\"]+)\"') do\n\t\ttable.insert(out, name)\n\tend\n\treturn out\nend\n\nlocal function field(app: any): string\n\treturn app:text(FIELD) or \"\"\nend\n\n-- Typed into the field (what it held replaced: it selects all as it takes\n-- the keyboard). The test host inserts text, not key by key, so Backspace's\n-- own editing is checked in a real window (zgx inspect), not here.\nlocal function keys(app: any, text: string)\n\tapp:click(\"#outside\")\n\tapp:type(FIELD, text)\n\tapp:frames(8)\nend\n\ntest(\"suggestions: the field finishes the site you visit, the list under it ranked\", function()\n\tlocal app = seeded()\n\t-- Taking the keyboard opens nothing.\n\tapp:click(\"#outside\")\n\tapp:click(FIELD)\n\tapp:frames(10)\n\texpect(#rows(app)).to_be(0)\n\tkeys(app, \"rea\")\n\t-- The site finished in the field, the rest selected (typing on replaces it).\n\texpect(field(app)).to_be(\"react.dev\")\n\tlocal list = rows(app)\n\texpect(list[1]).to_be(\"react.dev\")\n\t-- Then the pages, the ones whose address starts with it first.\n\texpect(list[2]).to_be(\"useEffect – React\")\n\texpect(table.find(list, \"WebKit | Apple Developer\")).to_be_nil()\n\t-- Enter: the site.\n\tapp:key(\"Enter\")\n\tapp:frames(10)\n\texpect(calls(app)).to_contain(\"load:https://react.dev/\")\n\texpect(#rows(app)).to_be(0)\nend)\n\ntest(\"suggestions: ↓ fills the field with the row lit; Escape puts back what was typed and closes\", function()\n\tlocal app = seeded()\n\tkeys(app, \"git\")\n\texpect(field(app)).to_be(\"github.com\")\n\texpect(rows(app)[2]).to_be(\"Browser settings · Pull Request #1187\")\n\tapp:key(\"ArrowDown\")\n\tapp:frames(5)\n\texpect(field(app)).to_be(\"github.com/zeronsh/zeron/pull/1187\")\n\t-- ↑ back to the first: the site finished again.\n\tapp:key(\"ArrowUp\")\n\tapp:frames(5)\n\texpect(field(app)).to_be(\"github.com\")\n\tapp:key(\"Escape\")\n\tapp:frames(5)\n\texpect(field(app)).to_be(\"git\")\n\texpect(#rows(app)).to_be(0)\n\t-- Escape again: the field's own, the page's address back.\n\tapp:key(\"Escape\")\n\tapp:frames(5)\n\texpect(field(app)).to_be(\"\")\nend)\n\ntest(\"suggestions: words search first, a page below them goes with ↓ and Enter\", function()\n\tlocal app = seeded()\n\tkeys(app, \"apple webkit\")\n\tlocal list = rows(app)\n\texpect(list[1]).to_be(\"apple webkit\")\n\texpect(list[2]).to_be(\"WebKit | Apple Developer\")\n\texpect(app:tree()).to_contain(\"Search Google\")\n\tapp:key(\"ArrowDown\")\n\tapp:frames(5)\n\tapp:key(\"Enter\")\n\tapp:frames(10)\n\texpect(calls(app)).to_contain(\"load:https://developer.apple.com/documentation/webkit\")\nend)\n\ntest(\"suggestions: Shift-Backspace lets the lit page out of history\", function()\n\tlocal app = seeded()\n\tkeys(app, \"zeronsh\")\n\texpect(rows(app)[2]).to_be(\"Browser settings · Pull Request #1187\")\n\tapp:key(\"ArrowDown\")\n\tapp:frames(5)\n\tapp:key(\"shift+Backspace\")\n\tapp:frames(10)\n\texpect(table.find(rows(app), \"Browser settings · Pull Request #1187\")).to_be_nil()\n\tlocal kept = (app:state(\"browser_history\") :: any)[\"zeron-local\"]\n\tfor _, v in kept do\n\t\texpect(v.url).never.to_be(\"https://github.com/zeronsh/zeron/pull/1187\")\n\tend\nend)\n\ntest(\"suggestions: letters inside a word don't match; a word's start does\", function()\n\tlocal app = seeded()\n\tkeys(app, \"elop\")\n\texpect(table.find(rows(app), \"WebKit | Apple Developer\")).to_be_nil()\n\tkeys(app, \"dev\")\n\texpect(table.find(rows(app), \"WebKit | Apple Developer\")).never.to_be_nil()\nend)\n",
		["apps/zgx/ui/tests/chat_draft_lift.test.luau"] = "-- A plugin allowed \"draft\" takes the composer's draft whole and puts it back\n-- (`zeron.take_draft`, `put_draft`, `swap_draft`: screens/plugins keeps it\n-- between, through screens/chat/shared's `lift` and `lay`). Taken, the\n-- composer is clear; put back in another chat, its words and its chips are\n-- as they were and go with the message; put back over words already there,\n-- they follow those.\n\nlocal function open(app: any, chat: string)\n\tapp:command(`go_{chat}`)\n\tapp:frames(30)\nend\n\ntest(\"a draft taken in one chat is put back in another whole, chips and all\", function()\n\tlocal app = mount(\"chat_fixture.luau\")\n\tapp:resize(900, 700)\n\topen(app, \"s2\")\n\tapp:type('role:textbox \"Message\"', \"Wrong chat prompt\")\n\tapp:command(\"mention_s1\")\n\tapp:frames(10)\n\tapp:command(\"draft_lift\")\n\tapp:frames(10)\n\texpect(app:state(\"test_lifted\")).to_be(\"Wrong chat prompt|1\")\n\t-- Taken: nothing left on this chat's draft.\n\texpect(app:has('#chat-composer >> role:button \"Long chat\"')).to_be(false)\n\texpect(app:has('#chat-composer >> ~\"Wrong chat prompt\"')).to_be(false)\n\t-- Put back in another chat, and sent from there.\n\topen(app, \"s3\")\n\tapp:command(\"draft_lay\")\n\tapp:frames(30)\n\texpect(app:has('#chat-composer >> ~\"Wrong chat prompt\"')).to_be(true)\n\tapp:key(\"Enter\")\n\tapp:frames(30)\n\texpect(app:state(\"calls\")).to_contain(\"send:s3:Wrong chat prompt\\n\\nChats attached:\\n- [Long chat](zeron-chat:s1)\")\n\texpect(app:error()).to_be(nil)\nend)\n\ntest(\"an empty draft isn't taken\", function()\n\tlocal app = mount(\"chat_fixture.luau\")\n\tapp:resize(900, 700)\n\topen(app, \"s2\")\n\tapp:command(\"draft_lift\")\n\tapp:frames(10)\n\texpect(app:state(\"test_lifted\")).to_be(\"nothing\")\nend)\n\ntest(\"a draft put back over words already there follows them\", function()\n\tlocal app = mount(\"chat_fixture.luau\")\n\tapp:resize(900, 700)\n\topen(app, \"s2\")\n\tapp:type('role:textbox \"Message\"', \"Second\")\n\tapp:command(\"draft_lift\")\n\tapp:frames(10)\n\tapp:type('role:textbox \"Message\"', \"First\")\n\tapp:command(\"draft_lay\")\n\tapp:frames(30)\n\tapp:key(\"Enter\")\n\tapp:frames(30)\n\texpect(app:state(\"calls\")).to_contain(\"send:s2:First\\n\\nSecond\")\n\texpect(app:error()).to_be(nil)\nend)\n",
		["apps/zgx/ui/tests/chat_links.test.luau"] = "-- A transcript's file links, read as Zeron reads them (crates/ui\n-- workspace_links.rs, its tests' cases): screens/chat/file_links `resolve`.\n\nlocal links = require(\"../screens/chat/file_links\")\nlocal ROOT = \"/work/comet\"\n\nlocal function at(target: string): string?\n\tlocal r = links.resolve(target, ROOT)\n\tif not r then\n\t\treturn nil\n\tend\n\treturn `{r.path}|{r.line or \"-\"}|{r.column or \"-\"}|{if r.outside then \"outside\" else \"in\"}`\nend\n\ntest(\"relative, absolute and file:// links resolve inside the project, with their line\", function()\n\texpect(at(\"crates/ui/src/lib.rs\")).to_be(\"crates/ui/src/lib.rs|-|-|in\")\n\texpect(at(\"/work/comet/crates/ui/src/lib.rs:42:7\")).to_be(\"crates/ui/src/lib.rs|42|7|in\")\n\texpect(at(\"file:///work/comet/README.md#L12\")).to_be(\"README.md|12|-|in\")\n\texpect(at(\"zeron-file:src/a%20file%23%5Bx%5D.rs\")).to_be(\"src/a file#[x].rs|-|-|in\")\nend)\n\ntest(\"paths decode once; unsafe decodes never resolve\", function()\n\texpect(at(\"2026-09-26/Some%20Folder/it's%20here.txt\")).to_be(\"2026-09-26/Some Folder/it's here.txt|-|-|in\")\n\texpect(at(\"file:///work/comet/a%20b.md\")).to_be(\"a b.md|-|-|in\")\n\texpect(at(\"docs%2Fnote.md\")).to_be(\"docs/note.md|-|-|in\")\n\texpect(at(\"/tmp/Some%20Folder/it's%20here.txt\")).to_be(\"/tmp/Some Folder/it's here.txt|-|-|outside\")\n\texpect(at(\"a%zz.md\")).to_be(\"a%zz.md|-|-|in\")\n\texpect(at(\"a%2.md\")).to_be(\"a%2.md|-|-|in\")\n\texpect(at(\"%2E%2E/secret.md\")).to_be(nil)\n\texpect(at(\"a%5Cb.md\")).to_be(nil)\n\texpect(at(\"a%00b.md\")).to_be(nil)\nend)\n\ntest(\"every line form opens at its first line; zero and backwards aren't links\", function()\n\tfor target, want in\n\t\t{\n\t\t\t[\"src/lib.rs#L12\"] = \"12|-\",\n\t\t\t[\"src/lib.rs#L12C5\"] = \"12|5\",\n\t\t\t[\"src/lib.rs#L12-L20\"] = \"12|-\",\n\t\t\t[\"src/lib.rs#L12-20\"] = \"12|-\",\n\t\t\t[\"src/lib.rs#L12C1-L20C3\"] = \"12|1\",\n\t\t\t[\"src/lib.rs:12\"] = \"12|-\",\n\t\t\t[\"src/lib.rs:12:5\"] = \"12|5\",\n\t\t\t[\"src/lib.rs:12-20\"] = \"12|-\",\n\t\t}\n\tdo\n\t\texpect(at(target)).to_be(`src/lib.rs|{want}|in`)\n\tend\n\tfor _, target in\n\t\t{\n\t\t\t\"src/lib.rs:0\",\n\t\t\t\"src/lib.rs:0:5\",\n\t\t\t\"src/lib.rs:12:0\",\n\t\t\t\"src/lib.rs:0-4\",\n\t\t\t\"src/lib.rs:4-0\",\n\t\t\t\"src/lib.rs:20-10\",\n\t\t\t\"src/lib.rs#L0\",\n\t\t\t\"src/lib.rs#L0-L3\",\n\t\t\t\"src/lib.rs#L20-L10\",\n\t\t\t\"src/lib.rs#L5-3\",\n\t\t\t\"src/lib.rs#L5-L3\",\n\t\t}\n\tdo\n\t\texpect(at(target)).to_be(nil)\n\tend\nend)\n\ntest(\"a range keeps its last line, for the file to select\", function()\n\texpect((links.resolve(\"src/lib.rs:10-12\", ROOT) :: any).end_line).to_be(12)\n\texpect((links.resolve(\"src/lib.rs#L10-L12\", ROOT) :: any).end_line).to_be(12)\n\texpect((links.resolve(\"src/lib.rs#L10C2-L14C1\", ROOT) :: any).end_line).to_be(14)\n\texpect((links.resolve(\"src/lib.rs:10\", ROOT) :: any).end_line).to_be(nil)\n\texpect((links.resolve(\"src/lib.rs:10-10\", ROOT) :: any).end_line).to_be(nil)\nend)\n\ntest(\"a fragment that isn't a line drops away; a # inside the path stays\", function()\n\texpect(at(\"docs/readme.md#install\")).to_be(\"docs/readme.md|-|-|in\")\n\texpect(at(\"docs/readme.md#\")).to_be(\"docs/readme.md|-|-|in\")\n\texpect(at(\"docs/a.md#v1.2\")).to_be(\"docs/a.md|-|-|in\")\n\texpect(at(\"docs/we#ird/file.md\")).to_be(\"docs/we#ird/file.md|-|-|in\")\nend)\n\ntest(\"only file-shaped paths are links\", function()\n\tfor _, target in\n\t\t{\n\t\t\t\"~/notes.md\",\n\t\t\t\"#section\",\n\t\t\t\"?query.md\",\n\t\t\t\"src/Makefile\",\n\t\t\t\"Makefile\",\n\t\t\t\"a:b/file.md\",\n\t\t\t\"C:\\\\dir\\\\file.md\",\n\t\t\t\"C:/dir/file.md\",\n\t\t\t\"https://example.com/file.rs\",\n\t\t\t\"mailto:dev@example.com\",\n\t\t\t\"../secret.rs\",\n\t\t\t\"src/../../secret.rs\",\n\t\t\t\"src/./lib.rs\",\n\t\t\t\"src//lib.rs\",\n\t\t\t\"docs.v2/readme\",\n\t\t\t\"//work/comet/a.rs\",\n\t\t\t\"/usr/bin/ls\",\n\t\t\t\"file://localhost/work/comet/a.rs\",\n\t\t}\n\tdo\n\t\texpect(at(target)).to_be(nil)\n\tend\n\texpect(at(\"/work/comet-other/src/lib.rs\")).to_be(\"/work/comet-other/src/lib.rs|-|-|outside\")\n\texpect(at(\".env\")).to_be(\".env|-|-|in\")\n\texpect(at(\"docs/.env\")).to_be(\"docs/.env|-|-|in\")\nend)\n\ntest(\"a reply's file links and a prompt's mention open in the session's panel\", function()\n\tlocal app = mount(\"chat_fixture.luau\")\n\tapp:resize(900, 700)\n\tapp:command(\"go_s2\")\n\tapp:frames(30)\n\tapp:command(\"link_turn\")\n\tapp:frames(30)\n\tapp:click('role:link \"the parser\"')\n\tapp:click('role:link \"the host\"')\n\tapp:click('role:link ~\"chat.rs\"')\n\t-- Outside the chat's folder: styled, opening nothing.\n\tapp:click('role:link \"this one\"')\n\tapp:frames(5)\n\tlocal calls = app:state(\"calls\")\n\texpect(calls).to_contain(\"open_file:s2:src/parse.rs\")\n\texpect(calls).to_contain(\"open_file:s2:src/main.rs\")\n\texpect(calls).to_contain(\"open_file:s2:src/chat.rs\")\n\texpect(calls).never.to_contain(\"hosts.conf\")\n\t-- A web address written bare (here in bold) is a link too, the full\n\t-- stop after it left out.\n\texpect(app:has('role:link \"https://github.com/zeronsh/example/pull/1\"')).to_be(true)\n\texpect(app:has('role:link \"https://github.com/zeronsh/example/pull/1.\"')).to_be(false)\n\t-- A chat mentioned opens that chat.\n\tlocal _, before = string.gsub(app:state(\"calls\"), \"open:s1\", \"\")\n\tapp:click('role:link ~\"Long chat\"')\n\tapp:frames(20)\n\tlocal _, after = string.gsub(app:state(\"calls\"), \"open:s1\", \"\")\n\texpect(after).to_be(before + 1)\n\texpect(app:error()).to_be(nil)\nend)\n",
		["apps/zgx/ui/tests/chat_tasks.test.luau"] = "-- A chat's background processes, as Zeron's tray has them\n-- (background_tray.rs): Stop asks the chat's host to stop one, and says so\n-- if it couldn't.\n\ntest(\"Stop on a background process asks its host, and says when it couldn't\", function()\n\tlocal app = mount(\"chat_fixture.luau\")\n\tapp:resize(900, 700)\n\tapp:command(\"go_s2\")\n\tapp:frames(30)\n\tapp:command(\"task_running\")\n\tapp:frames(30)\n\t-- The tray stays folded to its header until opened.\n\texpect(app:has('role:button \"Open Running\"')).to_be(true)\n\texpect(app:has('role:tab \"Fold Running\"')).to_be(false)\n\tapp:click('role:button \"Open Running\"')\n\tapp:frames(30)\n\tapp:click('role:button \"Stop npm run dev\"')\n\tapp:frames(10)\n\texpect(app:state(\"calls\")).to_contain(\"stop_task:s2:bg1\")\n\texpect(app:has('~\"Couldn\\'t stop that process\"')).to_be(false)\n\tapp:command(\"stop_fails\")\n\tapp:click('role:button \"Stop npm run dev\"')\n\tapp:frames(10)\n\t-- Said as an alert of the composer's deck, a tab beside Running.\n\texpect(app:has('role:tab \"Open Alerts\"')).to_be(true)\n\tapp:click('role:tab \"Open Alerts\"')\n\tapp:frames(30)\n\texpect(app:has('~\"Couldn\\'t stop that process\"')).to_be(true)\n\texpect(app:error()).to_be(nil)\nend)\n\ntest(\"a background process outlives the turn: its tray stays as the turn ends\", function()\n\tlocal app = mount(\"chat_fixture.luau\")\n\tapp:resize(900, 700)\n\tapp:command(\"go_s2\")\n\tapp:frames(30)\n\tapp:command(\"start_reply\")\n\tapp:command(\"task_running\")\n\tapp:frames(30)\n\texpect(app:has('role:button \"Open Running\"')).to_be(true)\n\tapp:command(\"end_reply\")\n\t-- Through the turn's end, every frame: the tray is there.\n\tfor _ = 1, 30 do\n\t\tapp:frames(1)\n\t\texpect(app:has('role:button \"Open Running\"')).to_be(true)\n\tend\n\t-- And still stoppable.\n\tapp:click('role:button \"Open Running\"')\n\tapp:frames(30)\n\tapp:click('role:button \"Stop npm run dev\"')\n\tapp:frames(10)\n\texpect(app:state(\"calls\")).to_contain(\"stop_task:s2:bg1\")\n\texpect(app:error()).to_be(nil)\nend)\n\ntest(\"a chat's subagents run in the Running tray, and a row opens its subagent\", function()\n\tlocal app = mount(\"chat_fixture.luau\")\n\tapp:resize(900, 700)\n\tapp:command(\"go_s2\")\n\tapp:frames(30)\n\t-- None yet: no pill.\n\texpect(app:has('role:button \"Open Subagents\"')).to_be(false)\n\tapp:command(\"subagents_running\")\n\tapp:command(\"task_running\")\n\tapp:frames(30)\n\t-- Two agents and a process run: each its own, in the pill.\n\texpect(app:has('role:button \"Open Subagents\"')).to_be(true)\n\texpect(app:has('role:button \"Open Running\"')).to_be(true)\n\tapp:click('role:button \"Open Subagents\"')\n\tapp:frames(30)\n\t-- A row opens its subagent in the session's panel; an agent has no Stop,\n\t-- and the process is the other tab's.\n\texpect(app:has('role:button \"Stop scan the repo\"')).to_be(false)\n\texpect(app:has('role:button \"Stop npm run dev\"')).to_be(false)\n\tapp:click('role:button \"Open read the docs\"')\n\tapp:frames(5)\n\texpect(app:state(\"calls\")).to_contain(\"open_subagent:s2:d2\")\n\t-- The one that finished is folded apart, and opens from there.\n\texpect(app:has('role:button \"Open find the flaky test\"')).to_be(false)\n\tapp:click('role:button \"Show 1 finished\"')\n\tapp:frames(30)\n\tapp:click('role:button \"Open find the flaky test\"')\n\tapp:frames(5)\n\texpect(app:state(\"calls\")).to_contain(\"open_subagent:s2:d3\")\n\texpect(app:error()).to_be(nil)\nend)\n\ntest(\"child chats a Keiki chat started run in the Subagents tray, as subagents do; the person's own side chats don't\", function()\n\tlocal app = mount(\"chat_fixture.luau\")\n\tapp:resize(900, 700)\n\tapp:command(\"go_s2\")\n\tapp:frames(30)\n\texpect(app:has('role:button \"Open Subagents\"')).to_be(false)\n\tapp:command(\"child_chats\")\n\tapp:frames(30)\n\t-- The pill, as for subagents.\n\texpect(app:has('role:button \"Open Subagents\"')).to_be(true)\n\tapp:click('role:button \"Open Subagents\"')\n\tapp:frames(30)\n\t-- The working one is a row of its own; no Stop, as a subagent has none.\n\texpect(app:has('role:button \"Open audit the parser\"')).to_be(true)\n\texpect(app:has('role:button \"Stop audit the parser\"')).to_be(false)\n\t-- The one at rest is folded with the finished.\n\texpect(app:has('role:button \"Open draft the release notes\"')).to_be(false)\n\tapp:click('role:button \"Show 1 finished\"')\n\tapp:frames(30)\n\texpect(app:has('role:button \"Open draft the release notes\"')).to_be(true)\n\t-- The person's own side chat isn't here.\n\texpect(app:has('~\"my own side chat\"')).to_be(false)\n\t-- A row opens its chat in the panel, as a side chat's tab.\n\tapp:click('role:button \"Open audit the parser\"')\n\tapp:frames(5)\n\texpect(app:state(\"calls\")).to_contain(\"open_lane:s2:side_chat:k1\")\n\tapp:click('role:button \"Open draft the release notes\"')\n\tapp:frames(5)\n\texpect(app:state(\"calls\")).to_contain(\"open_lane:s2:side_chat:k2\")\n\texpect(app:state(\"calls\")).never.to_contain(\":k3\")\n\texpect(app:error()).to_be(nil)\nend)\n\ntest(\"child chats a Keiki chat started share the tray with the agent's own subagents\", function()\n\tlocal app = mount(\"chat_fixture.luau\")\n\tapp:resize(900, 700)\n\tapp:command(\"go_s2\")\n\tapp:frames(30)\n\tapp:command(\"subagents_running\")\n\tapp:command(\"child_chats\")\n\tapp:frames(30)\n\tapp:click('role:button \"Open Subagents\"')\n\tapp:frames(30)\n\tfor _, title in { \"scan the repo\", \"read the docs\", \"audit the parser\" } do\n\t\texpect(app:has(`role:button \"Open {title}\"`)).to_be(true)\n\tend\n\t-- Both finished fold together.\n\texpect(app:has('role:button \"Show 2 finished\"')).to_be(true)\n\texpect(app:has('~\"my own side chat\"')).to_be(false)\nend)\n",
		["apps/zgx/ui/tests/chips.test.luau"] = "-- Chips in a chat (ds/markdown): a file, a chat, a skill or a command is\n-- drawn as a chip (its icon, then its name, on one wash) in the prompt and\n-- in the reply alike; a skill by its name alone, no `$`; a web link stays a\n-- link. A chip is one piece: a find in it never cuts it. On the chat page\n-- (ui/chat_fixture.luau), its `chip_turn` command.\n\nlocal function chat(): any\n\tlocal app = mount(\"chat_fixture.luau\")\n\tapp:resize(900, 700)\n\tapp:command(\"go_s2\")\n\tapp:frames(30)\n\tapp:command(\"chip_turn\")\n\tapp:frames(30)\n\treturn app\nend\n\n-- How far the `nth` link labelled `label` in the transcript starts after\n-- its paragraph's text (each of the turn's paragraphs starts with its\n-- link): a chip's icon (14), gap and padding before its name; a link's,\n-- nothing. (The prompt's first, then the reply's.)\nlocal function lead(app: any, label: string, nth: number): number\n\tlocal text_x: number? = nil\n\tlocal seen = 0\n\tfor line in app:tree(\"#transcript\"):gmatch(\"[^\\n]+\") do\n\t\tlocal tx = line:match(\"^%s*@%d+ text .- (%-?%d+),%-?%d+ %d+x%d+\")\n\t\tif tx then\n\t\t\ttext_x = tonumber(tx)\n\t\tend\n\t\tlocal lx = line:match(`^%s*@%d+ link \"{label}\" (%-?%d+),`)\n\t\tif lx and text_x then\n\t\t\tseen += 1\n\t\t\tif seen == nth then\n\t\t\t\treturn (tonumber(lx) :: number) - text_x\n\t\t\tend\n\t\tend\n\tend\n\terror(`no link \"{label}\" #{nth}:\\n{app:tree(\"#transcript\")}`)\nend\n\nlocal function chip(app: any, label: string, nth: number): string\n\treturn `{label} #{nth}: {if lead(app, label, nth) >= 17 then \"chip\" else \"link\"}`\nend\n\ntest(\"a skill's chip shows its name alone, no `$`; a command's keeps its `/`\", function()\n\tlocal app = chat()\n\tlocal tree = app:tree(\"#transcript\")\n\t-- (A skill's and a command's chips open nothing: the words, not links.)\n\texpect(tree).to_contain('text \"frontend-design and\"')\n\texpect(tree).to_contain('text \"frontend-design as well\"')\n\texpect(tree).never.to_contain(\"$frontend-design\")\n\texpect(tree).to_contain('text \"/review last\"')\nend)\n\ntest(\"a file and a chat are chips in the prompt, and the same in the reply; a web link stays a link\", function()\n\tlocal app = chat()\n\tfor _, label in { \"AGENTS.md\", \"Long chat\" } do\n\t\texpect(chip(app, label, 1)).to_be(`{label} #1: chip`)\n\t\texpect(chip(app, label, 2)).to_be(`{label} #2: chip`)\n\tend\n\texpect(chip(app, \"the docs\", 1)).to_be(\"the docs #1: link\")\nend)\n\ntest(\"a reply's file chip opens the file, as its link did\", function()\n\tlocal app = chat()\n\tlocal calls = app:state(\"calls\")\n\tapp:click('role:link \"AGENTS.md\"[2]')\n\tapp:frames(10)\n\texpect(string.sub(app:state(\"calls\"), #calls + 1)).to_contain(\"open_file:s2:AGENTS.md\")\nend)\n\ntest(\"a find in a chip's name never cuts it: still one chip\", function()\n\tlocal app = chat()\n\tapp:command(\"find_open\")\n\tapp:frames(20)\n\tapp:type('role:textbox \"Find\"', \"AGENTS\")\n\tapp:frames(30)\n\t-- (The prompt's and the reply's: each one link, the whole name.)\n\tlocal _, n = string.gsub(app:tree(\"#transcript\"), 'link \"AGENTS%.md\"', \"\")\n\texpect(n).to_be(2)\n\texpect(app:tree(\"#transcript\")).never.to_contain('link \"AGENTS\"')\n\texpect(chip(app, \"AGENTS.md\", 1)).to_be(\"AGENTS.md #1: chip\")\nend)\n\ntest(\"a reply's link to one of the agent's skills (its SKILL.md, wherever it's kept) is that skill's chip, by its name; one not listed stays a link\", function()\n\tlocal app = chat()\n\t-- (The chat's skills read once, as the link shows.)\n\texpect(app:wait('~\"code-review is one\"', { timeout_ms = 2000 })).to_be(true)\n\texpect(app:state(\"calls\")).to_contain(\"invocations:copilot:s2\")\n\texpect(app:has('role:link \"the review skill\"')).to_be(false)\n\texpect(app:tree(\"#transcript\")).never.to_contain(\"$code-review\")\n\texpect(chip(app, \"that skill\", 1)).to_be(\"that skill #1: link\")\nend)\n\ntest(\"a file outside the chat's folder stays a link\", function()\n\tlocal app = chat()\n\texpect(chip(app, \"hosts\", 1)).to_be(\"hosts #1: link\")\nend)\n",
		["apps/zgx/ui/tests/composer_in_place.test.luau"] = "-- The composer's notice (an alert of the deck's) follows what it says in\n-- place: an upload counting up, then failing with Retry, is one row\n-- throughout, its words, tone and action changing on it. (It was keyed by everything it said, so each step\n-- faded the line out and in again.) On the composer in\n-- ui/composer_fixture.luau.\n\n-- A node's identity, by its kind and label (or text): `@id`.\nlocal function node(app: any, kind: string, label: string?): string?\n\tlocal pattern = if label then ` {kind} \"{label}\"` else ` {kind} `\n\tfor line in app:tree():gmatch(\"[^\\n]+\") do\n\t\tif line:find(pattern, 1, true) then\n\t\t\treturn line:match(\"@(%d+)\")\n\t\tend\n\tend\n\treturn nil\nend\n\nlocal function settle(app: any)\n\tapp:frames(30)\nend\n\ntest(\"a notice that moves on stays one row of the alerts\", function()\n\tlocal app = mount(\"composer_fixture.luau\")\n\tapp:resize(700, 500)\n\tsettle(app)\n\tapp:set_state(\"test_composer_notice\", { text = \"Uploading 1 of 3\", spinner = true })\n\tsettle(app)\n\t-- In the pill, opened by the person.\n\texpect(app:has('role:button \"Open Alerts\"')).to_be(true)\n\tapp:click('role:button \"Open Alerts\"')\n\tsettle(app)\n\tlocal row = node(app, \"listitem\")\n\tlocal words = node(app, \"text\", \"Uploading 1 of 3\")\n\texpect(row).never.to_be_nil()\n\t-- Not to be let go: it says what's going on.\n\texpect(app:has('role:button \"Dismiss Uploading 1 of 3\"')).to_be(false)\n\n\tapp:set_state(\"test_composer_notice\", { text = \"Uploading 2 of 3\", spinner = true })\n\tsettle(app)\n\texpect(`row @{node(app, \"listitem\")}`).to_be(`row @{row}`)\n\texpect(`words @{node(app, \"text\", \"Uploading 2 of 3\")}`).to_be(`words @{words}`)\n\n\tapp:set_state(\"test_composer_notice\", { text = \"One file didn't upload\", tone = \"danger\", action = \"Retry\", dismissable = true })\n\tsettle(app)\n\texpect(`row @{node(app, \"listitem\")}`).to_be(`row @{row}`)\n\texpect(app:has('role:button \"Retry\"')).to_be(true)\n\texpect(app:has('role:button \"Dismiss One file didn\\'t upload\"')).to_be(true)\n\n\t-- Gone: its tab goes.\n\tapp:set_state(\"test_composer_notice\", nil)\n\tsettle(app)\n\texpect(app:has('role:button \"Open Alerts\"')).to_be(false)\n\texpect(app:has('role:tab \"Fold Alerts\"')).to_be(false)\n\texpect(app:error()).to_be(nil)\nend)\n",
		["apps/zgx/ui/tests/date_picker.test.luau"] = "-- The date picker (ds/date_picker) on ui/date_picker_fixture.luau: March\n-- 2026, chosen the 10th at 10:00, nothing before the 5th at 9:20. March\n-- 2026 starts on a Sunday, so day N stands in cell N.\n\nlocal VALUE = \"dp_value\"\nlocal CHANGES = \"dp_changes\"\n\nlocal function open(): any\n\tlocal app = mount(\"date_picker_fixture.luau\")\n\tapp:resize(480, 800)\n\tapp:frames(10)\n\treturn app\nend\n\n-- The value's date and time on this Mac's clock: \"2026-03-10 10:00\".\nlocal function chosen(app: any): string\n\tlocal v = app:state(VALUE)\n\tif v == nil then\n\t\treturn \"nothing\"\n\tend\n\treturn os.date(\"%Y-%m-%d %H:%M\", v :: number) :: string\nend\n\nlocal function cell(app: any, i: number): string\n\treturn app:text(`#dp-day-{i}`)\nend\n\ntest(\"DatePicker: opens on the value's month, the chosen day where it falls\", function()\n\tlocal app = open()\n\texpect(cell(app, 1)).to_be(\"1\")\n\texpect(cell(app, 10)).to_be(\"10\")\n\texpect(cell(app, 31)).to_be(\"31\")\n\t-- (March fits five weeks: no sixth row of April's days.)\n\texpect(app:has(\"#dp-day-42\")).to_be(false)\n\texpect(chosen(app)).to_be(\"2026-03-10 10:00\")\n\t-- May 2026 starts on a Friday and runs into a sixth week.\n\tapp:click(\"#dp-next\")\n\tapp:frames(10)\n\tapp:click(\"#dp-next\")\n\tapp:frames(10)\n\texpect(app:text(\"#dp-title\")).to_be(\"May 2026\")\n\texpect(app:has(\"#dp-day-42\")).to_be(true)\n\texpect(cell(app, 36)).to_be(\"31\")\nend)\n\ntest(\"DatePicker: picking a day keeps the time of day\", function()\n\tlocal app = open()\n\tapp:click(\"#dp-day-20\")\n\tapp:frames(2)\n\texpect(chosen(app)).to_be(\"2026-03-20 10:00\")\n\texpect(app:state(CHANGES)).to_be(1)\nend)\n\ntest(\"DatePicker: the next month renames the days in place, and a day there keeps the time\", function()\n\tlocal app = open()\n\tapp:click(\"#dp-next\")\n\tapp:frames(2)\n\t-- April 2026 starts on a Wednesday: March's last three days first.\n\texpect(cell(app, 1)).to_be(\"29\")\n\texpect(cell(app, 4)).to_be(\"1\")\n\tapp:click(\"#dp-day-18\")\n\tapp:frames(2)\n\texpect(chosen(app)).to_be(\"2026-04-15 10:00\")\n\t-- And back.\n\tapp:click(\"#dp-previous\")\n\tapp:frames(2)\n\texpect(cell(app, 1)).to_be(\"1\")\n\texpect(cell(app, 32)).to_be(\"1\")\nend)\n\ntest(\"DatePicker: a day before min can't be picked, nor a month before its own shown\", function()\n\tlocal app = open()\n\t-- (A press on a day it won't take: failing to land, or landing on nothing.)\n\tpcall(function()\n\t\tapp:click(\"#dp-day-3\")\n\tend)\n\tapp:frames(2)\n\texpect(chosen(app)).to_be(\"2026-03-10 10:00\")\n\texpect(app:state(CHANGES)).to_be(0)\n\tpcall(function()\n\t\tapp:click(\"#dp-previous\")\n\tend)\n\tapp:frames(2)\n\texpect(cell(app, 1)).to_be(\"1\")\n\texpect(cell(app, 10)).to_be(\"10\")\n\t-- min's own day can be: at the time it holds, past min's.\n\tapp:click(\"#dp-day-5\")\n\tapp:frames(2)\n\texpect(chosen(app)).to_be(\"2026-03-05 10:00\")\nend)\n\ntest(\"DatePicker: a time changes the time of day, keeping the day\", function()\n\tlocal app = open()\n\tapp:click(\"#dp-time\")\n\tapp:frames(10)\n\t-- Every 15 minutes from midnight: 10:30 is the 43rd.\n\tapp:click(\"#select-option-43\")\n\tapp:frames(10)\n\texpect(chosen(app)).to_be(\"2026-03-10 10:30\")\nend)\n\ntest(\"DatePicker: on min's day, the times before min can't be taken\", function()\n\tlocal app = open()\n\tapp:click(\"#dp-day-5\")\n\tapp:frames(2)\n\tapp:click(\"#dp-time\")\n\tapp:frames(10)\n\t-- 9:15, before min's 9:20.\n\tpcall(function()\n\t\tapp:click(\"#select-option-38\")\n\tend)\n\tapp:frames(10)\n\texpect(chosen(app)).to_be(\"2026-03-05 10:00\")\nend)\n\ntest(\"DatePicker: the arrows move between days, Page Down a month, Enter picks\", function()\n\tlocal app = open()\n\tapp:click(\"#dp-day-10\")\n\tapp:frames(2)\n\tapp:key(\"ArrowRight\")\n\tapp:key(\"ArrowDown\")\n\tapp:frames(2)\n\tapp:key(\"Enter\")\n\tapp:frames(2)\n\texpect(chosen(app)).to_be(\"2026-03-18 10:00\")\n\tapp:key(\"PageDown\")\n\tapp:frames(2)\n\tapp:key(\"Enter\")\n\tapp:frames(2)\n\texpect(chosen(app)).to_be(\"2026-04-18 10:00\")\n\t-- (April showing now.)\n\texpect(cell(app, 4)).to_be(\"1\")\nend)\n\n-- A node's identity in the tree (`@n`), by its id.\nlocal function node(app: any, id: string): string?\n\tfor line in app:tree():gmatch(\"[^\\n]+\") do\n\t\tif line:find(`#{id} `, 1, true) or line:find(`#{id}$`) then\n\t\t\treturn line:match(\"@(%d+)\")\n\t\tend\n\tend\n\treturn nil\nend\n\ntest(\"DatePicker: the days stay the same nodes as a day is picked and the month changes\", function()\n\tlocal app = open()\n\tlocal before = node(app, \"dp-day-20\")\n\texpect(before).never.to_be_nil()\n\tapp:click(\"#dp-day-20\")\n\tapp:frames(2)\n\texpect(`day @{node(app, \"dp-day-20\")}`).to_be(`day @{before}`)\n\tapp:click(\"#dp-next\")\n\tapp:frames(2)\n\texpect(`day @{node(app, \"dp-day-20\")}`).to_be(`day @{before}`)\nend)\n\ntest(\"DatePicker: a time between the steps is offered where it falls\", function()\n\tlocal app = open()\n\tlocal v = app:state(VALUE) :: number\n\tapp:set_state(VALUE, v + 7 * 60)\n\tapp:frames(2)\n\tapp:click(\"#dp-time\")\n\tapp:frames(10)\n\t-- After 10:00 (the 41st), before 10:15.\n\texpect(app:text(\"#select-option-42\")).to_contain(\"10:07\")\n\tapp:click(\"#select-option-44\")\n\tapp:frames(10)\n\texpect(chosen(app)).to_be(\"2026-03-10 10:30\")\nend)\n\ntest(\"DatePicker: the gallery's page builds its three pickers\", function()\n\tlocal app = open()\n\tapp:set_state(\"dp_demo\", true)\n\tapp:frames(10)\n\texpect(app:error()).to_be_nil()\n\tfor _, id in { \"dpk-when\", \"dpk-day\", \"dpk-empty\" } do\n\t\texpect(app:has(`#{id}-day-1`)).to_be(true)\n\tend\n\texpect(app:has(\"#dpk-when-time\")).to_be(true)\n\texpect(app:has(\"#dpk-day-time\")).to_be(false)\nend)\n",
		["apps/zgx/ui/tests/examples_in_place.test.luau"] = "-- Gallery examples that change in place as they're used: choosing a colour\n-- scheme keeps the step (and the picker clicked) as it is, its theme\n-- following; an invitation answered keeps the organizations above it; a\n-- search keeps the rows it still finds. (Each was built again for each\n-- change: the scheme rebuilt the window, the picker too; the invitation's\n-- answer the list; each letter typed the list.) On the examples in\n-- ui/demo_fixture.luau, the one shown named by `test_demo`.\n\n-- A node's identity, by its kind and label (or text): `@id`.\nlocal function node(app: any, kind: string, label: string): string?\n\tfor line in app:tree():gmatch(\"[^\\n]+\") do\n\t\tif line:find(` {kind} \"{label}\"`, 1, true) then\n\t\t\treturn line:match(\"@(%d+)\")\n\t\tend\n\tend\n\treturn nil\nend\n\nlocal function settle(app: any)\n\tapp:frames(30)\nend\n\nlocal function same(app: any, kind: string, label: string, was: string?)\n\texpect(`{label} @{node(app, kind, label)}`).to_be(`{label} @{was}`)\nend\n\ntest(\"a colour scheme chosen keeps the step and its picker\", function()\n\tlocal app = mount(\"demo_fixture.luau\")\n\tapp:resize(1000, 760)\n\tsettle(app)\n\tlocal group = node(app, \"radiogroup\", \"Color scheme\")\n\tlocal dark = node(app, \"radio\", \"Dark\")\n\tlocal accent = node(app, \"radio\", \"Orange\")\n\texpect(dark).never.to_be_nil()\n\tapp:click('role:radio \"Dark\"')\n\tsettle(app)\n\tsame(app, \"radiogroup\", \"Color scheme\", group)\n\tsame(app, \"radio\", \"Dark\", dark)\n\tsame(app, \"radio\", \"Orange\", accent)\n\texpect(app:tree():find('radio \"Dark\" [^\\n]* checked') ~= nil).to_be(true)\nend)\n\ntest(\"an invitation answered keeps the organizations above it\", function()\n\tlocal app = mount(\"demo_fixture.luau\")\n\tapp:resize(1000, 760)\n\tapp:set_state(\"test_demo\", \"orgs\")\n\tsettle(app)\n\tlocal halcyon = node(app, \"radio\", \"Halcyon Labs\")\n\tlocal northwind = node(app, \"radio\", \"Northwind Robotics\")\n\texpect(halcyon).never.to_be_nil()\n\tapp:click('role:button \"Accept\"')\n\tsettle(app)\n\tsame(app, \"radio\", \"Halcyon Labs\", halcyon)\n\tsame(app, \"radio\", \"Northwind Robotics\", northwind)\n\texpect(node(app, \"radio\", \"Finch & Co\")).never.to_be_nil()\nend)\n\ntest(\"a search keeps the rows it still finds\", function()\n\tlocal app = mount(\"demo_fixture.luau\")\n\tapp:resize(1000, 760)\n\tapp:set_state(\"test_demo\", \"members\")\n\tsettle(app)\n\tlocal theo = node(app, \"text\", \"Theo Lindqvist\")\n\texpect(theo).never.to_be_nil()\n\tapp:type('role:textbox \"Search\"', \"t\")\n\tsettle(app)\n\tsame(app, \"text\", \"Theo Lindqvist\", theo)\n\tapp:type('role:textbox \"Search\"', \"h\")\n\tsettle(app)\n\tsame(app, \"text\", \"Theo Lindqvist\", theo)\n\texpect(node(app, \"text\", \"Priya Raman\")).to_be_nil()\n\n\tapp:set_state(\"test_demo\", \"plugins\")\n\tsettle(app)\n\tlocal linear = node(app, \"text\", \"Linear\")\n\texpect(linear).never.to_be_nil()\n\tapp:type('role:textbox \"Search\"', \"i\")\n\tsettle(app)\n\tsame(app, \"text\", \"Linear\", linear)\nend)\n",
		["apps/zgx/ui/tests/fit.test.luau"] = "-- The window's fit (screens/shell/fit_policy): Zeron's policy (crates/ui\n-- shell/panel_layout.rs `horizontal_panel_fit`, shell.rs `content_split`,\n-- `right_pane_max_width`), its cases as Zeron's own tests have them\n-- (shell.rs `right_pane_ceiling_preserves_the_chat_floor`,\n-- `right_pane_takeover_consumes_the_chat_column`; panel_interaction_tests\n-- `panels_share_space_…`: their widths and which column a narrow window\n-- hides).\n\nlocal fit = require(\"../screens/shell/fit_policy\")\n\nlocal function col(open: boolean, at: number): fit.Column\n\treturn { open = open, at = at }\nend\nlocal CLOSED = col(false, 0)\n\ntest(\"the panel's ceiling keeps the chat's least\", function()\n\texpect(fit.right_pane_max_width(1200, 256, fit.CHAT_PANEL_MIN)).to_be(644)\n\texpect(1200 - 256 - 644).to_be(fit.CHAT_PANEL_MIN)\n\t-- The chat's least wins over the panel's own when the window is narrow.\n\texpect(fit.right_pane_max_width(800, 256, fit.CHAT_PANEL_MIN)).to_be(244)\nend)\n\ntest(\"expanded, the panel takes all of the chat's room\", function()\n\texpect(fit.right_pane_takeover_width(1200, 256)).to_be(944)\nend)\n\ntest(\"the panel's share is half of what the tools leave, within the least\", function()\n\t-- (Zeron's lifecycle test: 1600 wide, sidebar 300, Files 377 / 286.)\n\texpect(fit.content_split(1600 - 377)).to_be(611.5)\n\texpect(fit.content_split(1600 - 300 - 377)).to_be(461.5)\n\texpect(fit.content_split(1600 - 300 - 286)).to_be(507)\n\t-- 1000 wide: half would be under the panel's least.\n\texpect(fit.content_split(1000 - 300)).to_be(360)\nend)\n\ntest(\"everything open fits a wide window, the sidebar at its own width\", function()\n\tlocal f = fit.panels(1600, 300, col(true, 1), col(true, 2), col(true, 3), false)\n\texpect(f.sidebar and f.right and f.files).to_be(true)\n\texpect(f.sidebar_limit).to_be(300)\nend)\n\ntest(\"a narrow window hides the column opened longest ago, not the others\", function()\n\t-- Right opened, then Files, then the sidebar: Files is the oldest of\n\t-- those that must give way (Zeron's 1000-wide step).\n\tlocal f = fit.panels(1000, 300, col(true, 5), col(true, 4), col(true, 3), false)\n\texpect(f.sidebar).to_be(true)\n\texpect(f.right).to_be(true)\n\texpect(f.files).to_be(false)\n\t-- Files asked for (ranked newest): it comes back and the panel goes.\n\tf = fit.panels(1000, 300, col(true, 5), col(true, 4), col(true, 6), false)\n\texpect(f.files).to_be(true)\n\texpect(f.right).to_be(false)\n\texpect(f.sidebar).to_be(true)\nend)\n\ntest(\"short of room, the sidebar narrows to what's left before it hides\", function()\n\t-- (Zeron's 1130-wide step: 1130 - 300 - 360 - 220.)\n\tlocal f = fit.panels(1130, 300, col(true, 1), col(true, 2), col(true, 3), false)\n\texpect(f.sidebar).to_be(true)\n\texpect(f.sidebar_limit).to_be(250)\n\t-- Never wider than its own width.\n\tf = fit.panels(2000, 260, col(true, 1), col(true, 2), CLOSED, false)\n\texpect(f.sidebar_limit).to_be(260)\nend)\n\ntest(\"an expanded panel goes last, whatever its age\", function()\n\t-- 300 + 242 + 360 = 902 > 900: one must go; the panel is older but\n\t-- expanded, so the sidebar hides.\n\tlocal f = fit.panels(900, 256, col(true, 5), col(true, 1), CLOSED, true)\n\texpect(f.right).to_be(true)\n\texpect(f.sidebar).to_be(false)\n\t-- Not expanded, the older one goes.\n\tf = fit.panels(900, 256, col(true, 5), col(true, 1), CLOSED, false)\n\texpect(f.right).to_be(false)\n\texpect(f.sidebar).to_be(true)\nend)\n\ntest(\"expanded in a window too narrow for chat and panel, the panel alone shows\", function()\n\tlocal f = fit.panels(600, 256, col(true, 5), col(true, 1), col(true, 2), true)\n\texpect(f.right).to_be(true)\n\texpect(f.sidebar).to_be(false)\n\texpect(f.files).to_be(false)\n\t-- Narrower than the panel's own least: nothing.\n\tf = fit.panels(300, 256, col(true, 5), col(true, 1), CLOSED, true)\n\texpect(f.right).to_be(false)\nend)\n\ntest(\"closed columns take no room, and nothing open hides nothing\", function()\n\tlocal f = fit.panels(700, 256, col(true, 1), CLOSED, CLOSED, false)\n\texpect(f.sidebar).to_be(true)\n\texpect(f.sidebar_limit).to_be(256)\n\tf = fit.panels(500, 256, CLOSED, CLOSED, CLOSED, false)\n\texpect(f.sidebar or f.right or f.files).to_be(false)\n\t-- Too narrow for the sidebar beside the chat's least: it hides.\n\tf = fit.panels(500, 256, col(true, 1), CLOSED, CLOSED, false)\n\texpect(f.sidebar).to_be(false)\nend)\n\n-- A split's panes (screens/shell/fit, `other_gives_way`): what they want.\nlocal GAP = 4\nlocal function floor(n: number): number\n\treturn fit.page_floor(n, GAP)\nend\n\ntest(\"the page wants its panes' least and the gaps; one pane is the chat's least\", function()\n\texpect(floor(1)).to_be(fit.CHAT_PANEL_MIN)\n\texpect(floor(2)).to_be(598)\n\texpect(floor(3)).to_be(890)\n\texpect(floor(4)).to_be(1182)\n\texpect(floor(5)).to_be(1474)\n\texpect(floor(6)).to_be(1766)\n\t-- What each of two or more has at that: what stands round them and the gaps\n\t-- between them out of it, shared.\n\tfor n = 2, 6 do\n\t\texpect((floor(n) - fit.PAGE_EDGES - (n - 1) * GAP) / n).to_be(fit.PANE_MIN)\n\tend\nend)\n\ntest(\"both sides open: 1 to 6 panes at every window, they fit or one side must go\", function()\n\tlocal PANEL = fit.RIGHT_PANE_MIN\n\tfor n = 1, 6 do\n\t\tfor _, w in { 760, 900, 1100, 1280, 1440, 1728, 2000, 2560 } do\n\t\t\tlocal want = floor(n) + fit.SIDEBAR_DEFAULT + PANEL <= w\n\t\t\texpect(`{n} at {w}: {fit.panes_fit(w, floor(n), fit.SIDEBAR_DEFAULT, PANEL)}`).to_be(`{n} at {w}: {want}`)\n\t\tend\n\tend\n\t-- The reported windows.\n\texpect(fit.panes_fit(1100, floor(2), 256, PANEL)).to_be(false)\n\texpect(fit.panes_fit(1440, floor(2), 256, PANEL)).to_be(true)\n\texpect(fit.panes_fit(1440, floor(3), 256, PANEL)).to_be(false)\nend)\n\ntest(\"the fit itself takes no account of panes: a window narrowing keeps its old rule\", function()\n\t-- Everything still fits a chat's least: nothing hides, whatever the split.\n\tlocal f = fit.panels(1000, 256, col(true, 1), col(true, 2), CLOSED, false)\n\texpect(f.sidebar and f.right).to_be(true)\nend)\n\ntest(\"the panel's share leaves the panes what they want, and keeps its own least\", function()\n\t-- 1100, no sidebar: half of 812 would leave them under 598.\n\texpect(fit.content_split(812, floor(2))).to_be(360)\n\t-- Plenty: half.\n\texpect(fit.content_split(2000, floor(2))).to_be(1000)\n\t-- Between: what the panes leave it.\n\texpect(fit.content_split(1100, floor(2))).to_be(502)\n\t-- One pane is the chat's.\n\texpect(fit.content_split(700, floor(1))).to_be(fit.content_split(700))\n\t-- Too little for the panes: its least, and they narrow.\n\texpect(fit.content_split(812, floor(3))).to_be(360)\nend)\n\ntest(\"the most the panel takes leaves the panes what they want, down to its least\", function()\n\texpect(fit.panel_room(1440, 256, 0, floor(2))).to_be(586)\n\texpect(fit.panel_room(1100, 0, 0, floor(2))).to_be(502)\n\t-- Too little: its least, whatever the panes want; its tree counted in it.\n\texpect(fit.panel_room(1100, 0, 0, floor(3))).to_be(360)\n\texpect(fit.panel_room(1100, 0, 288, floor(3))).to_be(72)\nend)\n",
		["apps/zgx/ui/tests/git_diff.test.luau"] = "-- A diff as the design system reads it (ds/git), on ui/git_diff_fixture.luau:\n-- its lines coloured by their language with the editor's own highlighters\n-- (ds/syntax), worked out once per file; side by side, what was taken out\n-- paired with what was put in; a hunk's header with the code it falls in.\n-- The list that draws them (ds/git_changes: wrapped, split, sticky file\n-- rows) is tested with the Git plugin (src/plugins/examples_tests.rs).\n\ntest(\"a diff's lines are coloured as their language is, once per file\", function()\n\tlocal app = mount(\"git_diff_fixture.luau\")\n\tapp:frames(5)\n\tlocal said = app:text(\"#hl\")\n\t-- `fn`, a keyword: a colour of its own, not plain text's.\n\texpect(string.find(said, \"fn=$zeron.syntax.\", 1, true) ~= nil).to_be(true)\n\texpect(string.find(said, \"fn=$zeron.syntax.text\", 1, true)).to_be(nil)\n\t-- A hunk's header has none; asked again, the same answer, kept.\n\texpect(string.find(said, \"hunk=none\", 1, true) ~= nil).to_be(true)\n\texpect(string.find(said, \"same=true\", 1, true) ~= nil).to_be(true)\n\t-- A language Zeron doesn't colour: none at all.\n\texpect(string.find(said, \"unknown=true\", 1, true) ~= nil).to_be(true)\nend)\n\ntest(\"side by side pairs what was taken out with what was put in\", function()\n\tlocal app = mount(\"git_diff_fixture.luau\")\n\tapp:frames(5)\n\t-- Header; unchanged; two out beside two in; the third in alone; unchanged.\n\texpect(app:text(\"#pairs\")).to_be(\"H = LR LR _R =\")\nend)\n\ntest(\"a hunk's header says the code it falls in apart from its ranges\", function()\n\tlocal app = mount(\"git_diff_fixture.luau\")\n\tapp:frames(5)\n\texpect(app:has('\"@@ -10,4 +10,5 @@\"')).to_be(true)\n\texpect(app:has('\"impl Lanes {\"')).to_be(true)\nend)\n",
		["apps/zgx/ui/tests/keys.test.luau"] = "-- The shell's shortcuts, one list (screens/shell/keys): Zeron's defaults,\n-- each id and each key once, each in a group Settings lists.\n\nlocal keys = require(\"../screens/shell/keys\")\n\ntest(\"each shortcut is one command's, on one key, in a known group\", function()\n\tlocal ids: { [string]: boolean } = {}\n\tlocal taken: { [string]: string } = {}\n\tlocal GROUPS = { Sessions = true, Panels = true, Go = true, App = true }\n\tfor _, k in keys.LIST do\n\t\texpect(ids[k.id]).to_be(nil)\n\t\tids[k.id] = true\n\t\t-- (Those with none have none to share.)\n\t\tif k.key ~= \"\" then\n\t\t\texpect(`{k.key}: {taken[k.key] or \"free\"}`).to_be(`{k.key}: free`)\n\t\t\ttaken[k.key] = k.id\n\t\tend\n\t\texpect(GROUPS[k.group]).to_be(true)\n\t\texpect(keys.get(k.id)).to_be(k)\n\tend\nend)\n\ntest(\"Keiki's defaults\", function()\n\tlocal want = {\n\t\t[\"shell.toggle_sidebar\"] = \"cmd+b\",\n\t\t[\"shell.toggle_files\"] = \"cmd+r\",\n\t\t[\"shell.toggle_files_tab\"] = \"cmd+e\",\n\t\t[\"shell.toggle_terminal\"] = \"cmd+j\",\n\t\t[\"shell.model_picker\"] = \"cmd+/\",\n\t\t[\"shell.archive\"] = \"cmd+shift+a\",\n\t\t[\"shell.next_session\"] = \"ctrl+tab\",\n\t\t[\"shell.previous_session\"] = \"ctrl+shift+tab\",\n\t\t[\"shell.new_chat\"] = \"cmd+n\",\n\t\t[\"shell.palette\"] = \"cmd+k\",\n\t}\n\tfor id, key in want do\n\t\tlocal k = keys.get(id)\n\t\texpect(k).never.to_be_nil()\n\t\texpect(`{id} {(k :: any).key}`).to_be(`{id} {key}`)\n\tend\n\tfor i = 1, 9 do\n\t\texpect((keys.get(`shell.session_{i}`) :: any).key).to_be(`cmd+{i}`)\n\tend\nend)\n\ntest(\"a shortcut another screen makes is listed as it makes it\", function()\n\t-- (The browser tab's annotate: its own command, screens/panel/browser.)\n\tlocal k = keys.get(\"panel.annotate\") :: any\n\texpect(k.key).to_be(\"cmd+shift+i\")\n\texpect(k.group).to_be(\"Panels\")\n\texpect(k.elsewhere).to_be(true)\nend)\n\ntest(\"Reload Keiki and Reload interface are the app's, with no key of their own\", function()\n\tfor _, id in { \"shell.reload\", \"shell.reload_interface\" } do\n\t\tlocal k = keys.get(id) :: any\n\t\texpect(k).never.to_be_nil()\n\t\texpect(k.group).to_be(\"App\")\n\t\texpect(k.key).to_be(\"\")\n\tend\n\texpect((keys.get(\"shell.reload\") :: any).title).to_be(\"Reload Keiki\")\nend)\n",
		["apps/zgx/ui/tests/lightbox.test.luau"] = "-- The lightbox (ds/lightbox) over a message's thumbnails and the composer's\n-- chips (ui/lightbox_fixture.luau, a 900 by 600 window): a thumbnail or a\n-- chip opens its picture fitted, its thumbnail lifted out; Escape closes it\n-- and focus comes back to the thumbnail; ← → go through the set, holding at\n-- its ends; zoom walks its steps, fits and goes to its own size; panning\n-- never brings the picture's edges inside the window; a click on the\n-- picture leaves it open and Close closes it; a small picture is never\n-- enlarged to fit.\n\nlocal function open_box(): any\n\tlocal app = mount(\"lightbox_fixture.luau\")\n\tapp:resize(900, 600)\n\tapp:frames(10)\n\texpect(app:error()).to_be_nil()\n\treturn app\nend\n\n-- The open stage's view: { s, cx, cy, fitted, w, h, fit, win_w, win_h }.\nlocal function view(app: any): any\n\tapp:command(\"test.lightbox_view\")\n\treturn app:state(\"test_lightbox_view\")\nend\n\nlocal function lifted(app: any): string?\n\treturn app:state(\"ds/lightbox.luau::lifted\")\nend\n\nlocal function line_of(app: any, needle: string): string\n\tfor line in app:tree():gmatch(\"[^\\n]+\") do\n\t\tif line:find(needle, 1, true) then\n\t\t\treturn line\n\t\tend\n\tend\n\treturn \"\"\nend\n\nlocal function shows(app: any, text: string): boolean\n\treturn app:has(`\"{text}\"`)\nend\n\nlocal function near(a: number, b: number): boolean\n\treturn math.abs(a - b) < 0.01\nend\n\ntest(\"a thumbnail opens its picture fitted, its thumbnail lifted out; Escape closes it and focus comes back to the thumbnail\", function()\n\tlocal app = open_box()\n\tapp:click('\"Open night.jpg\"')\n\tapp:frames(90)\n\tlocal v = view(app)\n\texpect(v).never.to_be_nil()\n\texpect(v.fitted).to_be(true)\n\t-- 2100 by 700 in 900 less 2 × 40 across: fitted by its width, never\n\t-- past its own size.\n\texpect(near(v.s, v.fit)).to_be(true)\n\texpect(v.s < 1).to_be(true)\n\texpect(lifted(app)).to_be(\"m1:3\")\n\texpect(line_of(app, 'dialog \"Image viewer\"')).never.to_contain(\"hidden\")\n\texpect(shows(app, \"3 of 3\")).to_be(true)\n\tapp:key(\"Escape\")\n\tapp:frames(120)\n\texpect(lifted(app)).to_be_nil()\n\texpect(app:state(\"ds/lightbox.luau::open\")).to_be_nil()\n\texpect(line_of(app, 'button \"Open night.jpg\"')).to_contain(\"focused\")\nend)\n\ntest(\"a composer chip opens the chips' pictures; ← → go through them, holding at the ends, the lifted chip following\", function()\n\tlocal app = open_box()\n\tapp:click('\"chip-shell.png\"')\n\tapp:frames(90)\n\texpect(shows(app, \"1 of 2\")).to_be(true)\n\texpect(lifted(app)).to_be(\"chips:c1\")\n\tapp:key(\"ArrowLeft\")\n\tapp:frames(30)\n\texpect(shows(app, \"1 of 2\")).to_be(true)\n\tapp:key(\"ArrowRight\")\n\tapp:frames(30)\n\texpect(shows(app, \"2 of 2\")).to_be(true)\n\texpect(shows(app, \"chip-tall.png\")).to_be(true)\n\texpect(lifted(app)).to_be(\"chips:c3\")\n\tapp:key(\"ArrowRight\")\n\tapp:frames(30)\n\texpect(shows(app, \"2 of 2\")).to_be(true)\n\t-- Another picture: fitted afresh (520 by 1800 in 600 less 40 and 72 down).\n\tlocal v = view(app)\n\texpect(v.fitted).to_be(true)\n\texpect(near(v.s, (600 - 40 - 72) / 1800)).to_be(true)\n\tapp:key(\"ArrowLeft\")\n\tapp:frames(30)\n\texpect(shows(app, \"1 of 2\")).to_be(true)\n\texpect(lifted(app)).to_be(\"chips:c1\")\nend)\n\ntest(\"zooming a picture: ⌘1 is its own size, ⌘+ ⌘− walk the steps, ⌘0 fits; panning never brings its edges inside the window\", function()\n\tlocal app = open_box()\n\tapp:click('\"Open night.jpg\"')\n\tapp:frames(90)\n\tapp:key(\"cmd+1\")\n\tapp:frames(60)\n\tlocal v = view(app)\n\texpect(v.fitted).to_be(false)\n\texpect(near(v.s, 1)).to_be(true)\n\texpect(shows(app, \"100%\")).to_be(true)\n\t-- 2100 by 700 at its own size in a 900 by 600 window: its middle may go\n\t-- from 900 − 1050 to 1050 across and 600 − 350 to 350 down.\n\tapp:scroll('\"Image viewer\"', 5000)\n\tapp:frames(5)\n\tv = view(app)\n\texpect(near(v.cy, 250)).to_be(true)\n\tapp:scroll('\"Image viewer\"', -5000)\n\tapp:frames(5)\n\tv = view(app)\n\texpect(near(v.cy, 350)).to_be(true)\n\texpect(v.cx >= 900 - 1050 - 0.01 and v.cx <= 1050 + 0.01).to_be(true)\n\tapp:key(\"cmd+=\")\n\tapp:frames(60)\n\texpect(near(view(app).s, 1.25)).to_be(true)\n\tapp:key(\"cmd+-\")\n\tapp:key(\"cmd+-\")\n\tapp:frames(60)\n\texpect(near(view(app).s, 0.75)).to_be(true)\n\tfor _ = 1, 30 do\n\t\tapp:key(\"cmd+=\")\n\tend\n\tapp:frames(60)\n\texpect(near(view(app).s, 16)).to_be(true)\n\tapp:key(\"cmd+0\")\n\tapp:frames(60)\n\tv = view(app)\n\texpect(v.fitted).to_be(true)\n\texpect(near(v.s, v.fit)).to_be(true)\n\t-- Fitted, it fits whole: nothing to pan.\n\tlocal cy = v.cy\n\tapp:scroll('\"Image viewer\"', 400)\n\tapp:frames(5)\n\texpect(near(view(app).cy, cy)).to_be(true)\nend)\n\ntest(\"a click on the picture doesn't close it; its Close does, focus back on the thumbnail\", function()\n\tlocal app = open_box()\n\tapp:click('\"Open night.jpg\"')\n\tapp:frames(90)\n\t-- (The stage's middle is on the picture. A click beside it closes: the\n\t-- harness reaches nodes, not points, so that is checked in the gallery.)\n\tapp:click('\"Image night.jpg\"')\n\tapp:frames(30)\n\texpect(app:state(\"ds/lightbox.luau::open\")).never.to_be_nil()\n\t-- (Its controls fade after 1.6 s of a still pointer, and the test's\n\t-- time is its frames': the pointer moved over the picture brings them\n\t-- back, as a person's does.)\n\tapp:hover('\"Image night.jpg\"')\n\tapp:frames(5)\n\tapp:click('role:button \"Close\"')\n\tapp:frames(120)\n\texpect(app:state(\"ds/lightbox.luau::open\")).to_be_nil()\n\texpect(line_of(app, 'button \"Open night.jpg\"')).to_contain(\"focused\")\nend)\n\ntest(\"a picture smaller than the window shows at its own size, never enlarged\", function()\n\tlocal app = open_box()\n\tapp:click('\"Open tiny.png\"')\n\tapp:frames(90)\n\tlocal v = view(app)\n\texpect(v.fitted).to_be(true)\n\texpect(near(v.s, 1)).to_be(true)\n\texpect(v.w).to_be(64)\nend)\n\ntest(\"with motion reduced (Keiki's own setting), it opens and closes as a short crossfade, nothing travelling\", function()\n\tlocal app = open_box()\n\tapp:set_state(\"ds/motion.luau::motion_reduce\", true)\n\tapp:frames(5)\n\tapp:click('\"Open night.jpg\"')\n\tapp:frames(2)\n\tlocal v = view(app)\n\texpect(v.morphing).to_be(false)\n\t-- (A crossfade of at most ds/motion's 120 ms: done within a few frames.)\n\tapp:frames(20)\n\tv = view(app)\n\texpect(v.alpha).to_be(1)\n\texpect(v.lift).to_be(1)\n\texpect(v.fitted).to_be(true)\n\tapp:key(\"Escape\")\n\tapp:frames(2)\n\texpect(view(app).morphing).to_be(false)\n\tapp:frames(30)\n\texpect(app:state(\"ds/lightbox.luau::open\")).to_be_nil()\n\texpect(line_of(app, 'button \"Open night.jpg\"')).to_contain(\"focused\")\n\tapp:set_state(\"ds/motion.luau::motion_reduce\", false)\nend)\n\ntest(\"with motion as it is, it grows out of the thumbnail\", function()\n\tlocal app = open_box()\n\tapp:click('\"Open night.jpg\"')\n\tapp:frames(2)\n\texpect(view(app).morphing).to_be(true)\n\tapp:frames(60)\n\texpect(view(app).morphing).to_be(false)\nend)\n\n-- The picture's box (its laid-out width and height) in the stage, by name.\nlocal function picture_box(app: any, name: string): (number, number)\n\tfor line in app:tree():gmatch(\"[^\\n]+\") do\n\t\tif line:find(`img \"{name}\"`, 1, true) then\n\t\t\tlocal w, h = line:match(\" ([%d.]+)x([%d.]+)\")\n\t\t\treturn tonumber(w) or 0, tonumber(h) or 0\n\t\tend\n\tend\n\treturn 0, 0\nend\n\ntest(\"a picture is never stretched or squeezed as it grows from its thumbnail and goes back, even when its size was said wrong\", function()\n\tlocal app = open_box()\n\t-- 868 by 617, said as 400 by 400.\n\tlocal want = 868 / 617\n\tapp:click('\"Open stale.png\"')\n\tlocal seen = 0\n\tfor _ = 1, 40 do\n\t\tapp:frames(1)\n\t\tlocal w, h = picture_box(app, \"stale.png\")\n\t\tif w > 0 and h > 0 then\n\t\t\tseen += 1\n\t\t\texpect(math.abs(w / h - want) / want < 0.01).to_be(true)\n\t\tend\n\tend\n\texpect(seen > 0).to_be(true)\n\tapp:key(\"Escape\")\n\tfor _ = 1, 40 do\n\t\tapp:frames(1)\n\t\tlocal w, h = picture_box(app, \"stale.png\")\n\t\tif w > 0 and h > 0 then\n\t\t\texpect(math.abs(w / h - want) / want < 0.01).to_be(true)\n\t\tend\n\tend\nend)\n\ntest(\"zooming never leaves a frame without the picture: what the window showed is held under it, exactly where it is\", function()\n\tlocal app = open_box()\n\tapp:command(\"test.lightbox_snapshots\")\n\tapp:click('\"Open night.jpg\"')\n\tapp:frames(90)\n\tlocal before = view(app)\n\texpect(before.fitted).to_be(true)\n\t-- In, step by step, and back out: through every frame of each motion,\n\t-- a picture of what showed is under the picture, scaled with it, its\n\t-- corner on the picture's.\n\tfor _, keys in { \"cmd+=\", \"cmd+=\", \"cmd+-\", \"cmd+0\" } do\n\t\tapp:key(keys)\n\t\tfor _ = 1, 20 do\n\t\t\tapp:frames(1)\n\t\t\tlocal v = view(app)\n\t\t\texpect(v.under).never.to_be_nil()\n\t\t\texpect(math.abs(v.under.corner_x - v.under.pic_x) < 1).to_be(true)\n\t\t\texpect(math.abs(v.under.corner_y - v.under.pic_y) < 1).to_be(true)\n\t\t\texpect(v.under.w > 0 and v.under.h > 0).to_be(true)\n\t\tend\n\tend\nend)\n",
		["apps/zgx/ui/tests/markdown_table.test.luau"] = "-- A reply's tables (ds/markdown): they fit the reply's column whenever they\n-- can, wrapping prose and keeping short columns whole, and scroll sideways\n-- only when they can't, by a trackpad's swipe, Shift and the wheel, or the\n-- wheel itself once the pointer has been moved onto the table. The page\n-- around them keeps its own scrolling. (table_fixture.luau.)\n\n-- A node's box, from the tree's first line: `@n … x,y WxH`.\nlocal function box(app: any, target: string): { x: number, y: number, w: number, h: number }\n\tlocal x, y, w, h = app:tree(target):match(\"^%s*@%d+[^\\n]- ([%-%d.]+),([%-%d.]+) ([%d.]+)x([%d.]+)\")\n\treturn { x = tonumber(x) :: number, y = tonumber(y) :: number, w = tonumber(w) :: number, h = tonumber(h) :: number }\nend\n\nlocal function only(name: string, width: number?): any\n\tlocal app = mount(\"table_fixture.luau\")\n\tapp:resize(960, 640)\n\tapp:command(`only_{name}`)\n\tapp:command(`width_{width or 760}`)\n\tapp:frames(10)\n\texpect(app:error()).to_be_nil()\n\treturn app\nend\n\n-- A cell's words, in reading order with the header first: `count` columns\n-- a row.\nlocal function words(app: any, count: number, r: number, c: number): { x: number, y: number, w: number, h: number }\n\treturn box(app, `.md-text >> [{r * count + c}]`)\nend\n-- How far a table's content has moved sideways (its first words start a\n-- border and a cell's padding in), and the page down.\nlocal function across(app: any): number\n\treturn box(app, \".md-table\").x + 17 - words(app, 1, 0, 1).x\nend\nlocal function down(app: any): number\n\treturn -box(app, \"#reply\").y\nend\n-- How far it can move: where its last header ends, past where the view does.\n-- (The tree's sizes are rounded: within a point counts as there.)\nlocal function room(app: any, count: number): number\n\tlocal view, last = box(app, \".md-table\"), words(app, 1, 0, count)\n\treturn last.x + last.w + 16 + across(app) - (view.x + view.w - 1)\nend\nlocal function near(a: number, b: number)\n\texpect(math.abs(a - b) <= 1.5).to_be(true)\nend\n\n-- Past the time a gesture holds on to what it scrolled.\nlocal function pause(app: any)\n\tapp:wait(\"#never-shown\", { timeout_ms = 360 })\n\tapp:frames(2)\nend\n\nlocal function fits(app: any, count: number)\n\texpect(room(app, count) <= 1).to_be(true)\nend\n\ntest(\"table: two columns of prose fit the reply, wrapped, rather than running out of it\", function()\n\tlocal app = only(\"two\")\n\tfits(app, 2)\n\t-- Wrapped: a row taller than the header's one line…\n\texpect(words(app, 2, 1, 1).h > words(app, 2, 0, 1).h).to_be(true)\n\t-- …and each column has a real share of the width.\n\tlocal whole = box(app, \".md-table\").w\n\texpect(words(app, 2, 1, 1).w > whole * 0.3).to_be(true)\n\texpect(words(app, 2, 1, 2).w > whole * 0.3).to_be(true)\nend)\n\ntest(\"table: a 30-character label beside prose fits the reply at its widths, wrapped\", function()\n\tfor _, width in { 480, 620, 760 } do\n\t\tlocal app = only(\"running\", width)\n\t\tfits(app, 2)\n\t\t-- The prose wrapped inside the view, not past it.\n\t\tlocal view, prose = box(app, \".md-table\"), words(app, 2, 1, 2)\n\t\texpect(prose.x + prose.w <= view.x + view.w).to_be(true)\n\t\texpect(prose.h > words(app, 2, 0, 2).h).to_be(true)\n\tend\nend)\n\ntest(\"table: the same table scrolls, rather than clips, once its columns' least widths can't fit\", function()\n\tlocal app = only(\"running\", 280)\n\t-- (Its prose runs past the view: the header's words end inside it.)\n\tlocal view, prose = box(app, \".md-table\"), words(app, 2, 1, 2)\n\texpect(prose.x + prose.w + 16 > view.x + view.w).to_be(true)\n\tapp:wheel(\".md-table\", { dy = 40, mouse = true, shift = true })\n\texpect(across(app)).to_be(40)\n\texpect(down(app)).to_be(0)\nend)\n\ntest(\"table: short columns keep to one line and the prose beside them takes the rest\", function()\n\tlocal app = only(\"mixed\")\n\tfits(app, 4)\n\t-- The notes wrapped; the labels and numbers beside them didn't: their\n\t-- words are as tall as the header's one line, in a row the notes made\n\t-- taller.\n\tlocal line = words(app, 4, 0, 1).h\n\texpect(words(app, 4, 1, 4).h > line).to_be(true)\n\texpect(words(app, 4, 1, 1).h).to_be(line)\n\texpect(words(app, 4, 1, 2).h).to_be(line)\n\texpect(words(app, 4, 1, 3).h).to_be(line)\nend)\n\ntest(\"table: a table narrower than the reply still runs its rules to its frame\", function()\n\tlocal app = only(\"loose\")\n\t-- Its prose column takes what the words leave, so the numbers, on their\n\t-- cells' right edges, end as far in from the frame's right as the first\n\t-- words start from its left: the cells, and the rules under them, reach\n\t-- the frame.\n\tlocal frame, first, last = box(app, \".md-table\"), words(app, 2, 0, 1), words(app, 2, 3, 2)\n\tnear(frame.x + frame.w - (last.x + last.w), first.x - frame.x)\nend)\n\ntest(\"table: a column of numbers sits on its right edge, whether the source says so or not\", function()\n\tlocal app = only(\"mixed\")\n\t-- `Size` says `---:`, `Change` too; each number's right edge is its\n\t-- header's, whatever their widths.\n\tlocal head, number = words(app, 4, 0, 2), words(app, 4, 1, 2)\n\tnear(head.x + head.w, number.x + number.w)\n\texpect(head.w ~= number.w).to_be(true)\n\t-- `Build` has no numbers, and starts on its left.\n\tnear(words(app, 4, 0, 1).x, words(app, 4, 1, 1).x)\nend)\n\ntest(\"table: a column of numbers the source doesn't mark sits on its right too\", function()\n\tlocal app = only(\"many\")\n\tlocal head, number = words(app, 8, 0, 4), words(app, 8, 1, 4)\n\tnear(head.x + head.w, number.x + number.w)\n\tnear(words(app, 8, 0, 1).x, words(app, 8, 1, 1).x)\nend)\n\ntest(\"table: too many columns to fit keep their words whole and scroll\", function()\n\tlocal app = only(\"many\")\n\texpect(room(app, 8) > 0).to_be(true)\n\t-- Not squeezed to a word a line first: its short cells keep to a line.\n\texpect(words(app, 8, 1, 1).h).to_be(words(app, 8, 0, 1).h)\nend)\n\ntest(\"table: code that can't break scrolls, and the table says so\", function()\n\tlocal app = only(\"code\")\n\tlocal view, code = box(app, \".md-table\"), words(app, 2, 1, 2)\n\texpect(code.x + code.w > view.x + view.w).to_be(true)\nend)\n\ntest(\"table: a narrow window wraps what it can before scrolling\", function()\n\tlocal app = only(\"two\", 360)\n\tfits(app, 2)\nend)\n\ntest(\"table: a table that fits never takes the wheel\", function()\n\tlocal app = only(\"two\")\n\tapp:hover(\".md-table\")\n\tapp:wheel(\".md-table\", { dy = 80, mouse = true })\n\texpect(across(app)).to_be(0)\n\texpect(down(app) > 0).to_be(true)\nend)\n\ntest(\"table: a trackpad's swipe moves the table, its drift downward included, and not the page\", function()\n\tlocal app = only(\"many\")\n\tfor _ = 1, 6 do\n\t\tapp:wheel(\".md-table\", { dx = 12, dy = 2 })\n\tend\n\texpect(across(app)).to_be(72)\n\texpect(down(app)).to_be(0)\nend)\n\ntest(\"table: a trackpad's swipe down moves the page, and the table not at all\", function()\n\tlocal app = only(\"many\")\n\tfor _ = 1, 4 do\n\t\tapp:wheel(\".md-table\", { dx = 2, dy = 12 })\n\tend\n\texpect(across(app)).to_be(0)\n\texpect(down(app)).to_be(48)\nend)\n\ntest(\"table: a sideways moment in a swipe down leaves the table alone\", function()\n\tlocal app = only(\"many\")\n\tapp:wheel(\".md-table\", { dy = 12 })\n\tapp:wheel(\".md-table\", { dx = 3, dy = 1 })\n\tapp:wheel(\".md-table\", { dy = 12 })\n\texpect(across(app)).to_be(0)\n\texpect(down(app)).to_be(25)\nend)\n\ntest(\"table: a trackpad's straight swipe down over a wide table is the page's, pointer moved or not\", function()\n\tlocal app = only(\"many\")\n\tapp:hover(\".md-table\")\n\tapp:wheel(\".md-table\", { dy = 40 })\n\texpect(across(app)).to_be(0)\n\texpect(down(app)).to_be(40)\nend)\n\ntest(\"table: the wheel moves a table the pointer was moved onto, then the page at its end\", function()\n\tlocal app = only(\"many\")\n\tlocal room0 = room(app, 8)\n\tapp:hover(\".md-table\")\n\tapp:wheel(\".md-table\", { dy = 40, mouse = true })\n\texpect(across(app)).to_be(40)\n\texpect(down(app)).to_be(0)\n\t-- On to its end, where it stops: a fling doesn't run on into the page…\n\tfor _ = 1, 40 do\n\t\tapp:wheel(\".md-table\", { dy = 40, mouse = true })\n\tend\n\tnear(across(app), room0)\n\texpect(down(app)).to_be(0)\n\t-- …and the wheel, turned again after a moment, moves the page.\n\tpause(app)\n\tapp:wheel(\".md-table\", { dy = 40, mouse = true })\n\texpect(down(app)).to_be(40)\nend)\n\ntest(\"table: the wheel going back up at a table's start is the page's at once\", function()\n\tlocal app = only(\"many\")\n\tapp:hover(\"#below\")\n\tapp:wheel(\"#below\", { dy = 100 })\n\tpause(app)\n\tapp:hover(\".md-table\")\n\tapp:wheel(\".md-table\", { dy = -40, mouse = true })\n\texpect(across(app)).to_be(0)\n\texpect(down(app)).to_be(60)\nend)\n\ntest(\"table: a table that scrolled under a resting pointer leaves the wheel to the page\", function()\n\tlocal app = only(\"many\")\n\t-- The pointer on the page just below the table, then the table brought\n\t-- under it by scrolling; a pause, as one reading would.\n\tapp:hover(\"#below\")\n\tapp:wheel(\"#below\", { dy = 80 })\n\tpause(app)\n\tlocal before = down(app)\n\tapp:wheel(\".md-table\", { dy = 40, mouse = true })\n\texpect(across(app)).to_be(0)\n\texpect(down(app)).to_be(before + 40)\nend)\n\ntest(\"table: a gesture on the page stays the page's as a table slides under it\", function()\n\tlocal app = only(\"many\")\n\tapp:hover(\"#below\")\n\tapp:wheel(\"#below\", { dy = 40, mouse = true })\n\tapp:wheel(\".md-table\", { dy = 40, mouse = true })\n\texpect(across(app)).to_be(0)\n\texpect(down(app)).to_be(80)\nend)\n\ntest(\"table: Shift and the wheel move the table sideways, and never the page\", function()\n\tlocal app = only(\"many\")\n\tlocal room0 = room(app, 8)\n\t-- With no pointer move: Shift says what's meant by itself.\n\tapp:wheel(\".md-table\", { dy = 40, mouse = true, shift = true })\n\texpect(across(app)).to_be(40)\n\texpect(down(app)).to_be(0)\n\tfor _ = 1, 40 do\n\t\tapp:wheel(\".md-table\", { dy = 40, mouse = true, shift = true })\n\tend\n\tnear(across(app), room0)\n\texpect(down(app)).to_be(0)\nend)\n\ntest(\"table: Shift's wheel on a Mac, which arrives as motion sideways, moves it too\", function()\n\tlocal app = only(\"many\")\n\tapp:wheel(\".md-table\", { dx = 40, mouse = true, shift = true })\n\texpect(across(app)).to_be(40)\n\texpect(down(app)).to_be(0)\nend)\n\ntest(\"table: a data table's long header wraps, whole, rather than being cut\", function()\n\tlocal app = only(\"data\", 360)\n\tlocal narrow = box(app, \".data-table-head\")\n\texpect(narrow.h > 44).to_be(true)\n\texpect(app:has('~\"Allocations per streamed token\"')).to_be(true)\nend)\n\ntest(\"table: words the source sets on their right sit there\", function()\n\tlocal app = only(\"said\")\n\tlocal head, free, team = words(app, 2, 0, 1), words(app, 2, 1, 1), words(app, 2, 2, 1)\n\tnear(head.x + head.w, free.x + free.w)\n\tnear(head.x + head.w, team.x + team.w)\n\texpect(free.x > team.x).to_be(true)\nend)\n\n-- Every text box in the table: its right edge.\nlocal function ends(app: any): { number }\n\tlocal out = {}\n\tfor line in app:tree(\".md-table\"):gmatch(\"[^\\n]+\") do\n\t\tlocal x, w = line:match('text \".-\" ([%-%d.]+),[%-%d.]+ ([%d.]+)x[%d.]+')\n\t\tif x then\n\t\t\ttable.insert(out, tonumber(x) :: number + tonumber(w) :: number)\n\t\tend\n\tend\n\treturn out\nend\nlocal function furthest(app: any): number\n\tlocal most = -math.huge\n\tfor _, e in ends(app) do\n\t\tmost = math.max(most, e)\n\tend\n\treturn most\nend\n\n-- Each table, at a narrow and a usual reply width: every word in it is one\n-- the frame shows or can be scrolled to. Scrolled to its end, no text runs\n-- past the frame's inside; one that ran past it at rest means the table\n-- has room to scroll. (Nov 10, beta.4: a 38-character label beside prose\n-- laid its grid out wider than the box the scroll measures, so the prose\n-- was cut at the frame with nothing to scroll: `status`.)\ntest(\"table: every word is in view or can be scrolled to, at any width\", function()\n\tfor _, name in { \"status\", \"running\", \"two\", \"mixed\", \"many\", \"code\", \"said\", \"loose\" } do\n\t\tfor _, width in { 280, 360, 400, 480, 560, 620, 680, 760, 860 } do\n\t\t\tlocal app = mount(\"table_fixture.luau\")\n\t\t\t-- (Tall enough that the wheel, aimed at the table's middle, lands\n\t\t\t-- in the window.)\n\t\t\tapp:resize(960, 2400)\n\t\t\tapp:command(`only_{name}`)\n\t\t\tapp:command(`width_{width}`)\n\t\t\tapp:frames(10)\n\t\t\texpect(app:error()).to_be_nil()\n\t\t\tlocal view = box(app, \".md-table\")\n\t\t\tlocal inside = view.x + view.w - 1\n\t\t\tlocal rest = furthest(app)\n\t\t\tfor _ = 1, 60 do\n\t\t\t\tapp:wheel(\".md-table\", { dy = 40, mouse = true, shift = true })\n\t\t\tend\n\t\t\tapp:frames(4)\n\t\t\tlocal at = `{name} at {width}`\n\t\t\tlocal now = furthest(app)\n\t\t\texpect(`{at}: ends {now}`).to_be(`{at}: ends {math.min(now, inside + 1)}`)\n\t\t\t-- (Past the frame at rest: the table had room to move, as far as\n\t\t\t-- its words ran past it.)\n\t\t\tif rest > inside + 1 then\n\t\t\t\texpect(`{at}: moved {now < rest}`).to_be(`{at}: moved true`)\n\t\t\tend\n\t\tend\n\tend\nend)\n\ntest(\"table: the status table fits a usual reply, its prose wrapped beside its labels\", function()\n\tlocal app = only(\"status\")\n\tfits(app, 2)\n\tlocal view = box(app, \".md-table\")\n\tfor _, e in ends(app) do\n\t\texpect(e <= view.x + view.w - 1).to_be(true)\n\tend\n\t-- The prose wraps beside its labels.\n\texpect(words(app, 2, 5, 2).h > words(app, 2, 0, 2).h).to_be(true)\nend)\n\ntest(\"table: in a chat, a reply's status table keeps its prose inside its frame\", function()\n\tlocal app = mount(\"chat_fixture.luau\")\n\tapp:resize(960, 800)\n\tapp:frames(20)\n\tapp:command(\"status_table\")\n\tapp:command(\"go_s7\")\n\tapp:frames(30)\n\tapp:wait(\"#never-shown\", { timeout_ms = 250 })\n\tapp:frames(10)\n\texpect(app:error()).to_be_nil()\n\tlocal view = box(app, \".md-table\")\n\tlocal list = ends(app)\n\texpect(#list).to_be(12)\n\tfor _, e in list do\n\t\texpect(e <= view.x + view.w - 1).to_be(true)\n\tend\nend)\n",
		["apps/zgx/ui/tests/mentions.test.luau"] = "-- The composer's mentions (ds/mention_tokens, the words' side of\n-- ds/composer_mentions): the token the caret is in, and what a pick puts\n-- in its place. Run with `zgx test ui`.\n\nlocal mentions = require(\"@ds/mention_tokens\")\n\nlocal FILES: { mentions.Item } = {\n\t{ value = \"crates/ui/src/queue.rs\", label = \"queue.rs\", file = true },\n\t{ value = \"crates/engine/tests/message_queue.rs\", label = \"message_queue.rs\", file = true },\n\t{ value = \"apps/zgx/ui/ds/init.luau\", label = \"init.luau\", file = true },\n\t{ value = \"apps/zgx/ui/screens/onboarding/init.luau\", label = \"init.luau\", file = true },\n}\nlocal COMMANDS: { mentions.Item } = {\n\t{ value = \"commit\", label = \"/commit\" },\n\t{ value = \"compact\", label = \"/compact\" },\n}\nlocal SKILLS: { mentions.Item } = {\n\t{ value = \"code-review\", label = \"Code review\" },\n\t{ value = \"release\", label = \"Release\" },\n}\nlocal SOURCES: mentions.Sources = { [\"@\"] = FILES, [\"/\"] = COMMANDS, [\"$\"] = SKILLS }\nlocal MESSAGE_QUEUE = FILES[2]\n\n-- A pick with the caret at `caret` (bytes from 0) in `text`: the text\n-- after it.\nlocal function picked(text: string, caret: number, item: mentions.Item): string\n\tlocal from, to, replacement = mentions.pick(text, caret, item, SOURCES)\n\tassert(from and to and replacement, \"no token at the caret\")\n\treturn string.sub(text, 1, from) .. replacement .. string.sub(text, to + 1)\nend\n\ntest(\"the token runs from its trigger to its end, past the caret\", function()\n\tlocal text = \"Compare @queue.rs with\"\n\t-- The caret after \"@que\": the query is what was typed, the token all of it.\n\tlocal t = mentions.token(text, 12)\n\texpect(t).to_be_truthy()\n\tassert(t, \"no token at the caret\")\n\texpect(t.trigger).to_be(\"@\")\n\texpect(t.query).to_be(\"que\")\n\texpect(t.from).to_be(8)\n\texpect(t.to).to_be(17)\nend)\n\ntest(\"a pick replaces the whole token, caret at its end, middle or start\", function()\n\tlocal text = \"Compare @queue.rs with\"\n\texpect(picked(text, 17, MESSAGE_QUEUE)).to_be(\"Compare @message_queue.rs with\")\n\texpect(picked(text, 12, MESSAGE_QUEUE)).to_be(\"Compare @message_queue.rs with\")\n\texpect(picked(text, 9, MESSAGE_QUEUE)).to_be(\"Compare @message_queue.rs with\")\nend)\n\ntest(\"a pick adds one space, never a second\", function()\n\texpect(picked(\"Read @que\", 9, MESSAGE_QUEUE)).to_be(\"Read @message_queue.rs \")\n\texpect(picked(\"Read @que then\", 9, MESSAGE_QUEUE)).to_be(\"Read @message_queue.rs then\")\nend)\n\ntest(\"two tokens side by side: only the one the caret is in changes\", function()\n\tlocal text = \"@queue.rs @init.luau\"\n\texpect(picked(text, 4, MESSAGE_QUEUE)).to_be(\"@message_queue.rs @init.luau\")\n\t-- The last token, at the draft's end: a space follows the pick.\n\texpect(picked(text, 14, FILES[1])).to_be(\"@queue.rs @queue.rs \")\nend)\n\ntest(\"commands and skills replace to their end too\", function()\n\texpect(picked(\"then $code-review it\", 9, SKILLS[2])).to_be(\"then $release it\")\n\texpect(picked(\"and /commit now\", 8, COMMANDS[2])).to_be(\"and /compact now\")\n\t-- A command's run stops at a slash: `/co` inside a path is no command.\n\texpect(mentions.token(\"see /usr/bin\", 12)).to_be_nil()\n\texpect(mentions.token(\"costs $12\", 7)).to_be_nil()\nend)\n\ntest(\"a token on a draft's later line, and none in a fence, however long the draft\", function()\n\tlocal head = string.rep(\"a line of the draft before it\\n\", 3000)\n\tlocal text = head .. \"Compare @queue.rs with\"\n\tlocal t = mentions.token(text, #head + 12)\n\tassert(t, \"no token at the caret\")\n\texpect(t.query).to_be(\"que\")\n\texpect(t.from).to_be(#head + 8)\n\texpect(t.to).to_be(#head + 17)\n\texpect(picked(text, #head + 12, MESSAGE_QUEUE)).to_be(head .. \"Compare @message_queue.rs with\")\n\t-- A fence opened (after blanks): nothing in it; closed, a token again.\n\tlocal fence = head .. \"  ```lua\\n@queue\"\n\texpect(mentions.token(fence, #fence)).to_be_nil()\n\tlocal closed = fence .. \"\\nnot a ``` fence\\n```\\n/com\"\n\tlocal c = mentions.token(closed, #closed)\n\tassert(c, \"no command after the fence\")\n\texpect(c.trigger).to_be(\"/\")\n\texpect(c.query).to_be(\"com\")\n\texpect(c.from).to_be(#closed - 4)\nend)\n\ntest(\"a file is named by the shortest end of its path that is its own\", function()\n\texpect(mentions.short(FILES, FILES[1])).to_be(\"queue.rs\")\n\texpect(mentions.short(FILES, FILES[2])).to_be(\"message_queue.rs\")\n\texpect(mentions.short(FILES, FILES[3])).to_be(\"ds/init.luau\")\n\texpect(mentions.short(FILES, FILES[4])).to_be(\"onboarding/init.luau\")\nend)\n\ntest(\"the draft's highlight styles a token in type alone\", function()\n\tlocal spans = mentions.highlight(\"Read @queue.rs and /commit\", 0)\n\tlocal glyphs, names = 0, 0\n\t-- A span is `{ from, to, color }` with its faces as fields too.\n\tfor _, span in spans do\n\t\tlocal s = span :: { [number]: any, weight: number?, bg: string? }\n\t\tif s[3] == \"$zeron.composer.token.trigger\" then\n\t\t\tglyphs += 1\n\t\telseif s.weight == 500 then\n\t\t\tnames += 1\n\t\t\texpect(s.bg).to_be_nil()\n\t\tend\n\tend\n\texpect(glyphs).to_be(2)\n\texpect(names).to_be(2)\nend)\n",
		["apps/zgx/ui/tests/model_picker_motion.test.luau"] = "-- The model picker's motion, on the picker in ui/picker_fixture.luau: its\n-- panel is never see-through (opening, opening out, folding back, following\n-- its trigger), opening out and folding back change its size once (the\n-- panel is a popup window: a size eased over frames resized it on every\n-- one), Escape folds it back from whatever in it has the keys, and the\n-- reasoning thumb is where the pointer is, not springing after it.\n\nlocal function settle(app: any)\n\tapp:frames(30)\nend\n\n-- A node's box (x, y, w, h), from its tree line.\nlocal function box(app: any, target: string): (number, number, number, number)\n\tlocal line = app:tree(target):match(\"[^\\n]+\") or \"\"\n\tlocal x, y, w, h = line:match(\"(%-?[%d%.]+),(%-?[%d%.]+) ([%d%.]+)x([%d%.]+)\")\n\treturn tonumber(x) or -1, tonumber(y) or -1, tonumber(w) or -1, tonumber(h) or -1\nend\nlocal function height(app: any): number\n\tlocal _, _, _, h = box(app, \"role:dialog\")\n\treturn h\nend\nlocal function alpha(app: any): { panel: number, fold: number }\n\treturn app:state(\"test_picker_alpha\") :: any\nend\nlocal function watch(app: any)\n\tapp:set_state(\"test_picker_alpha\", { panel = 1, fold = 0 })\nend\n-- Whether the panel shows (not only laid out, hidden, as a closed one is).\nlocal function listed(app: any): boolean\n\tfor line in app:tree():gmatch(\"[^\\n]+\") do\n\t\tif line:find(\" dialog \", 1, true) and not line:find(\" hidden\", 1, true) then\n\t\t\treturn true\n\t\tend\n\tend\n\treturn false\nend\n\nlocal function opened(app: any)\n\tapp:resize(600, 700)\n\tsettle(app)\n\twatch(app)\n\tapp:click('role:button \"Model\"')\n\tsettle(app)\nend\n\ntest(\"the picker opens, opens out and folds back solid, its size changing once\", function()\n\tlocal app = mount(\"picker_fixture.luau\")\n\topened(app)\n\tlocal folded_h = height(app)\n\texpect(alpha(app).panel).to_be(1)\n\n\t-- Opened out: its whole size the first frame, nothing in it fading in.\n\tapp:click(\".folded\")\n\tapp:frames(1)\n\tlocal out_h = height(app)\n\texpect(out_h > folded_h).to_be(true)\n\tsettle(app)\n\texpect(height(app)).to_be(out_h)\n\texpect(alpha(app).panel).to_be(1)\n\texpect(alpha(app).fold).to_be(0)\n\n\t-- Folded back (Escape): its folded size the first frame.\n\tapp:key(\"Escape\")\n\tapp:frames(1)\n\texpect(height(app)).to_be(folded_h)\n\tsettle(app)\n\texpect(height(app)).to_be(folded_h)\n\texpect(alpha(app).panel).to_be(1)\n\texpect(alpha(app).fold).to_be(0)\n\texpect(listed(app)).to_be(true)\nend)\n\ntest(\"the panel stays solid as its trigger moves\", function()\n\tlocal app = mount(\"picker_fixture.luau\")\n\topened(app)\n\tapp:click(\".folded\")\n\tsettle(app)\n\twatch(app)\n\tlocal _, y0 = box(app, \"role:dialog\")\n\tapp:set_state(\"test_picker_above\", 80)\n\tsettle(app)\n\tlocal _, y1 = box(app, \"role:dialog\")\n\texpect(y1 - y0).to_be(80)\n\tapp:set_state(\"test_picker_above\", 0)\n\tsettle(app)\n\texpect(alpha(app).panel).to_be(1)\n\texpect(alpha(app).fold).to_be(0)\nend)\n\n-- Escape folds an opened-out picker back whatever in it has the keys (it\n-- reached the popover from the slider or a tab, which closed it).\ntest(\"Escape folds the opened-out picker back from the slider and the tabs\", function()\n\tlocal app = mount(\"picker_fixture.luau\")\n\topened(app)\n\tlocal folded_h = height(app)\n\tfor _, target in { 'role:group \"REASONING\"', 'role:tab \"Mock\"' } do\n\t\tapp:click(\".folded\")\n\t\tsettle(app)\n\t\tapp:click(target)\n\t\tsettle(app)\n\t\tapp:key(\"Escape\")\n\t\tsettle(app)\n\t\texpect(`{target}: open {listed(app)}`).to_be(`{target}: open true`)\n\t\t-- Folded on the chosen model, in its agent's tab.\n\t\texpect(`{target}: {height(app)}`).to_be(`{target}: {folded_h}`)\n\tend\n\t-- Folded, Escape closes it.\n\tapp:key(\"Escape\")\n\tsettle(app)\n\texpect(listed(app)).to_be(false)\nend)\n\n-- A press on the chip of an open picker closes it (it put it back folded,\n-- the tab and search lost, as if opened anew).\ntest(\"the chip of an open picker closes it rather than folding it\", function()\n\tlocal app = mount(\"picker_fixture.luau\")\n\topened(app)\n\tapp:click(\".folded\")\n\tsettle(app)\n\tapp:click('role:button \"Model\"')\n\tsettle(app)\n\texpect(listed(app)).to_be(false)\n\t-- And opens it again, folded.\n\tapp:click('role:button \"Model\"')\n\tsettle(app)\n\texpect(listed(app)).to_be(true)\nend)\n\n-- Dragged, the thumb is where the pointer is (set as it moves, not sprung\n-- after the level), and the value is the level it is let go over, set as\n-- it is let go.\ntest(\"the reasoning thumb follows the pointer, the frame it moves\", function()\n\tlocal app = mount(\"picker_fixture.luau\")\n\tapp:set_state(\"test_picker_effort\", \"low\")\n\topened(app)\n\t-- Where the thumb sits (its left, along the groove) at a fraction of\n\t-- the way: the groove's 2-point inset, the thumb 18 wide.\n\tlocal _, _, gw = box(app, 'role:group \"REASONING\"')\n\tlocal function at(f: number): number\n\t\treturn 2 + math.floor(f * (gw - 4 - 18) + 0.5)\n\tend\n\texpect(app:state(\"test_picker_thumb\")).to_be(at(0))\n\t-- From Low (the groove's start) to its middle, Medium: the thumb there\n\t-- the frame it's let go (it sprang after the level, a frame on still\n\t-- most of the way back).\n\tapp:drag('role:group \"REASONING\"', 'role:group \"REASONING\"')\n\tapp:frames(1)\n\texpect(app:state(\"test_picker_thumb\")).to_be(at(0.5))\n\texpect(app:state(\"test_picker_effort\")).to_be(\"medium\")\n\tsettle(app)\n\texpect(app:state(\"test_picker_thumb\")).to_be(at(0.5))\nend)\n\n-- A new chat's composer, mid-page, grows down as its draft grows: its chip\n-- held while its model picker is open (and the picker hanging from it, still),\n-- it goes to its place as the picker closes. (On ui/chat_fixture.luau.)\ntest(\"a new chat's composer holds still under its open model picker\", function()\n\tlocal app = mount(\"chat_fixture.luau\")\n\tapp:resize(960, 760)\n\tapp:command(\"go_home\")\n\tsettle(app)\n\tlocal function chip_y(): number\n\t\tlocal _, y = box(app, '#chat-composer >> role:button \"Model\"')\n\t\treturn y\n\tend\n\tlocal before = chip_y()\n\tapp:click('#chat-composer >> role:button \"Model\"')\n\tsettle(app)\n\texpect(listed(app)).to_be(true)\n\tlocal _, panel_y = box(app, \"role:dialog\")\n\tapp:set_state(\"chat.composer.text\", \"one\\ntwo\\nthree\\nfour\")\n\tsettle(app)\n\texpect(chip_y()).to_be(before)\n\tlocal _, panel_now = box(app, \"role:dialog\")\n\texpect(panel_now).to_be(panel_y)\n\t-- Closed: to its place (lower, as it grew down).\n\tapp:key(\"Escape\")\n\tsettle(app)\n\texpect(listed(app)).to_be(false)\n\texpect(chip_y() > before).to_be(true)\n\tapp:set_state(\"chat.composer.text\", \"\")\n\tsettle(app)\nend)\n",
		["apps/zgx/ui/tests/open_links.test.luau"] = "-- \"Open links in Keiki\": a web link in a reply goes to the app's opener\n-- (the shell's: the panel's browser tab) when one is set, and to the system\n-- otherwise; a file link is never the opener's. On ui/chat_fixture.luau.\n\ntest(\"a web link in a reply goes to the app's opener once one is set\", function()\n\tlocal app = mount(\"chat_fixture.luau\")\n\tapp:resize(900, 700)\n\tapp:command(\"go_s2\")\n\tapp:frames(30)\n\tapp:command(\"set_opener\")\n\tapp:command(\"link_turn\")\n\tapp:frames(30)\n\tapp:click('role:link \"the docs\"')\n\tapp:frames(5)\n\texpect(app:state(\"calls\")).to_contain(\"opener:https://example.com/a.rs\")\n\texpect(app:state(\"links_last\")).to_be(\"app:https://example.com/a.rs\")\n\t-- A prompt's web link too (the user's bubble, ds/user_message).\n\tapp:click('role:link \"the site\"')\n\tapp:frames(5)\n\texpect(app:state(\"calls\")).to_contain(\"opener:https://example.com/\")\n\texpect(app:state(\"links_last\")).to_be(\"app:https://example.com/\")\n\t-- A file link is the panel's, not the opener's.\n\tapp:click('role:link \"the parser\"')\n\tapp:frames(5)\n\texpect(app:state(\"calls\")).to_contain(\"open_file:s2:src/parse.rs\")\n\texpect(app:state(\"links_last\")).to_be(\"app:https://example.com/\")\nend)\n",
		["apps/zgx/ui/tests/panel_widths.test.luau"] = "-- A plugin's page's panel and a session's are one width: a plugin's page\n-- has no tree, so its panel takes all of the width a session's gives its\n-- tree and its tabs, at least the panel's least. (It took a tree's width\n-- off there too, opening narrower than a session's, often under its least:\n-- screens/shell/page `reserve`.) Opened on either, resized on either, the\n-- other follows. On the shell in ui/shell_fixture.luau (`plugin_page`\n-- opens a plugin's page; no plugin draws it).\n\n-- The panel's least (screens/shell/fit_policy's RIGHT_PANE_MIN).\nlocal RIGHT_PANE_MIN = 360\n\nlocal function width(app: any): number\n\tlocal line = app:tree(\"#shell-files\"):match(\"[^\\n]+\")\n\treturn tonumber(line:match(\" %-?%d+,%-?%d+ (%d+)x%d+\")) :: number\nend\nlocal function route(app: any): string\n\treturn tostring(app:state(\"shell_route_path\"))\nend\nlocal function open_panel(app: any)\n\tapp:click('#titlebar >> role:button \"Panel\"')\n\tapp:frames(60)\nend\n-- Its edge from the keys (a step each, ⇧ four), as a drag sets it.\nlocal function widen(app: any, steps: number)\n\tapp:click('role:slider \"Resize files\"')\n\tapp:frames(5)\n\tfor _ = 1, steps do\n\t\tapp:key(\"shift+ArrowLeft\")\n\tend\n\tapp:frames(40)\nend\n\ntest(\"a plugin's page's panel opens as wide as a session's, and resized on either the other follows\", function()\n\tlocal app = mount(\"shell_fixture.luau\")\n\tapp:resize(1400, 800)\n\tapp:frames(30)\n\t-- A session's panel, its tree docked.\n\tapp:click('#shell-sidebar >> role:button \"Fix the build\"')\n\tapp:frames(20)\n\topen_panel(app)\n\texpect(width(app) >= RIGHT_PANE_MIN).to_be(true)\n\n\t-- A plugin's page, its own panel opened: at least the panel's least,\n\t-- and the session's as wide when we go back.\n\tapp:command(\"plugin_page\")\n\tapp:frames(30)\n\texpect(route(app)).to_be(\"/plugin/fixture/board\")\n\topen_panel(app)\n\tlocal on_page = width(app)\n\texpect(on_page >= RIGHT_PANE_MIN).to_be(true)\n\tapp:click('#titlebar >> role:button \"Back\"')\n\tapp:frames(60)\n\texpect(route(app)).to_be(\"/session/a1\")\n\texpect(`session {width(app)}`).to_be(`session {on_page}`)\n\n\t-- Widened on the plugin's page: the session's follows.\n\tapp:click('#titlebar >> role:button \"Forward\"')\n\tapp:frames(60)\n\texpect(route(app)).to_be(\"/plugin/fixture/board\")\n\twiden(app, 2)\n\tlocal widened = width(app)\n\texpect(widened > on_page).to_be(true)\n\tapp:click('#titlebar >> role:button \"Back\"')\n\tapp:frames(60)\n\texpect(`session {width(app)}`).to_be(`session {widened}`)\n\n\t-- Widened in the session: the plugin's page's follows.\n\twiden(app, 1)\n\tlocal again = width(app)\n\texpect(again > widened).to_be(true)\n\tapp:click('#titlebar >> role:button \"Forward\"')\n\tapp:frames(60)\n\texpect(`page {width(app)}`).to_be(`page {again}`)\nend)\n\n-- Dragged narrow beside its docked tree (the tree floating over the file),\n-- then the window narrowed until the fit takes the tree away for room: the\n-- panel keeps its least. (It kept only its part beside the tree, a tree's\n-- width under its least: screens/shell/page's floor in its resize effect.)\ntest(\"a panel narrowed beside its tree never stands under its least as the window narrows\", function()\n\tlocal app = mount(\"shell_fixture.luau\")\n\tapp:resize(1400, 800)\n\tapp:frames(30)\n\tapp:click('#shell-sidebar >> role:button \"Fix the build\"')\n\tapp:frames(20)\n\topen_panel(app)\n\t-- As narrow as its edge goes.\n\tapp:click('role:slider \"Resize files\"')\n\tapp:frames(5)\n\t-- (A step each from where it stands: frames between, as it eases.)\n\tfor _ = 1, 10 do\n\t\tapp:key(\"shift+ArrowRight\")\n\t\tapp:frames(20)\n\tend\n\tapp:frames(40)\n\texpect(width(app) >= RIGHT_PANE_MIN).to_be(true)\n\t-- The window narrowed a step at a time, as an edge dragged.\n\tlocal w = 1400\n\twhile w > 700 do\n\t\tw -= 25\n\t\tapp:resize(w, 800)\n\t\tapp:frames(4)\n\t\tif app:has(\"#shell-files\") then\n\t\t\tlocal now = width(app)\n\t\t\tif now > 1 then\n\t\t\t\texpect(`{w}: {now >= RIGHT_PANE_MIN - 0.5}`).to_be(`{w}: true`)\n\t\t\tend\n\t\tend\n\tend\nend)\n",
		["apps/zgx/ui/tests/plugin_surfaces.test.luau"] = "-- Plugins' pages and tabs in the main window (ui/plugin_surfaces_fixture):\n-- a listed page is a row under Search that opens it over the chats, its\n-- placeholder there for the plugin to fill (`.plugin-page.plugin-<id>`); a\n-- tab opens in the open session's panel, once however often it's asked,\n-- its placeholder there (`.plugin-tab.plugin-<id>`).\n\nlocal function open(): any\n\tlocal app = mount(\"plugin_surfaces_fixture.luau\")\n\tapp:resize(1200, 800)\n\tapp:frames(30)\n\treturn app\nend\n\ntest(\"a plugin's page is a row in the sidebar that opens it over the chats\", function()\n\tlocal app = open()\n\texpect(app:has(\".plugin-page-row\")).to_be(false)\n\tapp:command(\"page\")\n\tapp:frames(20)\n\texpect(app:has('.plugin-page-row >> \"Pull requests\"')).to_be(true)\n\tapp:click(\".plugin-page-row\")\n\tapp:frames(30)\n\texpect(app:has(\".plugin-page.plugin-prs\")).to_be(true)\n\texpect(app:tree()).to_contain(\"Its plugin isn't on right now.\")\n\t-- A session again: the page goes, the chats as they were.\n\tapp:click('#shell-sidebar >> role:button \"Fix the build\"')\n\tapp:frames(30)\n\texpect(app:has(\".plugin-page.plugin-prs\")).to_be(false)\nend)\n\ntest(\"a plugin's tab opens in the session's panel, once\", function()\n\tlocal app = open()\n\tapp:click('#shell-sidebar >> role:button \"Fix the build\"')\n\tapp:frames(20)\n\tapp:command(\"tab\")\n\tapp:frames(40)\n\texpect(app:wait('#panel-strip >> role:tab \"PR 12\"', { timeout_ms = 15000 })).to_be(true)\n\texpect(app:has(\".plugin-tab.plugin-prs\")).to_be(true)\n\tapp:command(\"tab\")\n\tapp:frames(20)\n\tlocal n = 0\n\tfor _ in app:tree(\"#panel-strip\"):gmatch('\"PR 12\"') do\n\t\tn += 1\n\tend\n\texpect(n).to_be(1)\nend)\n",
		["apps/zgx/ui/tests/private_text.test.luau"] = "-- ds.PrivateText: hidden, an address is a blurred stand-in that is never\n-- the address (no text anywhere holds it), the same stand-in every time,\n-- its separators kept; a click shows that one, another hides it; the\n-- setting switches every address at once. On ui/private_fixture.luau, and\n-- the settings pages on ui/shell_fixture.luau.\n\nlocal EMAILS = { \"mara@halcyon.dev\", \"theo.lindqvist@halcyon.dev\", \"ines_duarte+zeron@north-wind.io\" }\n\nlocal function shows(app: any, text: string): boolean\n\treturn app:tree():find(text, 1, true) ~= nil\nend\n\nlocal function open(): any\n\tlocal app = mount(\"private_fixture.luau\")\n\tapp:resize(700, 500)\n\tapp:frames(10)\n\treturn app\nend\n\ntest(\"a stand-in is the same every time, as long as the address, its separators in place\", function()\n\tlocal first = open():state(\"private_stand_ins\") :: { string }\n\tlocal again = open():state(\"private_stand_ins\") :: { string }\n\texpect(first).to_equal(again)\n\tfor i, e in EMAILS do\n\t\tlocal s = first[i]\n\t\texpect(#s).to_be(#e)\n\t\texpect(s).never.to_be(e)\n\t\tfor at = 1, #e do\n\t\t\tlocal ch = string.sub(e, at, at)\n\t\t\tif string.find(ch, \"[@%.%-_+]\") then\n\t\t\t\texpect(string.sub(s, at, at)).to_be(ch)\n\t\t\telse\n\t\t\t\texpect(string.find(\"abcdefghjkmnpqrstuvwxyz23456789\", string.sub(s, at, at), 1, true) ~= nil).to_be(true)\n\t\t\tend\n\t\tend\n\tend\n\t-- Different addresses, different stand-ins.\n\texpect(first[1]).never.to_be(first[2])\nend)\n\ntest(\"hidden, no text anywhere holds an address; shown again, they're plain\", function()\n\tlocal app = open()\n\tfor _, e in EMAILS do\n\t\texpect(shows(app, e)).to_be(true)\n\tend\n\tapp:command(\"private.hide\")\n\tapp:frames(10)\n\tfor _, e in EMAILS do\n\t\texpect(shows(app, e)).to_be(false)\n\tend\n\tlocal stand_ins = app:state(\"private_stand_ins\") :: { string }\n\texpect(shows(app, stand_ins[1])).to_be(true)\n\tapp:command(\"private.show\")\n\tapp:frames(10)\n\tfor _, e in EMAILS do\n\t\texpect(shows(app, e)).to_be(true)\n\tend\nend)\n\ntest(\"a click shows that one address, another hides it, the rest staying hidden\", function()\n\tlocal app = open()\n\tapp:command(\"private.hide\")\n\tapp:frames(10)\n\tapp:click('#private-line >> role:switch \"Show email\"')\n\tapp:frames(10)\n\texpect(app:tree(\"#private-line\"):find(\"mara@halcyon.dev\", 1, true) ~= nil).to_be(true)\n\t-- (Said as a switch, on while the address shows.)\n\texpect(app:tree('#private-line >> role:switch \"Show email\"')).never.to_contain(\"unchecked\")\n\t-- (The rows' copies of it stay hidden: the reveal is that instance's.)\n\tlocal _, count = app:tree(\"#private\"):gsub(\"mara@halcyon%.dev\", \"\")\n\texpect(count).to_be(1)\n\tapp:click('#private-line >> role:switch \"Show email\"')\n\tapp:frames(10)\n\texpect(shows(app, \"mara@halcyon.dev\")).to_be(false)\nend)\n\ntest(\"the toggle never moves the line: its height and baseline are the text's\", function()\n\tlocal app = open()\n\tlocal function top_and_height(): (number, number)\n\t\tlocal tree: string = app:tree(\"#private-line\")\n\t\tlocal line = string.match(tree, \"[^\\n]+\") or \"\"\n\t\tlocal y, h = line:match(\" %-?%d+,(%-?%d+) %d+x(%d+)\")\n\t\treturn tonumber(y) or -1, tonumber(h) or -1\n\tend\n\tlocal y1, h1 = top_and_height()\n\tapp:command(\"private.hide\")\n\tapp:frames(10)\n\tlocal y2, h2 = top_and_height()\n\texpect(y2).to_be(y1)\n\texpect(h2).to_be(h1)\nend)\n\ntest(\"Settings' switch hides and restores the Keiki account address\", function()\n\tlocal app = mount(\"shell_fixture.luau\")\n\tapp:resize(1200, 900)\n\tapp:frames(30)\n\tapp:command(\"settings_stub.sign_in\")\n\tapp:command(\"shell.settings\")\n\tapp:frames(20)\n\tapp:click('#settings-page >> role:switch \"Hide email addresses\"')\n\tapp:frames(10)\n\tapp:click('#settings-nav >> \"Account\"')\n\tapp:frames(30)\n\texpect(shows(app, \"Ada Lovelace\")).to_be(true)\n\texpect(shows(app, \"ada@example.net\")).to_be(false)\n\t-- Off again: every one plain, in place.\n\tapp:click('#settings-nav >> \"General\"')\n\tapp:frames(20)\n\tapp:click('#settings-page >> role:switch \"Hide email addresses\"')\n\tapp:frames(10)\n\tapp:click('#settings-nav >> \"Account\"')\n\tapp:frames(30)\n\texpect(shows(app, \"ada@example.net\")).to_be(true)\nend)\n",
		["apps/zgx/ui/tests/reduce_motion.test.luau"] = "-- Reduce motion (ds/motion: the system's setting or Zeron's own,\n-- `motion_reduce`): what a state change shows is there on the next frame,\n-- with no travel after it. The sidebar's fold and the panel's opening land\n-- at once.\n\n-- How wide node `id` stands now (its line in the tree).\nlocal function width(app: any, id: string): number\n\tfor line in app:tree(\"#shell\"):gmatch(\"[^\\n]+\") do\n\t\tif line:find(\" \" .. id, 1, true) then\n\t\t\treturn tonumber(line:match(\" %-?%d+,%-?%d+ (%d+)x%d+\")) or 0\n\t\tend\n\tend\n\treturn -1\nend\n\nlocal function reduced_shell(): any\n\tlocal app = mount(\"shell_fixture.luau\")\n\tapp:resize(1200, 800)\n\tapp:frames(30)\n\texpect(app:error()).to_be_nil()\n\tapp:set_state(\"motion_reduce\", true)\n\tapp:frames(2)\n\treturn app\nend\n\n-- After `act`, two frames (the press's, then the one it shows on), its\n-- width as it stays: no frame after those moves it.\nlocal function lands_at_once(app: any, id: string, act: () -> ()): (number, number)\n\tlocal before = width(app, id)\n\tact()\n\tapp:frames(2)\n\tlocal landed = width(app, id)\n\tapp:frames(30)\n\texpect(width(app, id)).to_be(landed)\n\treturn before, landed\nend\n\ntest(\"with motion reduced, the sidebar folds and comes back at once\", function()\n\tlocal app = reduced_shell()\n\t-- (Its card, at once. The window's 5-point edge before it is a tween, fixed as\n\t-- it's built: here that was before motion was reduced.)\n\tlocal function card(act: () -> ()): (number, number)\n\t\tlocal before = width(app, \"#shell-sidebar\")\n\t\tact()\n\t\tapp:frames(2)\n\t\tlocal landed = width(app, \"#shell-sidebar\")\n\t\tapp:frames(30)\n\t\texpect(math.abs(width(app, \"#shell-sidebar\") - landed) <= 5).to_be(true)\n\t\treturn before, landed\n\tend\n\tlocal open_w, folded = card(function()\n\t\tapp:click('#titlebar >> role:button \"Toggle sidebar\"')\n\tend)\n\texpect(folded <= 5).to_be(true)\n\tlocal _, back = card(function()\n\t\tapp:click('#titlebar >> role:button \"Toggle sidebar\"')\n\tend)\n\texpect(math.abs(back - open_w) <= 5).to_be(true)\nend)\n\ntest(\"with motion reduced, the panel opens and closes at once\", function()\n\tlocal app = reduced_shell()\n\tapp:click('#shell-sidebar >> role:button \"Write the docs\"')\n\tapp:frames(20)\n\tlocal shut, opened = lands_at_once(app, \"#shell-files\", function()\n\t\tapp:click('#titlebar >> role:button \"Panel\"')\n\tend)\n\texpect(opened > 300).to_be(true)\n\tlocal _, closed = lands_at_once(app, \"#shell-files\", function()\n\t\tapp:click('#titlebar >> role:button \"Panel\"')\n\tend)\n\texpect(closed).to_be(shut)\nend)\n\ntest(\"without it, the sidebar's fold still travels\", function()\n\tlocal app = mount(\"shell_fixture.luau\")\n\tapp:resize(1200, 800)\n\tapp:frames(30)\n\tlocal open_w = width(app, \"#shell-sidebar\")\n\tapp:click('#titlebar >> role:button \"Toggle sidebar\"')\n\tapp:frames(2)\n\tlocal early = width(app, \"#shell-sidebar\")\n\tapp:frames(40)\n\tlocal folded = width(app, \"#shell-sidebar\")\n\t-- Part way two frames in, then on to where it rests.\n\texpect(early > folded and early <= open_w).to_be(true)\nend)\n\n-- A send's prompt, frame by frame from when it joins: its y on each.\nlocal function prompt_ys(app: any, words: string): { number }\n\tapp:type('role:textbox \"Message\"', words)\n\tapp:key(\"Enter\")\n\tlocal id: string? = nil\n\tlocal ys: { number } = {}\n\tfor _ = 1, 40 do\n\t\tapp:wait(\"#never-shown\", { timeout_ms = 4 })\n\t\tif not id then\n\t\t\tlocal ms = app:state(\"chat.messages\")\n\t\t\tlocal last = ms and ms[#ms]\n\t\t\tif last and last.text == words then\n\t\t\t\tid = last.id\n\t\t\tend\n\t\tend\n\t\tif id then\n\t\t\tlocal first: string = app:tree(\"#\" .. id):match(\"[^\\n]+\") or \"\"\n\t\t\tlocal y = tonumber(first:match(\" %-?%d+,(%-?%d+) \"))\n\t\t\tif y then\n\t\t\t\ttable.insert(ys, y)\n\t\t\tend\n\t\tend\n\tend\n\treturn ys\nend\n\ntest(\"with motion reduced, a send's prompt lands at the top without gliding\", function()\n\tlocal app = mount(\"chat_fixture.luau\")\n\tapp:resize(900, 700)\n\tapp:command(\"go_s1\")\n\tapp:frames(30)\n\tapp:set_state(\"motion_reduce\", true)\n\tapp:frames(2)\n\tlocal ys = prompt_ys(app, \"Straight there\")\n\texpect(#ys > 5).to_be(true)\n\t-- Where it rests; at most one frame anywhere between where it joined\n\t-- and there (the frame the jump shows on).\n\tlocal rest = ys[#ys]\n\tlocal between = 0\n\tfor _, y in ys do\n\t\tif y ~= ys[1] and y ~= rest then\n\t\t\tbetween += 1\n\t\tend\n\tend\n\texpect(rest < 120).to_be(true)\n\texpect(between <= 1).to_be(true)\nend)\n\n-- A switch's knob, left of its track (`x` from its line): off at the\n-- track's inset, on across it.\nlocal function knob_x(app: any, scope: string): (number, number)\n\tlocal lines = {}\n\tfor line in app:tree(scope):gmatch(\"[^\\n]+\") do\n\t\ttable.insert(lines, line)\n\tend\n\tlocal track = tonumber(lines[1]:match(\" (%-?%d+),%-?%d+ %d+x%d+\")) or -1\n\tlocal knob = tonumber((lines[#lines] or \"\"):match(\" (%-?%d+),%-?%d+ %d+x%d+\")) or -1\n\treturn knob - track, #lines\nend\n\ntest(\"with motion reduced, a switch built on stands its knob on the right\", function()\n\tlocal app = mount(\"shell_fixture.luau\")\n\tapp:resize(1200, 900)\n\tapp:frames(30)\n\tapp:command(\"settings_stub.sign_in\")\n\tapp:command(\"shell.settings\")\n\tapp:frames(20)\n\tapp:click('#settings-nav >> role:tab \"Appearance\"')\n\tapp:frames(30)\n\tlocal reduce = '#settings-page >> role:switch \"Reduce motion\"'\n\tlocal off = knob_x(app, reduce)\n\tapp:click(reduce)\n\tapp:frames(30)\n\tlocal on = knob_x(app, reduce)\n\texpect(on > off).to_be(true)\n\t-- Away and back: the page builds again, now with motion reduced.\n\tapp:click('#settings-nav >> role:tab \"General\"')\n\tapp:frames(20)\n\tapp:click('#settings-nav >> role:tab \"Appearance\"')\n\tapp:frames(20)\n\texpect(app:tree(reduce)).never.to_contain(\"unchecked\")\n\texpect(knob_x(app, reduce)).to_be(on)\n\t-- And it still moves: off at once, back where it started.\n\tapp:click(reduce)\n\tapp:frames(2)\n\texpect(app:tree(reduce)).to_contain(\"unchecked\")\n\texpect(knob_x(app, reduce)).to_be(off)\nend)\n",
		["apps/zgx/ui/tests/scrollbars_unfaded.test.luau"] = "-- A faded scroll view's scrollbar stands over it, not in it: a view's edge\n-- `fade` masks everything inside it, the engine's own bar included (zgx\n-- mounts the bar as the view's child), so a faded view's thumb dissolved\n-- at its ends with the rows. The app's bar is the rail (ds/rail), the\n-- view's sibling: no bar inside the view, the rail beside it along its\n-- whole height. On the file tree in ui/tree_fixture.luau.\n\n-- Each line of the tree, with its depth: `{ depth, line }`.\nlocal function lines(app: any): { { depth: number, line: string } }\n\tlocal out = {}\n\tfor line in app:tree():gmatch(\"[^\\n]+\") do\n\t\tlocal indent = line:match(\"^( *)@\") or \"\"\n\t\ttable.insert(out, { depth = #indent // 2, line = line })\n\tend\n\treturn out\nend\n\nlocal function box(line: string): { number }\n\tlocal x, y, w, h = line:match(\" (%-?%d+),(%-?%d+) (%d+)x(%d+)\")\n\treturn { tonumber(x) :: number, tonumber(y) :: number, tonumber(w) :: number, tonumber(h) :: number }\nend\n\ntest(\"the file tree's scrollbar is over its faded list, not in it\", function()\n\tlocal app = mount(\"tree_fixture.luau\")\n\tapp:resize(400, 500)\n\tapp:frames(30)\n\tapp:set_state(\"test_tree_offset\", 200)\n\tapp:frames(30)\n\tlocal all = lines(app)\n\tlocal scroll, rail\n\tfor i, l in all do\n\t\tif l.line:find(\"tree \\\"fixture\\\"\", 1, true) and all[i + 1] then\n\t\t\tscroll = all[i + 1]\n\t\tend\n\t\tif l.line:find(\"#file-tree-rail\", 1, true) then\n\t\t\trail = l\n\t\tend\n\tend\n\texpect(scroll).never.to_be_nil()\n\texpect(rail).never.to_be_nil()\n\tassert(scroll and rail)\n\t-- Beside the faded scroll view, not inside it.\n\texpect(rail.depth).to_be(scroll.depth)\n\t-- No bar of the view's own (it would fade with the rows).\n\texpect(app:has('role:scrollbar')).to_be(false)\n\t-- Along the view's whole height, at its trailing edge.\n\tlocal s, r = box(scroll.line), box(rail.line)\n\texpect(`{r[2]} {r[4]}`).to_be(`{s[2]} {s[4]}`)\n\texpect(r[1] + r[3]).to_be(s[1] + s[3])\nend)\n",
		["apps/zgx/ui/tests/settings_archived.test.luau"] = "-- Settings → Archived (screens/settings/archived): the sessions put away,\n-- grouped by when each last moved and searched from one field; each row the\n-- sidebar's, restored or deleted from its corner or its menu; Delete all\n-- asking once more, naming how many and the Cloud machines that go with\n-- them, deleting only those still archived; the empty page; the header on\n-- the cards' text edge, its Delete all at the title's end until the page\n-- is narrow. On the shell in ui/shell_fixture.luau (`archived_days`: 37\n-- sessions over the days, two on Cloud machines of their own).\n\nlocal PAGE = \"#settings-page\"\nlocal DELETE_ALL = `role:dialog \"Delete all archived sessions?\"`\nlocal DELETE_ONE = `role:dialog \"Delete session?\"`\n\nlocal function open(command: string?): any\n\tlocal app = mount(\"shell_fixture.luau\")\n\tapp:resize(1200, 900)\n\tapp:frames(30)\n\tapp:command(command or \"archived_days\")\n\tapp:command(\"shell.settings\")\n\tapp:frames(10)\n\tapp:click('#settings-nav >> \"Archived\"')\n\tapp:frames(30)\n\treturn app\nend\n\n-- A node's first line under `target`: its `@id`, and its box.\nlocal function line(app: any, target: string): string\n\treturn (app:tree(target):match(\"[^\\n]+\")) :: string\nend\nlocal function id_of(app: any, target: string): string\n\treturn (line(app, target):match(\"^%s*@(%d+)\")) :: string\nend\nlocal function box(app: any, target: string): { x: number, y: number, w: number, h: number }\n\tlocal x, y, w, h = line(app, target):match(\"(%-?[%d.]+),(%-?[%d.]+) ([%d.]+)x([%d.]+)\")\n\treturn { x = tonumber(x) :: number, y = tonumber(y) :: number, w = tonumber(w) :: number, h = tonumber(h) :: number }\nend\nlocal function row(title: string): string\n\treturn `{PAGE} >> role:group \"{title}\"`\nend\nlocal function calls(app: any): string\n\treturn app:state(\"calls\") :: string\nend\n\ntest(\"sessions group by when they last moved, today first\", function()\n\tlocal app = open()\n\tlocal order = {}\n\tfor l in app:tree(PAGE):gmatch(\"[^\\n]+\") do\n\t\tlocal name = l:match('heading \"([^\"]+)\"')\n\t\tif name and name ~= \"Archived\" then\n\t\t\ttable.insert(order, name)\n\t\tend\n\tend\n\texpect(table.concat(order, \",\")).to_be(\"Today,Yesterday,This week,Earlier\")\n\t-- Each under its own: the latest today, the oldest earlier.\n\texpect(app:has(`{PAGE} >> \"Today\" >> \"Port the sidebar fold\"`)).to_be(true)\n\texpect(app:has(`{PAGE} >> \"Yesterday\" >> \"Investigate memory spike\"`)).to_be(true)\n\texpect(app:has(`{PAGE} >> \"This week\" >> \"Cloud machine warmup\"`)).to_be(true)\n\t-- (It stands far down the page: only what the page shows is built.)\n\tlocal y = 0\n\twhile y < 3000 and not app:has(`{PAGE} >> \"Earlier\" >> \"Audit the icon set\"`) do\n\t\ty += 300\n\t\tapp:set_state(\"shell_settings_scroll\", y)\n\t\tapp:frames(5)\n\tend\n\texpect(app:has(`{PAGE} >> \"Earlier\" >> \"Audit the icon set\"`)).to_be(true)\n\texpect(app:has(`{PAGE} >> \"Today\" >> \"Audit the icon set\"`)).to_be(false)\n\tapp:set_state(\"shell_settings_scroll\", 0)\n\tapp:frames(10)\n\t-- Where each ran: its project and computer; a Cloud machine's unnamed.\n\texpect(app:has(`{PAGE} >> \"Atlas · MacBook Pro\"`)).to_be(true)\n\texpect(app:has(`{PAGE} >> \"Borealis · devbox\"`)).to_be(true)\n\texpect(app:tree(row(\"Investigate memory spike\"))).to_contain('\"Atlas\"')\n\texpect(app:tree(row(\"Investigate memory spike\"))).never.to_contain(\"cloud-\")\n\t-- The count in the header.\n\texpect(app:has(`{PAGE} >> \"37 sessions, hidden from the sidebar until restored.\"`)).to_be(true)\nend)\n\ntest(\"the search narrows the rows, and says when nothing matches\", function()\n\tlocal app = open()\n\tapp:type(`{PAGE} >> role:textbox \"Search archived sessions\"`, \"scroll\")\n\tapp:frames(30)\n\tlocal kept = id_of(app, row(\"Bisect the scroll bug\"))\n\texpect(app:has(row(\"Bisect the scroll bug\"))).to_be(true)\n\texpect(app:has(row(\"Port the sidebar fold\"))).to_be(false)\n\t-- (Where it ran is searched too.)\n\tapp:fill(`{PAGE} >> role:textbox \"Search archived sessions\"`, \"devbox\")\n\tapp:frames(30)\n\texpect(app:has(row(\"Draft release notes\"))).to_be(true)\n\texpect(app:has(row(\"Port the sidebar fold\"))).to_be(false)\n\t-- Cleared: every row back, the one shown all along the same node.\n\tapp:fill(`{PAGE} >> role:textbox \"Search archived sessions\"`, \"\")\n\tapp:frames(30)\n\texpect(app:has(row(\"Port the sidebar fold\"))).to_be(true)\n\texpect(id_of(app, row(\"Bisect the scroll bug\"))).to_be(kept)\n\tapp:fill(`{PAGE} >> role:textbox \"Search archived sessions\"`, \"zzz\")\n\tapp:frames(30)\n\texpect(app:has(`#archived-none-match >> \"No archived sessions match “zzz”\"`)).to_be(true)\n\texpect(app:has(row(\"Bisect the scroll bug\"))).to_be(false)\nend)\n\ntest(\"a row's corner restores it; the rest stay the same nodes\", function()\n\tlocal app = open()\n\tlocal other = id_of(app, row(\"Fix flaky login test\"))\n\t-- At rest, its time; under the pointer, Restore and Delete in its place.\n\texpect(app:has(`{row(\"Port the sidebar fold\")} >> role:button \"Restore to sidebar\"`)).to_be(false)\n\tapp:hover(row(\"Port the sidebar fold\"))\n\tapp:frames(20)\n\texpect(id_of(app, row(\"Fix flaky login test\"))).to_be(other)\n\texpect(app:has(`{row(\"Port the sidebar fold\")} >> role:button \"Delete\"`)).to_be(true)\n\tapp:click(`{row(\"Port the sidebar fold\")} >> role:button \"Restore to sidebar\"`)\n\tapp:frames(30)\n\texpect(calls(app)).to_contain(\"unarchive:ar1\")\n\texpect(app:has(row(\"Port the sidebar fold\"))).to_be(false)\n\texpect(id_of(app, row(\"Fix flaky login test\"))).to_be(other)\n\texpect(app:has(`{PAGE} >> \"36 sessions, hidden from the sidebar until restored.\"`)).to_be(true)\nend)\n\ntest(\"its menu opens it, restores it, or deletes it once asked\", function()\n\tlocal app = open()\n\tapp:right_click(row(\"Draft release notes\"))\n\tapp:frames(20)\n\texpect(app:has('role:menuitem \"Open\"')).to_be(true)\n\texpect(app:has('role:menuitem \"Restore to sidebar\"')).to_be(true)\n\tapp:click('role:menuitem \"Delete…\"')\n\tapp:frames(30)\n\texpect(app:has(`{DELETE_ONE} >> \"“Draft release notes” will be permanently deleted. This can’t be undone.\"`)).to_be(true)\n\texpect(calls(app)).never.to_contain(\"delete:ar3\")\n\tapp:click(`{DELETE_ONE} >> role:button \"Delete\"`)\n\tapp:frames(30)\n\texpect(calls(app)).to_contain(\"delete:ar3\")\n\texpect(app:has(row(\"Draft release notes\"))).to_be(false)\n\t-- And from the corner: asked the same.\n\tapp:hover(row(\"Fix flaky login test\"))\n\tapp:frames(20)\n\tapp:click(`{row(\"Fix flaky login test\")} >> role:button \"Delete\"`)\n\tapp:frames(30)\n\texpect(app:has(DELETE_ONE)).to_be(true)\nend)\n\ntest(\"Delete all names the local archived sessions and deletes those still archived\", function()\n\tlocal app = open()\n\tapp:click(\"#archived-delete-all\")\n\tapp:frames(30)\n\texpect(app:has(`{DELETE_ALL} >> \"37 archived sessions will be permanently deleted. This can’t be undone.\"`)).to_be(\n\t\ttrue\n\t)\n\t-- One restored on another device meanwhile: it stays.\n\tapp:command(\"archived_restored_elsewhere\")\n\tapp:frames(10)\n\tapp:click(`{DELETE_ALL} >> role:button \"Delete all\"`)\n\tapp:frames(40)\n\tlocal said = calls(app)\n\texpect(said).never.to_contain(\"delete:ar1,\")\n\tlocal n = 0\n\tfor _ in said:gmatch(\"delete:ar%d+\") do\n\t\tn += 1\n\tend\n\texpect(n).to_be(36)\n\texpect(app:has(\"#archived-empty\")).to_be(true)\n\texpect(app:has(\"#archived-delete-all\")).to_be(false)\nend)\n\ntest(\"Deleting a historical Cloud session only promises to delete its local archive\", function()\n\tlocal app = open(\"archived_one_cloud\")\n\tapp:click(\"#archived-delete-all\")\n\tapp:frames(30)\n\texpect(app:has(`{DELETE_ALL} >> \"1 archived session will be permanently deleted. This can’t be undone.\"`)).to_be(\n\t\ttrue\n\t)\nend)\n\ntest(\"Delete all says how many it couldn't delete\", function()\n\tlocal app = open()\n\tapp:command(\"archived_delete_fails\")\n\tapp:click(\"#archived-delete-all\")\n\tapp:frames(30)\n\tapp:click(`{DELETE_ALL} >> role:button \"Delete all\"`)\n\tapp:frames(40)\n\texpect(app:has('\"Couldn’t delete 2 archived sessions. Try again.\"')).to_be(true)\n\texpect(app:has(row(\"Fix flaky login test\"))).to_be(true)\n\texpect(app:has(row(\"Draft release notes\"))).to_be(true)\n\texpect(app:has(row(\"Port the sidebar fold\"))).to_be(false)\nend)\n\ntest(\"Escape closes Delete all, and the page stays\", function()\n\tlocal app = open()\n\tapp:click(\"#archived-delete-all\")\n\tapp:frames(30)\n\texpect(app:has(DELETE_ALL)).to_be(true)\n\tapp:key(\"Escape\")\n\tapp:frames(10)\n\t-- (Closed: its panel then leaves on the clock, not the test's frames.)\n\texpect(app:state(\"settings_archived_delete_all_open\")).to_be(false)\n\texpect(app:state(\"shell_route_path\")).to_be(\"/settings/archived\")\n\texpect(calls(app)).never.to_contain(\"delete:\")\nend)\n\ntest(\"nothing archived: a quiet empty page, no Delete all or search\", function()\n\tlocal app = open(\"archived_none\")\n\texpect(app:has(`#archived-empty >> \"Nothing archived\"`)).to_be(true)\n\texpect(app:has(`{PAGE} >> \"Hidden from the sidebar until restored.\"`)).to_be(true)\n\texpect(app:has(\"#archived-delete-all\")).to_be(false)\n\texpect(app:has(\"#archived-search\")).to_be(false)\nend)\n\ntest(\"past fifty, Show more shows the rest\", function()\n\tlocal app = open()\n\tapp:command(\"archive_many\")\n\tapp:frames(30)\n\texpect(app:has(row(\"Old 30\"))).to_be(false)\n\t-- (At the page's foot.)\n\tapp:set_state(\"shell_settings_scroll\", 4000)\n\tapp:frames(30)\n\tapp:click(\"#archived-more\")\n\tapp:frames(30)\n\texpect(app:has(row(\"Old 30\"))).to_be(true)\n\texpect(app:has(\"#archived-more\")).to_be(false)\nend)\n\n-- The rows of `Chat <n>` built now, top to bottom: each's number and box.\nlocal function chats(app: any): { { n: number, y: number, h: number, w: number, x: number } }\n\tlocal out = {}\n\tfor l in app:tree(PAGE):gmatch(\"[^\\n]+\") do\n\t\tlocal n, x, y, w, h = l:match('^%s*@%d+ \"Chat (%d+)\" (%-?[%d.]+),(%-?[%d.]+) ([%d.]+)x([%d.]+)')\n\t\t-- (Not the search field's words, a line tall.)\n\t\tif n and (tonumber(h) :: number) > 40 then\n\t\t\ttable.insert(out, { n = tonumber(n) :: number, x = tonumber(x) :: number, y = tonumber(y) :: number, w = tonumber(w) :: number, h = tonumber(h) :: number })\n\t\tend\n\tend\n\treturn out\nend\n\n-- Rows next to each other stand a row and its hairline apart: the heights\n-- the list was told are what the rows lay out to.\nlocal function in_step(rows: { any }, what: string)\n\tfor i = 2, #rows do\n\t\tlocal a, b = rows[i - 1], rows[i]\n\t\tif b.n == a.n + 1 then\n\t\t\texpect(`{what}: Chat {b.n} {b.y - a.y}`).to_be(`{what}: Chat {b.n} {a.h + 1}`)\n\t\tend\n\tend\nend\n\nlocal function thousands(): any\n\tlocal app = open()\n\tapp:command(\"archive_thousands\")\n\tapp:frames(30)\n\t-- (All of them shown, past Show more.)\n\tapp:set_state(\"settings_archived_shown\", 5000)\n\tapp:frames(30)\n\treturn app\nend\n\ntest(\"thousands archived: only the rows the page shows are built, to the very last\", function()\n\tlocal app = thousands()\n\texpect(app:has(`{PAGE} >> \"2037 sessions, hidden from the sidebar until restored.\"`)).to_be(true)\n\t-- Down the page by the state and by the wheel: never more than a window's.\n\tlocal most = 0\n\tlocal y = 2000\n\twhile y < 130000 do\n\t\tapp:set_state(\"shell_settings_scroll\", y)\n\t\tapp:frames(3)\n\t\tlocal rows = chats(app)\n\t\texpect(#rows > 0).to_be(true)\n\t\tmost = math.max(most, #rows)\n\t\tin_step(rows, `at {y}`)\n\t\ty += 4001\n\tend\n\tfor _ = 1, 20 do\n\t\tapp:scroll(PAGE, 600)\n\t\tapp:frames(2)\n\t\tmost = math.max(most, #chats(app))\n\tend\n\texpect(most < 30).to_be(true)\n\t-- The very last, and it can be reached and restored.\n\tapp:set_state(\"shell_settings_scroll\", 200000)\n\tapp:frames(10)\n\texpect(app:has(row(\"Chat 2000\"))).to_be(true)\n\texpect(#chats(app) < 30).to_be(true)\n\tapp:hover(row(\"Chat 2000\"))\n\tapp:frames(5)\n\tapp:click(`{row(\"Chat 2000\")} >> role:button \"Restore to sidebar\"`)\n\tapp:frames(10)\n\texpect(calls(app)).to_contain(\"unarchive:many2000\")\n\texpect(app:has(row(\"Chat 2000\"))).to_be(false)\n\texpect(app:has(row(\"Chat 1999\"))).to_be(true)\nend)\n\ntest(\"the search finds a row far down the thousands, and only it is built\", function()\n\tlocal app = thousands()\n\tapp:type(`{PAGE} >> role:textbox \"Search archived sessions\"`, \"Chat 1234\")\n\tapp:frames(30)\n\texpect(app:has(row(\"Chat 1234\"))).to_be(true)\n\texpect(#chats(app)).to_be(1)\n\texpect(app:has(row(\"Chat 1\"))).to_be(false)\nend)\n\ntest(\"a row's height is what the list was told, at every text size, with a line under its name or none\", function()\n\tlocal app = thousands()\n\t-- (Each seventh has nothing under its name.)\n\tapp:set_state(\"shell_settings_scroll\", 6000)\n\tapp:frames(10)\n\tlocal at_13 = chats(app)\n\tin_step(at_13, \"13 pt\")\n\texpect(#at_13 > 7).to_be(true)\n\tfor _, size in { 12, 14, 16 } do\n\t\tapp:set_state(\"text_size\", size)\n\t\tapp:frames(20)\n\t\tin_step(chats(app), `{size} pt`)\n\tend\n\t-- Larger type, taller rows.\n\texpect(chats(app)[1].h > at_13[1].h).to_be(true)\nend)\n\ntest(\"the header's words and the groups' names sit on the cards' text edge\", function()\n\tlocal app = open()\n\t-- (The card is its section's width: the section's box gives its edges.)\n\tlocal card = box(app, `{PAGE} >> role:group \"Today\"`)\n\tlocal title = box(app, `{PAGE} >> role:heading \"Archived\"`)\n\tlocal today = box(app, `{PAGE} >> role:heading \"Today\"`)\n\texpect(math.abs(title.x - (card.x + 17)) < 0.5).to_be(true)\n\texpect(math.abs(today.x - (card.x + 17)) < 0.5).to_be(true)\n\t-- A row's wash: the card's inner box edge to edge, no inset (and no\n\t-- corner of its own: Settings.CatalogRow's, the card's clipping it).\n\tlocal wash = box(app, `{PAGE} >> role:group \"Today\" >> .catalog-row[1]`)\n\tlocal first = box(app, row(\"Port the sidebar fold\"))\n\texpect(first.x).to_be(card.x + 1)\n\texpect(first.w).to_be(card.w - 2)\n\texpect(wash.x).to_be(first.x)\n\texpect(wash.w).to_be(first.w)\n\t-- Its project's tile (28, its initial centred) on the text edge, as a\n\t-- plugin's is.\n\tlocal initial = box(app, `{row(\"Port the sidebar fold\")} >> \"A\"`)\n\texpect(math.abs(initial.x + initial.w / 2 - (card.x + 17 + 14)) < 1).to_be(true)\n\t-- Delete all on the title's line, its ink (inside the ghost's 10) on the\n\t-- cards' end edge.\n\tlocal delete = box(app, \"#archived-delete-all\")\n\texpect(math.abs((delete.y + delete.h / 2) - (title.y + title.h / 2)) < 2).to_be(true)\n\texpect(math.abs((delete.x + delete.w - 10) - (card.x + card.w - 17)) < 0.5).to_be(true)\nend)\n\ntest(\"narrow, Delete all goes under the title\", function()\n\tlocal app = open()\n\tapp:resize(560, 900)\n\tapp:frames(30)\n\tlocal title = box(app, `{PAGE} >> role:heading \"Archived\"`)\n\tlocal delete = box(app, \"#archived-delete-all\")\n\texpect(delete.y > title.y + title.h).to_be(true)\n\t-- Its ink (inside the ghost's 10) on the words' edge.\n\texpect(math.abs(delete.x + 10 - title.x) < 0.5).to_be(true)\n\tapp:resize(1200, 900)\n\tapp:frames(30)\n\tdelete = box(app, \"#archived-delete-all\")\n\ttitle = box(app, `{PAGE} >> role:heading \"Archived\"`)\n\texpect(delete.y < title.y + title.h).to_be(true)\nend)\n",
		["apps/zgx/ui/tests/shell_route_history.test.luau"] = "-- Back steps through every place the window has been since launch, past\n-- the 100 zgx's `ui.router` keeps unless told otherwise\n-- (screens/shell/route's `history = math.huge`). On the shell in\n-- ui/shell_fixture.luau.\n\nlocal SIDE = \"#shell-sidebar\"\nlocal MOVES = 120\n\ntest(\"Back goes more than 100 places back, to where the window started\", function()\n\tlocal app: any = mount(\"shell_fixture.luau\")\n\tapp:resize(1200, 800)\n\tapp:frames(30)\n\tlocal start = app:state(\"shell_route_path\")\n\t-- Two chats in turn: each click a new place.\n\tlocal chats = { \"Fix the build\", \"Write the docs\" }\n\tlocal paths = {}\n\tfor i = 1, MOVES do\n\t\tapp:click(`{SIDE} >> role:button \"{chats[(i - 1) % 2 + 1]}\"`)\n\t\tapp:frames(2)\n\t\tpaths[i] = app:state(\"shell_route_path\")\n\tend\n\texpect(paths[MOVES] ~= paths[MOVES - 1]).to_be(true)\n\t-- Each step back lands on the place before, all the way.\n\tfor i = MOVES - 1, 1, -1 do\n\t\tapp:command(\"router.back\")\n\t\tapp:frames(2)\n\t\texpect(app:state(\"shell_route_path\")).to_be(paths[i])\n\tend\n\tapp:command(\"router.back\")\n\tapp:frames(2)\n\texpect(app:state(\"shell_route_path\")).to_be(start)\n\texpect(app:error()).to_be_nil()\nend)\n",
		["apps/zgx/ui/tests/sidebar_activity.test.luau"] = "-- The Activity sidebar: one list of what needs you, the one back last at the\n-- top, no groups or sections; Working, Asleep and Archived folded at the\n-- list's foot, each opened by its title and kept so. A chat under way\n-- (running, or waiting on background work that will wake it) is in\n-- Working, and back at the top once it's done; Stop waiting releases a\n-- wait. One put to sleep waits in Asleep, its corner counting down, and\n-- shows the alarm once it wakes. (When it wakes, and that it syncs, are the\n-- engine's: its tests.) The view menu turns it on and off, opens its\n-- settings, and holds what it stands aside from out of reach. Off, the\n-- sidebar is as it was. On the shell in ui/shell_fixture.luau.\n\nlocal SIDE = \"#shell-sidebar\"\nlocal ON = \"screens/shell/activity.luau::shell_sidebar_activity\"\nlocal FOLDED = \"screens/shell/sidebar.luau::shell_sidebar_folded\"\n\nlocal function open(): any\n\tlocal app = mount(\"shell_fixture.luau\")\n\tapp:resize(1200, 900)\n\tapp:frames(30)\n\tapp:set_state(ON, true)\n\tapp:frames(40)\n\treturn app\nend\n\n-- Whether the sidebar shows a row starting with `label`.\nlocal function shows(app: any, label: string): boolean\n\treturn app:tree(SIDE):find(` button \"{label}`, 1, true) ~= nil\nend\n\n-- Where a row stands (its top), by the start of its label.\nlocal function top(app: any, label: string): number\n\tfor line in app:tree(SIDE):gmatch(\"[^\\n]+\") do\n\t\tif line:find(` button \"{label}`, 1, true) then\n\t\t\tlocal y = line:match(\" %-?%d+,(%-?%d+) \")\n\t\t\treturn tonumber(y) :: number\n\t\tend\n\tend\n\terror(`no \"{label}\" in the sidebar`)\nend\n\nlocal function settle(app: any)\n\tapp:frames(40)\nend\n\n-- Real time passing (the view's timers run on it).\nlocal function wait_ms(app: any, ms: number)\n\tapp:wait('\"never shown, only waited past\"', { timeout_ms = ms })\n\tsettle(app)\nend\n\ntest(\"Activity: Activity lists every chat newest first, no groups, its shelves folded at the foot\", function()\n\tlocal app = open()\n\texpect(shows(app, \"Activity\")).to_be(true)\n\t-- (No project headers: one list.)\n\texpect(shows(app, \"Atlas\")).to_be(false)\n\texpect(shows(app, \"Borealis\")).to_be(false)\n\t-- The one that moved last first.\n\texpect(top(app, \"Write the docs\") < top(app, \"Tidy the tests\")).to_be(true)\n\texpect(top(app, \"Tidy the tests\") < top(app, \"Ship the release\")).to_be(true)\n\texpect(top(app, \"Ship the release\") < top(app, \"Answer the review\")).to_be(true)\n\t-- Working (Fix the build) and Archived (Old experiment): folded, at the\n\t-- foot, under the list with room between.\n\texpect(shows(app, \"Working 1\")).to_be(true)\n\texpect(shows(app, \"Archived 1\")).to_be(true)\n\texpect(shows(app, \"Fix the build\")).to_be(false)\n\texpect(shows(app, \"Old experiment\")).to_be(false)\n\texpect(top(app, \"Working 1\") - top(app, \"Answer the review\") > 200).to_be(true)\n\texpect(top(app, \"Working 1\") < top(app, \"Archived 1\")).to_be(true)\nend)\n\ntest(\"Activity: a shelf opens from its title and stays open\", function()\n\tlocal app = open()\n\tapp:click(`{SIDE} >> role:button \"Working 1\"`)\n\tsettle(app)\n\texpect(shows(app, \"Fix the build\")).to_be(true)\n\texpect(((app:state(FOLDED) :: any) or {})[\"::shelf:working\"]).to_be(true)\n\tapp:click(`{SIDE} >> role:button \"Working 1\"`)\n\tsettle(app)\n\texpect(shows(app, \"Fix the build\")).to_be(false)\n\texpect(((app:state(FOLDED) :: any) or {})[\"::shelf:working\"]).to_be(nil)\nend)\n\ntest(\"Activity: a chat that stops working is back at the top\", function()\n\tlocal app = open()\n\texpect(shows(app, \"Fix the build\")).to_be(false)\n\tapp:command(\"finish\")\n\tsettle(app)\n\texpect(shows(app, \"Working\")).to_be(false)\n\texpect(shows(app, \"Fix the build\")).to_be(true)\n\texpect(top(app, \"Fix the build\") < top(app, \"Write the docs\")).to_be(true)\nend)\n\ntest(\"Activity: a chat waiting on its tests is under way, and Stop waiting brings it back\", function()\n\tlocal app = open()\n\tapp:command(\"wait_on_tests\")\n\tsettle(app)\n\texpect(shows(app, \"Working 2\")).to_be(true)\n\texpect(shows(app, \"Write the docs\")).to_be(false)\n\tapp:click(`{SIDE} >> role:button \"Working 2\"`)\n\tsettle(app)\n\tapp:right_click(`{SIDE} >> role:button \"Write the docs\"`)\n\tsettle(app)\n\tapp:click('\"Stop waiting\"')\n\tsettle(app)\n\t-- Back in the list, over the shelf; the build still under way in it.\n\texpect(top(app, \"Write the docs\") < top(app, \"Working\")).to_be(true)\n\texpect(top(app, \"Working\") < top(app, \"Fix the build\")).to_be(true)\nend)\n\ntest(\"Activity: a chat that starts working folds into Working\", function()\n\tlocal app = open()\n\tapp:command(\"work\")\n\tsettle(app)\n\texpect(shows(app, \"Working 2\")).to_be(true)\n\texpect(shows(app, \"Write the docs\")).to_be(false)\nend)\n\ntest(\"Activity: a chat asleep waits in Asleep, saying when it wakes, and wears the alarm once it wakes\", function()\n\tlocal app = open()\n\tapp:command(\"sleep_a3\")\n\tsettle(app)\n\texpect(shows(app, \"Asleep 1\")).to_be(true)\n\texpect(shows(app, \"Tidy the tests\")).to_be(false)\n\tapp:click(`{SIDE} >> role:button \"Asleep 1\"`)\n\tsettle(app)\n\texpect(shows(app, \"Tidy the tests\")).to_be(true)\n\texpect(app:tree(SIDE):find('text \"3h\"', 1, true) ~= nil).to_be(true)\n\t-- It woke: back in the list, at the top, wearing the alarm.\n\tapp:command(\"woke\")\n\tsettle(app)\n\texpect(shows(app, \"Asleep\")).to_be(false)\n\texpect(top(app, \"Tidy the tests\") < top(app, \"Write the docs\")).to_be(true)\n\texpect(app:tree(SIDE):find('\"Woke from sleep\"', 1, true) ~= nil).to_be(true)\nend)\n\ntest(\"Activity: Sleep's times are in the chat's menu, and Wake once it's asleep\", function()\n\tlocal app = open()\n\tapp:right_click(`{SIDE} >> role:button \"Write the docs\"`)\n\tsettle(app)\n\tapp:hover('\"Sleep\"')\n\tsettle(app)\n\texpect(app:has('~\"In 1 hour\"')).to_be(true)\n\texpect(app:has('\"Custom…\"')).to_be(true)\n\tapp:click('~\"In 1 hour\"')\n\tsettle(app)\n\texpect(shows(app, \"Asleep 1\")).to_be(true)\n\tapp:click(`{SIDE} >> role:button \"Asleep 1\"`)\n\tsettle(app)\n\tapp:right_click(`{SIDE} >> role:button \"Write the docs\"`)\n\tsettle(app)\n\tapp:click('\"Wake\"')\n\tsettle(app)\n\texpect(shows(app, \"Asleep\")).to_be(false)\nend)\n\ntest(\"Activity: the view menu opens its settings, and holds what it stands aside from out of reach\", function()\n\tlocal app = open()\n\tapp:click(`{SIDE} >> role:button \"Sidebar view options\"`)\n\tsettle(app)\n\t-- Its own row, checked; grouping, sorting, the empty projects' fold and\n\t-- a new section, out of reach.\n\tlocal function line(label: string): string\n\t\tfor l in app:tree():gmatch(\"[^\\n]+\") do\n\t\t\tif l:find(`\"{label}\"`, 1, true) and not l:find(\" button \\\"Activity\\\" 13,\", 1, true) then\n\t\t\t\treturn l\n\t\t\tend\n\t\tend\n\t\treturn \"\"\n\tend\n\texpect(line(\"Activity\"):find(\"checked\", 1, true) ~= nil).to_be(true)\n\texpect(line(\"By device\"):find(\"disabled\", 1, true) ~= nil).to_be(true)\n\texpect(line(\"Last updated\"):find(\"disabled\", 1, true) ~= nil).to_be(true)\n\texpect(line(\"Empty projects\"):find(\"disabled\", 1, true) ~= nil).to_be(true)\n\texpect(line(\"Create section\"):find(\"disabled\", 1, true) ~= nil).to_be(true)\n\t-- Its settings: their page.\n\tapp:click('role:button \"Activity settings…\"')\n\tsettle(app)\n\texpect(app:has('\"Activity sidebar\"')).to_be(true)\n\texpect(app:has('\"Archive idle chats\"')).to_be(true)\nend)\n\ntest(\"Activity: turned off from the view menu, the sidebar is grouped again\", function()\n\tlocal app = open()\n\tapp:click(`{SIDE} >> role:button \"Sidebar view options\"`)\n\tsettle(app)\n\tapp:click('role:checkbox \"Activity\"')\n\tsettle(app)\n\texpect(app:state(ON)).to_be(false)\n\texpect(shows(app, \"Atlas\")).to_be(true)\nend)\n\ntest(\"Activity: Activity off, the sidebar is grouped as it was\", function()\n\tlocal app = open()\n\tapp:set_state(ON, false)\n\tsettle(app)\n\texpect(shows(app, \"Atlas\")).to_be(true)\n\texpect(shows(app, \"Working\")).to_be(false)\n\texpect(shows(app, \"Activity\")).to_be(false)\nend)\n\ntest(\"Activity: idle chats are archived after the days set, never one waiting on you\", function()\n\tlocal app = open()\n\t-- Answer the review last moved a day ago (to the second: past it a\n\t-- moment on); the rest within hours.\n\twait_ms(app, 1100)\n\tapp:set_state(\"screens/shell/activity.luau::activity_archive_after\", 1)\n\twait_ms(app, 300)\n\texpect(shows(app, \"Answer the review\")).to_be(false)\n\texpect(shows(app, \"Archived 2\")).to_be(true)\n\texpect(shows(app, \"Write the docs\")).to_be(true)\n\texpect(shows(app, \"Ship the release\")).to_be(true)\nend)\n",
		["apps/zgx/ui/tests/sidebar_empty_projects.test.luau"] = "-- The sidebar's empty projects (every session they had archived): folded\n-- into one row at the projects' end, \"N empty projects\", closed until it's\n-- opened (kept with the folds); opened, each a project's header as any\n-- other (its new chat, its menu). The view options' Show → Empty projects\n-- off lists them nowhere. A project with none at all, just added, isn't\n-- empty: it's listed with the rest, and that same option off hides it too.\n-- One gaining a session leaves the fold, one losing its last joins it. On\n-- the shell in ui/shell_fixture.luau.\n\nlocal SIDE = \"#shell-sidebar\"\nlocal FOLDED = \"screens/shell/sidebar.luau::shell_sidebar_folded\"\nlocal SHOW = \"screens/shell/sidebar.luau::shell_sidebar_show_empty_projects\"\nlocal ARCHIVED = \"screens/shell/sidebar.luau::shell_sidebar_show_archived\"\nlocal ORGANIZE = \"screens/shell/sidebar.luau::shell_sidebar_organize\"\n\nlocal function open(): any\n\tlocal app = mount(\"shell_fixture.luau\")\n\tapp:resize(1200, 900)\n\tapp:frames(30)\n\tapp:command(\"empty_projects\")\n\tapp:frames(30)\n\treturn app\nend\n\nlocal function shows(app: any, label: string): boolean\n\treturn app:has(`{SIDE} >> role:button \"{label}\"`)\nend\n\n-- Where a row stands (its top), by its label.\nlocal function top(app: any, label: string): number\n\tfor line in app:tree(SIDE):gmatch(\"[^\\n]+\") do\n\t\tif line:find(` button \"{label}\"`, 1, true) then\n\t\t\tlocal y = line:match(\" %-?%d+,(%-?%d+) \")\n\t\t\treturn tonumber(y) :: number\n\t\tend\n\tend\n\terror(`no \"{label}\" in the sidebar`)\nend\n\nlocal function toggle(app: any, label: string)\n\tapp:click(`{SIDE} >> role:button \"{label}\"`)\n\tapp:frames(40)\nend\n\ntest(\"empty projects fold into one row at the projects' end, closed until it's opened, and kept so\", function()\n\tlocal app = open()\n\t-- Cobalt and Dune (every session archived) in the fold, closed; Ember\n\t-- (just added, none at all) with the rest, where its new chat starts.\n\texpect(shows(app, \"2 empty projects\")).to_be(true)\n\texpect(shows(app, \"Cobalt\")).to_be(false)\n\texpect(shows(app, \"Dune\")).to_be(false)\n\texpect(shows(app, \"Ember\")).to_be(true)\n\texpect(top(app, \"Borealis\") < top(app, \"2 empty projects\")).to_be(true)\n\texpect(top(app, \"Ember\") < top(app, \"2 empty projects\")).to_be(true)\n\n\t-- Opened: each a project's header under it, kept with the folds.\n\ttoggle(app, \"2 empty projects\")\n\texpect(shows(app, \"Cobalt\")).to_be(true)\n\texpect(shows(app, \"Dune\")).to_be(true)\n\texpect(top(app, \"2 empty projects\") < top(app, \"Cobalt\")).to_be(true)\n\texpect(((app:state(FOLDED) :: any) or {})[\"::empty_projects\"]).to_be(true)\n\t-- (Its sessions archived stay on the Archived shelf, not under it.)\n\texpect(shows(app, \"Old Cobalt work\")).to_be(false)\n\n\t-- Closed again.\n\ttoggle(app, \"2 empty projects\")\n\texpect(shows(app, \"Cobalt\")).to_be(false)\n\texpect(((app:state(FOLDED) :: any) or {})[\"::empty_projects\"]).to_be(nil)\n\n\t-- Opened and closed from outside (the folds kept, set again): it follows.\n\tapp:set_state(FOLDED, { [\"::empty_projects\"] = true })\n\tapp:frames(40)\n\texpect(shows(app, \"Cobalt\")).to_be(true)\n\tapp:set_state(FOLDED, {})\n\tapp:frames(40)\n\texpect(shows(app, \"Cobalt\")).to_be(false)\nend)\n\ntest(\"an empty project's header starts a new chat in it and has its menu\", function()\n\tlocal app = open()\n\ttoggle(app, \"2 empty projects\")\n\tapp:hover(`{SIDE} >> role:button \"Cobalt\"`)\n\tapp:frames(20)\n\tapp:click(`{SIDE} >> role:button \"New chat in Cobalt\"`)\n\tapp:frames(30)\n\texpect(app:state(\"shell_project\")).to_be(\"cobalt\")\n\texpect(app:state(\"shell_route_path\")).to_be(\"/\")\n\tapp:right_click(`{SIDE} >> \"Dune\"`)\n\tapp:frames(20)\n\texpect(app:has(`role:menuitem \"Edit project…\"`)).to_be(true)\n\texpect(app:has(`role:menuitem \"Remove…\"`)).to_be(true)\nend)\n\ntest(\"a project gaining a session leaves the fold; one losing its last joins it\", function()\n\tlocal app = open()\n\tlocal function cobalt_bar(): string\n\t\treturn app:tree(SIDE)\n\tend\n\tapp:command(\"cobalt_arrives\")\n\tapp:frames(40)\n\texpect(shows(app, \"1 empty project\")).to_be(true)\n\texpect(shows(app, \"Cobalt\")).to_be(true)\n\texpect(shows(app, \"Back in Cobalt\")).to_be(true)\n\texpect(shows(app, \"Dune\")).to_be(false)\n\texpect(cobalt_bar()).never.to_contain('\"2 empty projects\"')\n\n\t-- Borealis's two archived (their menus' Archive): it joins the fold.\n\tfor _, title in { \"Ship the release\", \"Answer the review\" } do\n\t\tapp:right_click(`{SIDE} >> role:button \"{title}\"`)\n\t\tapp:frames(20)\n\t\tapp:click(`role:menuitem \"Archive\"`)\n\t\tapp:frames(30)\n\tend\n\texpect(shows(app, \"2 empty projects\")).to_be(true)\n\texpect(shows(app, \"Borealis\")).to_be(false)\nend)\n\ntest(\"Show → Empty projects off lists them nowhere; on, the fold is back as it was\", function()\n\tlocal app = open()\n\tapp:click(`{SIDE} >> role:button \"Sidebar view options\"`)\n\tapp:frames(20)\n\texpect(app:has('role:checkbox \"Empty projects\"')).to_be(true)\n\tapp:click('role:checkbox \"Empty projects\"')\n\tapp:frames(30)\n\texpect(app:state(SHOW)).to_be(false)\n\tapp:key(\"Escape\")\n\tapp:frames(30)\n\texpect(shows(app, \"2 empty projects\")).to_be(false)\n\texpect(shows(app, \"Cobalt\")).to_be(false)\n\t-- (One never used goes with them; a project with sessions stays.)\n\texpect(shows(app, \"Ember\")).to_be(false)\n\texpect(shows(app, \"Atlas\")).to_be(true)\n\n\tapp:set_state(SHOW, true)\n\tapp:frames(30)\n\texpect(shows(app, \"2 empty projects\")).to_be(true)\n\texpect(shows(app, \"Cobalt\")).to_be(false)\n\t-- (Back with the rest, not in the fold.)\n\texpect(shows(app, \"Ember\")).to_be(true)\nend)\n\ntest(\"with Archived shown, an empty project stays in the fold, its sessions on the shelf\", function()\n\tlocal app = open()\n\tapp:set_state(ARCHIVED, true)\n\tapp:frames(40)\n\texpect(shows(app, \"2 empty projects\")).to_be(true)\n\texpect(shows(app, \"Old Cobalt work\")).to_be(true)\n\texpect(top(app, \"2 empty projects\") < top(app, \"Old Cobalt work\")).to_be(true)\n\ttoggle(app, \"2 empty projects\")\n\texpect(shows(app, \"Cobalt\")).to_be(true)\n\texpect(top(app, \"Dune\") < top(app, \"Old Cobalt work\")).to_be(true)\nend)\n\ntest(\"the fold follows the grouping and the filters\", function()\n\tlocal app = open()\n\t-- By project then device: the same fold.\n\tapp:set_state(ORGANIZE, { \"project\", \"device\" })\n\tapp:frames(40)\n\texpect(shows(app, \"2 empty projects\")).to_be(true)\n\t-- By device (then project) and none: no project's header for an empty\n\t-- one anywhere, so no fold.\n\tapp:set_state(ORGANIZE, { \"device\", \"project\" })\n\tapp:frames(40)\n\texpect(shows(app, \"2 empty projects\")).to_be(false)\n\texpect(shows(app, \"Cobalt\")).to_be(false)\n\tapp:set_state(ORGANIZE, {})\n\tapp:frames(40)\n\texpect(shows(app, \"2 empty projects\")).to_be(false)\n\tapp:set_state(ORGANIZE, { \"project\" })\n\tapp:frames(40)\n\n\t-- Narrowed by a plugin's filter: every group with none folds away, and\n\t-- the fold with them.\n\tapp:set_state(\"sidebar.filter\", { statuses = { \"working\" }, by = \"Focus\" })\n\tapp:frames(40)\n\texpect(shows(app, \"2 empty projects\")).to_be(false)\n\tapp:set_state(\"sidebar.filter\", nil)\n\tapp:frames(40)\n\texpect(shows(app, \"2 empty projects\")).to_be(true)\n\n\t-- The project filter narrowed to an empty one: that one stands with the\n\t-- rest, not folded away.\n\tapp:set_state(\"screens/shell/sidebar.luau::shell_sidebar_show_project_filter\", true)\n\tapp:frames(20)\n\tapp:set_state(\"screens/shell/sidebar.luau::shell_sidebar_project\", \"cobalt\")\n\tapp:frames(40)\n\texpect(shows(app, \"Cobalt\")).to_be(true)\n\texpect(shows(app, \"1 empty project\")).to_be(true)\nend)\n\ntest(\"many empty projects opened: the list builds only the rows in view\", function()\n\tlocal app = mount(\"shell_fixture.luau\")\n\tapp:resize(1200, 700)\n\tapp:frames(30)\n\tapp:command(\"many_empty_projects\")\n\tapp:frames(30)\n\texpect(shows(app, \"60 empty projects\")).to_be(true)\n\ttoggle(app, \"60 empty projects\")\n\tlocal function built(): number\n\t\tlocal n = 0\n\t\tfor line in app:tree(SIDE):gmatch(\"[^\\n]+\") do\n\t\t\tif line:find(' button \"Gone %d+\"') then\n\t\t\t\tn += 1\n\t\t\tend\n\t\tend\n\t\treturn n\n\tend\n\texpect(shows(app, \"Gone 1\")).to_be(true)\n\texpect(built() < 40).to_be(true)\n\t-- Scrolled to the end: the last of them, the first gone from the list.\n\tapp:scroll(\"#sidebar\", 4000)\n\tapp:frames(30)\n\texpect(shows(app, \"Gone 60\")).to_be(true)\n\texpect(shows(app, \"Gone 1\")).to_be(false)\nend)\n\ntest(\"the row reads Empty, a stack of project tiles (at most 5), and the count\", function()\n\t-- The tiles in the row: the fixture's are letters, one each.\n\tlocal app: any\n\tlocal function stacked(label: string): number\n\t\tlocal n, inside, indent = 0, false, 0\n\t\tfor line in app:tree(SIDE):gmatch(\"[^\\n]+\") do\n\t\t\tlocal pad = #line:match(\"^ *\")\n\t\t\tif line:find(` button \"{label}\"`, 1, true) then\n\t\t\t\tinside, indent = true, pad\n\t\t\telseif inside and pad <= indent then\n\t\t\t\tbreak\n\t\t\telseif inside and line:match(' text \"[^\"%d]\" ') then\n\t\t\t\tn += 1\n\t\t\tend\n\t\tend\n\t\treturn n\n\tend\n\tapp = open()\n\texpect(shows(app, \"2 empty projects\")).to_be(true)\n\texpect(app:has(`{SIDE} >> role:button \"2 empty projects\" >> \"Empty\"`)).to_be(true)\n\texpect(app:has(`{SIDE} >> role:button \"2 empty projects\" >> \"2\"`)).to_be(true)\n\texpect(stacked(\"2 empty projects\")).to_be(2)\n\n\t-- Sixty: the stack stops at five, the word and the count whole.\n\tapp = mount(\"shell_fixture.luau\")\n\tapp:resize(1200, 700)\n\tapp:frames(30)\n\tapp:command(\"many_empty_projects\")\n\tapp:frames(30)\n\texpect(shows(app, \"60 empty projects\")).to_be(true)\n\texpect(app:has(`{SIDE} >> role:button \"60 empty projects\" >> \"Empty\"`)).to_be(true)\n\texpect(app:has(`{SIDE} >> role:button \"60 empty projects\" >> \"60\"`)).to_be(true)\n\texpect(stacked(\"60 empty projects\")).to_be(5)\n\n\t-- No chevron, as Archived has none: nothing in the row but words and tiles.\n\tlocal function block(label: string): string\n\t\tlocal out, inside, indent = {}, false, 0\n\t\tfor line in app:tree(SIDE):gmatch(\"[^\\n]+\") do\n\t\t\tlocal pad = #line:match(\"^ *\")\n\t\t\tif line:find(` button \"{label}\"`, 1, true) then\n\t\t\t\tinside, indent = true, pad\n\t\t\telseif inside and pad <= indent then\n\t\t\t\tbreak\n\t\t\telseif inside then\n\t\t\t\ttable.insert(out, line)\n\t\t\tend\n\t\tend\n\t\treturn table.concat(out, \"\\n\")\n\tend\n\texpect(block(\"60 empty projects\")).never.to_contain(\" img \")\n\t-- Opened: the tiles have flown into the rows, none left in the header;\n\t-- closed, they're back in the stack.\n\ttoggle(app, \"60 empty projects\")\n\tapp:frames(40)\n\texpect(stacked(\"60 empty projects\")).to_be(0)\n\texpect(block(\"60 empty projects\")).never.to_contain(\" img \")\n\ttoggle(app, \"60 empty projects\")\n\tapp:frames(40)\n\texpect(stacked(\"60 empty projects\")).to_be(5)\nend)\n",
		["apps/zgx/ui/tests/sidebar_motion.test.luau"] = "-- The sidebar's rows take new places smoothly: a group or a session going\n-- first glides there from where it stood (each row the same node, focus\n-- kept), a row leaving closes where it was, and with motion reduced it all\n-- lands at once. On the shell in ui/shell_fixture.luau.\n\nlocal SIDE = \"#shell-sidebar\"\n\nlocal function open(): any\n\tlocal app = mount(\"shell_fixture.luau\")\n\tapp:resize(1200, 900)\n\tapp:frames(30)\n\treturn app\nend\n\n-- A row's line in the tree, by its label.\nlocal function line(app: any, label: string): string?\n\tfor l in app:tree(SIDE):gmatch(\"[^\\n]+\") do\n\t\tif l:find(` button \"{label}\"`, 1, true) then\n\t\t\treturn l\n\t\tend\n\tend\n\treturn nil\nend\n\nlocal function top(app: any, label: string): number\n\tlocal l = line(app, label)\n\tif not l then\n\t\terror(`no \"{label}\" in the sidebar`)\n\tend\n\treturn tonumber(l:match(\" %-?%d+,(%-?%d+) \")) :: number\nend\n\nlocal function id(app: any, label: string): string\n\treturn ((line(app, label) or \"\"):match(\"@(%d+)\")) or \"none\"\nend\n\ntest(\"a group going first glides there, its rows the same nodes, focus kept\", function()\n\tlocal app = open()\n\t-- Answer the review chosen (focused), Borealis under Atlas.\n\t-- (Arriving on its chat gives the composer the keys; pressed again,\n\t-- its chat already open, the row keeps them.)\n\tapp:click(`{SIDE} >> role:button \"Answer the review\"`)\n\tapp:frames(10)\n\tapp:click(`{SIDE} >> role:button \"Answer the review\"`)\n\tapp:frames(10)\n\tlocal from = top(app, \"Borealis\")\n\tlocal header, review = id(app, \"Borealis\"), id(app, \"Answer the review\")\n\texpect((line(app, \"Answer the review\") :: string)).to_contain(\"focused\")\n\n\tapp:command(\"borealis_moves\")\n\tapp:frames(3)\n\t-- On its way: between where it stood and where it goes, moving up.\n\tlocal early = top(app, \"Borealis\")\n\tapp:frames(3)\n\tlocal later = top(app, \"Borealis\")\n\tapp:frames(30)\n\tlocal to = top(app, \"Borealis\")\n\texpect(to < from).to_be(true)\n\texpect(`early {early} in ({to}, {from})`).to_be(`early {math.clamp(early, to + 1, from - 1)} in ({to}, {from})`)\n\texpect(later < early).to_be(true)\n\texpect(later > to).to_be(true)\n\t-- The same rows, focus where it was.\n\texpect(`borealis @{id(app, \"Borealis\")}`).to_be(`borealis @{header}`)\n\texpect(`review @{id(app, \"Answer the review\")}`).to_be(`review @{review}`)\n\texpect((line(app, \"Answer the review\") :: string)).to_contain(\"focused\")\nend)\n\ntest(\"a row leaving closes where it was, those under it closing up\", function()\n\tlocal app = open()\n\tapp:command(\"crowd_atlas\")\n\tapp:command(\"atlas_asks\")\n\tapp:frames(40)\n\t-- Atlas 6 asks, so it shows past Atlas's five; answered, it goes.\n\tlocal pager_was = top(app, \"Show 3 more\")\n\tapp:command(\"atlas_answered\")\n\tapp:frames(2)\n\t-- Still there, closing; Show more partway up; ⌘1–9 past it already.\n\texpect(line(app, \"Atlas 6\")).never.to_be_nil()\n\tlocal mid = top(app, \"Show 4 more\")\n\texpect(mid < pager_was).to_be(true)\n\texpect(table.find((app:state(\"shell_sidebar_order\") :: any), \"x6\")).to_be_nil()\n\tapp:frames(30)\n\texpect(line(app, \"Atlas 6\")).to_be_nil()\n\tlocal pager_now = top(app, \"Show 4 more\")\n\texpect(mid > pager_now).to_be(true)\nend)\n\ntest(\"with motion reduced, a group going first is there at once\", function()\n\tlocal app = open()\n\tapp:set_state(\"motion_reduce\", true)\n\tapp:frames(2)\n\tapp:command(\"borealis_moves\")\n\tapp:frames(2)\n\tlocal landed = top(app, \"Borealis\")\n\tapp:frames(30)\n\texpect(top(app, \"Borealis\")).to_be(landed)\n\texpect(landed < top(app, \"Atlas\")).to_be(true)\nend)\n\ntest(\"folded away, a group going first is there at once: opened, it's where it ends, ⌘1–9 following meanwhile\", function()\n\tlocal app = open()\n\tlocal before = (app:state(\"shell_sidebar_order\") :: any)[1]\n\tapp:click('#titlebar >> role:button \"Toggle sidebar\"')\n\tapp:frames(60)\n\texpect(app:state(\"shell_collapsed\")).to_be(true)\n\tapp:command(\"borealis_moves\")\n\tapp:frames(2)\n\t-- (⌘1–9 and the next session read its order: it follows while away.)\n\tlocal first = (app:state(\"shell_sidebar_order\") :: any)[1]\n\texpect(first).never.to_be(before)\n\tapp:click('#titlebar >> role:button \"Toggle sidebar\"')\n\tapp:frames(1)\n\t-- Nothing glides as it comes back: every row is where it lands.\n\tlocal landed, atlas = top(app, \"Borealis\"), top(app, \"Atlas\")\n\tapp:frames(40)\n\texpect(top(app, \"Borealis\")).to_be(landed)\n\texpect(top(app, \"Atlas\")).to_be(atlas)\n\texpect(landed < atlas).to_be(true)\nend)\n\n-- A row's y through `n` frames (one a frame), as `act` folds or opens.\nlocal function track(app: any, scope: string, label: string, act: () -> (), n: number): { number }\n\tact()\n\tlocal ys = {}\n\tfor _ = 1, n do\n\t\tapp:frames(1)\n\t\tlocal y = -1\n\t\tfor l in app:tree(scope):gmatch(\"[^\\n]+\") do\n\t\t\tif l:find(` button \"{label}\"`, 1, true) then\n\t\t\t\ty = tonumber(l:match(\" %-?%d+,(%-?%d+) \")) :: number\n\t\t\t\tbreak\n\t\t\tend\n\t\tend\n\t\texpect(`{label} found {y ~= -1}`).to_be(`{label} found true`)\n\t\ttable.insert(ys, y)\n\tend\n\treturn ys\nend\n-- One clean move: from where it was to where it ends, never past it, and\n-- still once there (no bounce, no settle after it lands).\nlocal function clean(ys: { number }, what: string)\n\tlocal final = ys[#ys]\n\t-- (It moved: the fold did something.)\n\texpect(`{what} moved {ys[1] ~= final or #ys < 2}`).to_be(`{what} moved true`)\n\tlocal dir = 0\n\tfor i = 2, #ys do\n\t\tlocal step = ys[i] - ys[i - 1]\n\t\tif step ~= 0 then\n\t\t\tlocal d = if step > 0 then 1 else -1\n\t\t\tif dir ~= 0 and d ~= dir then\n\t\t\t\texpect(`{what} turned back at frame {i}: {table.concat(ys, \" \")}`).to_be(`{what} one way`)\n\t\t\tend\n\t\t\tdir = d\n\t\tend\n\tend\n\tlocal landed = nil\n\tfor i, y in ys do\n\t\tif y == final then\n\t\t\tlanded = landed or i\n\t\telse\n\t\t\tlanded = nil\n\t\tend\n\tend\n\texpect(`{what} lands and stays ({table.concat(ys, \" \")})`).to_be(`{what} lands and stays ({table.concat(ys, \" \")})`)\n\texpect((landed or #ys + 1) <= #ys - 10).to_be(true)\nend\n\ntest(\"a group folds and opens in one motion: the rows under it never pass their place and don't move once there\", function()\n\tlocal app = open()\n\tlocal function click()\n\t\tapp:click(`{SIDE} >> role:button \"Atlas\"`)\n\tend\n\tclean(track(app, SIDE, \"Borealis\", click, 45), \"close\")\n\tclean(track(app, SIDE, \"Borealis\", click, 45), \"open\")\n\t-- An inner group's fold (project, then device): the same.\n\tapp:command(\"atlas_on_box\")\n\tapp:set_state(\"screens/shell/sidebar.luau::shell_sidebar_organize\", { \"project\", \"device\" })\n\tapp:frames(40)\n\tlocal function inner()\n\t\tapp:click(`{SIDE} >> role:button \"MacBook Pro\"`)\n\tend\n\tclean(track(app, SIDE, \"Borealis\", inner, 45), \"inner close\")\n\tclean(track(app, SIDE, \"Borealis\", inner, 45), \"inner open\")\n\t-- Reduce motion: there at once, and still.\n\tapp:set_state(\"motion_reduce\", true)\n\tapp:frames(2)\n\tlocal ys = track(app, SIDE, \"Borealis\", click, 20)\n\texpect(ys[2]).to_be(ys[#ys])\nend)\n\ntest(\"the panel home's parts fold in one motion too\", function()\n\tlocal app = mount(\"panel_home_fixture.luau\")\n\tapp:resize(1000, 900)\n\tapp:frames(20)\n\texpect(app:wait(\"#panel-empty\", { timeout_ms = 15000 })).to_be(true)\n\tapp:frames(10)\n\tlocal function click()\n\t\tapp:click(\"#panel-home-side-head\")\n\tend\n\tclean(track(app, \"#panel-home-lanes\", \"Subagents\", click, 45), \"panel close\")\n\tclean(track(app, \"#panel-home-lanes\", \"Subagents\", click, 45), \"panel open\")\nend)\n",
		["apps/zgx/ui/tests/split_jump.test.luau"] = "-- \"Jump to latest\" in a split's pane: the pill has the keys as it's clicked and\n-- leaves as the view arrives. The focus stays on that pane's chat, not on the\n-- next control's, another pane's composer. On the shell in ui/shell_fixture.luau.\n\nlocal function long_chat(id: string): { any }\n\tlocal messages = {}\n\tfor i = 1, 60 do\n\t\ttable.insert(messages, { id = `{id}-{i}`, role = \"assistant\", text = string.rep(`Line {i} of {id}. `, 40) })\n\tend\n\treturn messages\nend\n\nlocal function leaf(id: string): any\n\treturn { kind = \"leaf\", id = id }\nend\n\nlocal function scrolled_up(app: any, id: string)\n\tapp:scroll(`#lane-split-{id} >> #transcript`, -1500)\n\tapp:frames(30)\n\texpect(app:wait(`#lane-split-{id} >> role:button \"Jump to latest\"`, { timeout_ms = 2000 })).to_be(true)\nend\n\ntest(\"Jump to latest keeps the focus on the pane it was pressed in\", function()\n\tlocal app = mount(\"shell_fixture.luau\")\n\tapp:resize(1500, 800)\n\tapp:frames(30)\n\tapp:set_state(\"fixture.chats\", { a1 = { messages = long_chat(\"a1\") }, a2 = { messages = long_chat(\"a2\") } })\n\tapp:set_state(\"inset_split_trees\", { { kind = \"row\", children = { leaf(\"a1\"), leaf(\"a2\") } } })\n\tapp:click('#shell-sidebar >> role:button \"Fix the build\"')\n\tapp:frames(60)\n\texpect(app:state(\"fixture_open_chat\")).to_be(\"a1\")\n\tscrolled_up(app, \"a1\")\n\tapp:click('#lane-split-a1 >> role:button \"Jump to latest\"')\n\texpect(app:wait('#lane-split-a1 >> role:button \"Jump to latest\"', { gone = true, timeout_ms = 2000 })).to_be(true)\n\tapp:frames(30)\n\texpect(app:state(\"fixture_open_chat\")).to_be(\"a1\")\nend)\n\ntest(\"Jump to latest in a pane that wasn't focused focuses that pane\", function()\n\tlocal app = mount(\"shell_fixture.luau\")\n\tapp:resize(1500, 800)\n\tapp:frames(30)\n\tapp:set_state(\"fixture.chats\", { a1 = { messages = long_chat(\"a1\") }, a2 = { messages = long_chat(\"a2\") } })\n\tapp:set_state(\"inset_split_trees\", { { kind = \"row\", children = { leaf(\"a1\"), leaf(\"a2\") } } })\n\tapp:click('#shell-sidebar >> role:button \"Fix the build\"')\n\tapp:frames(60)\n\tscrolled_up(app, \"a2\")\n\tapp:click('#lane-split-a2 >> role:button \"Jump to latest\"')\n\texpect(app:wait('#lane-split-a2 >> role:button \"Jump to latest\"', { gone = true, timeout_ms = 2000 })).to_be(true)\n\tapp:frames(30)\n\texpect(app:state(\"fixture_open_chat\")).to_be(\"a2\")\nend)\n",
		["apps/zgx/ui/tests/time_ago.test.luau"] = "-- A session's \"how long ago\" moves on by itself as time passes, nothing\n-- else about it changing (ds/status `since`: one clock every corner reads).\n-- On the shell in ui/shell_fixture.luau: \"Write the docs\" moved an hour\n-- ago, \"Tidy the tests\" two.\n\nlocal CLOCK = \"ds/status.luau::ds_status_clock\"\n\nlocal function corner(app: any): string\n\treturn app:tree(\"#shell-sidebar\")\nend\n\ntest(\"a row's time moves on as the clock does, with nothing else changing\", function()\n\tlocal app = mount(\"shell_fixture.luau\")\n\tapp:resize(1200, 900)\n\tapp:frames(30)\n\tlocal before = corner(app)\n\texpect(before).to_contain('text \"1h\"')\n\texpect(before).to_contain('text \"2h\"')\n\t-- Two hours on: the same rows, nothing else written.\n\tapp:set_state(CLOCK, os.time() + 2 * 3600)\n\tapp:frames(5)\n\tlocal after = corner(app)\n\texpect(after).to_contain('text \"3h\"')\n\texpect(after).to_contain('text \"4h\"')\n\texpect(after:find('text \"1h\"', 1, true) == nil).to_be(true)\n\texpect(app:error()).to_be_nil()\nend)\n\nlocal DUE = \"ds/status.luau::ds_status_clock_due\"\n\ntest(\"the clock moves as a corner would read otherwise, and no sooner\", function()\n\tlocal app = mount(\"shell_fixture.luau\")\n\tapp:resize(1200, 900)\n\tapp:frames(30)\n\t-- The newest corner reads \"1h\" (\"Write the docs\"): it reads \"2h\" within\n\t-- the hour, and nothing changes before (once, every half minute).\n\tlocal due = app:state(DUE)\n\texpect(type(due)).to_be(\"number\")\n\texpect(due > os.time() + 30).to_be(true)\n\texpect(due <= os.time() + 3600 + 30).to_be(true)\nend)\n\ntest(\"corners hours old don't move the clock for most of an hour\", function()\n\tlocal app = mount(\"shell_fixture.luau\")\n\tapp:resize(1200, 900)\n\tapp:frames(30)\n\t-- Two hours on: every corner reads hours, the next a whole hour away\n\t-- (once, it moved every half minute, to find nothing changed).\n\t-- (As the clock's own tick moves it: what was due is done.)\n\tlocal at = os.time() + 2 * 3600\n\tapp:set_state(DUE, math.huge)\n\tapp:set_state(CLOCK, at)\n\tapp:frames(5)\n\texpect(corner(app)).to_contain('text \"3h\"')\n\tlocal due = app:state(DUE)\n\texpect(due - at >= 30 * 60).to_be(true)\n\texpect(app:error()).to_be_nil()\nend)\n",
		["apps/zgx/ui/tests/transcript_history_above.test.luau"] = "-- A chat opened again where it was read shows its newest rows first, then its\n-- history arrives above them: the message read stays where it was, from the\n-- frame the rows come in, not only once a correction lands. (Nov 11, beta.5:\n-- going back to a chat, the view showed older rows for a few frames, then\n-- jumped back; the transcript scrolled to the message first, by estimates of\n-- rows not measured yet, though the list kept it in place.) At the very top\n-- of the rows shown, where the list keeps nothing in place, the view is put\n-- back once laid out. On chat_fixture's long working chat.\n\n-- Where message `id` starts below the view's top, if it's laid out.\nlocal function top_of(app: any, id: string): number?\n\tlocal escaped = string.gsub(id, \"%-\", \"%%-\")\n\tlocal view: number? = nil\n\tfor line in app:tree(\"#transcript\"):gmatch(\"[^\\n]+\") do\n\t\tlocal y = line:match(\"#transcript scroll .-%-?%d+,(%-?%d+) %d+x%d+\")\n\t\tif y then\n\t\t\tview = tonumber(y)\n\t\tend\n\t\tlocal row = line:match(`#{escaped} article .- %-?%d+,(%-?%d+) %d+x%d+`)\n\t\tif row and view then\n\t\t\treturn (tonumber(row) :: number) - (view :: number)\n\t\tend\n\tend\n\treturn nil\nend\n\n-- The first message starting at least `below` points down the view.\nlocal function first_below(app: any, below: number): string\n\tlocal view = 0\n\tfor line in app:tree(\"#transcript\"):gmatch(\"[^\\n]+\") do\n\t\tlocal y = line:match(\"#transcript scroll .-%-?%d+,(%-?%d+) %d+x%d+\")\n\t\tif y then\n\t\t\tview = tonumber(y) :: number\n\t\tend\n\t\tlocal id, row = line:match(\"#([%w%-]+) article .- %-?%d+,(%-?%d+) %d+x%d+\")\n\t\tif id and (tonumber(row) :: number) - view >= below then\n\t\t\treturn id\n\t\tend\n\tend\n\terror(\"no message in view\")\nend\n\nlocal function settle(app: any)\n\tapp:wait(\"#never-shown\", { timeout_ms = 250 })\n\tapp:frames(10)\nend\n\n-- The long chat, read up into, left, and opened again with its newest rows\n-- first (their history held back until `history`).\nlocal function opened_again(up: number): any\n\tlocal app = mount(\"chat_fixture.luau\")\n\tapp:resize(960, 700)\n\tapp:frames(20)\n\tapp:command(\"long_chat_cross\")\n\tapp:command(\"go_s7\")\n\tapp:frames(30)\n\tsettle(app)\n\tfor _ = 1, up do\n\t\tapp:wheel(\"#transcript\", { dy = -40 })\n\t\tapp:frames(1)\n\tend\n\tsettle(app)\n\tsettle(app)\n\tapp:command(\"go_s2\")\n\tapp:frames(20)\n\tsettle(app)\n\tapp:command(\"tail_first\")\n\tapp:command(\"go_s7\")\n\tapp:frames(30)\n\tsettle(app)\n\treturn app\nend\n\ntest(\"history arriving above the message read leaves it where it was, from the first frame\", function()\n\tlocal app = opened_again(30)\n\tlocal id = first_below(app, 60)\n\tlocal was = top_of(app, id)\n\texpect(was).never.to_be(nil)\n\tapp:command(\"history\")\n\t-- (Read before any frame's timers run: what the rows' arrival itself did.)\n\texpect(`{id} at {top_of(app, id)}`).to_be(`{id} at {was}`)\n\tfor _ = 1, 6 do\n\t\tapp:frames(1)\n\t\texpect(`{id} at {top_of(app, id)}`).to_be(`{id} at {was}`)\n\tend\n\tsettle(app)\n\texpect(`{id} at {top_of(app, id)}`).to_be(`{id} at {was}`)\n\texpect(app:has('role:button ~\"Jump to latest\"')).to_be(true)\nend)\n\ntest(\"history arriving above the top of the rows shown puts the view back on the message read\", function()\n\tlocal app = opened_again(30)\n\t-- Up to the first of the newest rows, where the list keeps nothing in place.\n\tfor _ = 1, 60 do\n\t\tapp:wheel(\"#transcript\", { dy = -80 })\n\t\tapp:frames(1)\n\tend\n\tsettle(app)\n\tsettle(app)\n\tlocal id = first_below(app, 0)\n\tlocal was = top_of(app, id)\n\texpect(was).never.to_be(nil)\n\tapp:command(\"history\")\n\tsettle(app)\n\tsettle(app)\n\texpect(`{id} at {top_of(app, id)}`).to_be(`{id} at {was}`)\nend)\n",
		["apps/zgx/ui/tests/transcript_scroll_away.test.luau"] = "-- Scrolled away from the end, the view stays where the person took it: it\n-- isn't pulled back to the end. (Nov 14: \"scrolling gets stuck to the\n-- bottom; scroll away and it scrolls you back down\".) Two ways it was:\n-- - a scroll during a send's glide (the prompt rising to the view's top, or\n--   a steer's waiting to land): the glide went on to the end over it;\n-- - a scroll begun within moments of the view's size changing: the end\n--   stayed held, and the next resize, however much later (the sidebar, a\n--   panel, the window), went back to it.\n-- On chat_fixture's `long_chat` (ui/long_chat_fixture.luau).\n\nlocal function settle(app: any)\n\tapp:wait(\"#never-shown\", { timeout_ms = 250 })\n\tapp:frames(10)\nend\n\nlocal function offset(app: any): number\n\treturn app:state(\"chat.transcript.offset\")\nend\n\n-- How far the view is from its end, measured by going there (which holds\n-- the end again: only at the close of a test).\nlocal function from_end(app: any): number\n\tlocal at = offset(app)\n\tapp:scroll(\"#transcript\", 1e6)\n\tapp:frames(4)\n\treturn offset(app) - at\nend\n\nlocal function open(): any\n\tlocal app = mount(\"chat_fixture.luau\")\n\tapp:resize(960, 700)\n\tapp:frames(20)\n\tapp:command(\"long_chat_sent\")\n\tapp:command(\"go_s7\")\n\tapp:frames(30)\n\tsettle(app)\n\treturn app\nend\n\nlocal function send(app: any)\n\tapp:type(\"role:textbox\", \"three and one sounds like the most optional option\")\n\tapp:key(\"Enter\")\nend\n\nlocal function scroll_up(app: any)\n\tfor _ = 1, 10 do\n\t\tapp:wheel(\"#transcript\", { dy = -40 })\n\t\tapp:frames(1)\n\tend\nend\n\ntest(\"scrolled up while a send glides, the view stays where it was taken\", function()\n\tlocal app = open()\n\tsend(app)\n\tapp:frames(3)\n\tscroll_up(app)\n\tsettle(app)\n\tsettle(app)\n\texpect(from_end(app) > 100).to_be(true)\nend)\n\ntest(\"scrolled up just after a resize, a later resize leaves the view where it was\", function()\n\tlocal app = open()\n\tsend(app)\n\tapp:frames(40)\n\tsettle(app)\n\tfor _ = 1, 60 do\n\t\tapp:command(\"long_chat_streams\")\n\t\tapp:frames(2)\n\tend\n\tapp:frames(10)\n\tapp:resize(940, 700)\n\tapp:frames(2)\n\tscroll_up(app)\n\t-- (It rests inside the resize's moment, then a while.)\n\tsettle(app)\n\tapp:wait(\"#never-shown\", { timeout_ms = 800 })\n\tlocal at = offset(app)\n\tapp:resize(900, 700)\n\tapp:frames(10)\n\tsettle(app)\n\texpect(math.abs(offset(app) - at) < 1).to_be(true)\n\texpect(from_end(app) > 100).to_be(true)\nend)\n",
		["apps/zgx/ui/tests/waiting_toasts.test.luau"] = "-- A plugin or template waiting for you to allow it has a notice in the\n-- window's corner, with a Review that opens its consent window, until it's\n-- dealt with or put away (ds/toast, screens/plugins/waiting). Across a load\n-- of the scripts, and a launch, in src/waiting_toast_tests.rs: this kit can't\n-- reload. On ui/waiting_toasts_fixture.luau.\n\nlocal CUA = \"Cua is waiting for you to allow it\"\nlocal RANDOM = \"Random Number is waiting for you to allow it\"\nlocal REVIEW = 'role:status >> role:button \"Review\"'\n\nlocal function open(): any\n\tlocal app = mount(\"waiting_toasts_fixture.luau\")\n\tapp:resize(1200, 800)\n\tapp:frames(20)\n\texpect(app:error()).to_be_nil()\n\treturn app\nend\n\nlocal function run(app: any, command: string)\n\tapp:command(command)\n\tapp:frames(30)\n\texpect(app:error()).to_be_nil()\nend\n\nlocal function shows(app: any, words: string): boolean\n\treturn app:has(`role:status >> \"{words}\"`)\nend\n\nlocal function calls(app: any): string\n\treturn table.concat(app:state(\"waiting_calls\") or {}, \",\")\nend\n\n-- In the card that says `words`, the first node of `kind` called `name`: the\n-- tree lists a card's words, then its buttons.\nlocal function in_card(app: any, words: string, kind: string, name: string): string\n\tlocal seen = false\n\tfor line in string.gmatch(app:tree(), \"[^\\n]+\") do\n\t\tif string.find(line, `\"{words}\"`, 1, true) then\n\t\t\tseen = true\n\t\telseif seen and string.find(line, ` {kind} \"{name}\"`, 1, true) then\n\t\t\treturn \"@\" .. (string.match(line, \"@(%d+)\") :: string)\n\t\tend\n\tend\n\terror(`no {name} in the card saying {words}:\\n{app:tree()}`)\nend\n\n-- (After a click: what it set off has had its frames.)\nlocal function press(app: any, target: string)\n\tapp:click(target)\n\tapp:frames(30)\n\texpect(app:error()).to_be_nil()\nend\n\ntest(\"waiting: each waiting plugin's notice has a Review that opens that plugin's window\", function()\n\tlocal app = open()\n\texpect(app:count(REVIEW)).to_be(0)\n\trun(app, \"waiting.two\")\n\texpect(shows(app, CUA)).to_be(true)\n\texpect(shows(app, RANDOM)).to_be(true)\n\texpect(app:count(REVIEW)).to_be(2)\n\tpress(app, in_card(app, CUA, \"button\", \"Review\"))\n\texpect(calls(app)).to_be(\"review:cua\")\n\tpress(app, in_card(app, RANDOM, \"button\", \"Review\"))\n\texpect(calls(app)).to_be(\"review:cua,review:random-number\")\nend)\n\ntest(\"waiting: a notice stays: past an info toast's time, and after Review, until it's decided\", function()\n\tlocal app = open()\n\trun(app, \"waiting.two\")\n\t-- (Over twice an info toast's 4 seconds, at 60 frames a second.)\n\tapp:frames(500)\n\texpect(shows(app, CUA)).to_be(true)\n\texpect(shows(app, RANDOM)).to_be(true)\n\t-- Review opens the window; nothing's decided yet.\n\tpress(app, in_card(app, CUA, \"button\", \"Review\"))\n\texpect(shows(app, CUA)).to_be(true)\n\t-- Allowed (wherever: the host's list says so): its notice goes, the other stays.\n\trun(app, \"waiting.allow_cua\")\n\texpect(shows(app, CUA)).to_be(false)\n\texpect(shows(app, RANDOM)).to_be(true)\nend)\n\ntest(\"waiting: declined, a notice goes; the plugin's still reviewable on its page\", function()\n\tlocal app = open()\n\trun(app, \"waiting.two\")\n\trun(app, \"waiting.decline_random\")\n\texpect(shows(app, RANDOM)).to_be(false)\n\texpect(shows(app, CUA)).to_be(true)\n\t-- (Cua's card, and each row on the page.)\n\trun(app, \"waiting.plugins_page\")\n\texpect(app:count('role:button \"Review\"')).to_be(3)\nend)\n\ntest(\"waiting: the × is always there, and what it puts away stays away while Plugins keeps its Review\", function()\n\tlocal app = open()\n\trun(app, \"waiting.two\")\n\tpress(app, in_card(app, CUA, \"button\", \"Dismiss\"))\n\texpect(shows(app, CUA)).to_be(false)\n\texpect(shows(app, RANDOM)).to_be(true)\n\t-- The list published again changes nothing.\n\trun(app, \"waiting.two\")\n\texpect(shows(app, CUA)).to_be(false)\n\t-- Still findable: its own row and Review on the Plugins page.\n\trun(app, \"waiting.plugins_page\")\n\texpect(app:has('\"Cua\"')).to_be(true)\n\texpect(app:count('role:button \"Review\"')).to_be(3)\n\t-- A changed one speaks again.\n\trun(app, \"waiting.change_cua\")\n\texpect(shows(app, CUA)).to_be(true)\nend)\n\ntest(\"waiting: of five, the stack shows its four and the fifth waits its turn\", function()\n\tlocal app = open()\n\trun(app, \"waiting.five\")\n\texpect(app:count(REVIEW)).to_be(4)\n\t-- (The newest four; the first comes as one's dealt with.)\n\texpect(shows(app, CUA)).to_be(false)\n\trun(app, \"waiting.five_less\")\n\texpect(shows(app, RANDOM)).to_be(false)\n\texpect(shows(app, CUA)).to_be(true)\n\texpect(app:count(REVIEW)).to_be(4)\n\t-- Every one has its row and Review on the page all the same.\n\trun(app, \"waiting.five\")\n\trun(app, \"waiting.plugins_page\")\n\texpect(app:count('role:button \"Review\"')).to_be(9)\nend)\n\ntest(\"waiting: two plugins with one name have a notice each\", function()\n\tlocal app = open()\n\trun(app, \"waiting.twins\")\n\texpect(app:count(REVIEW)).to_be(2)\nend)\n\ntest(\"waiting: while the list isn't known, what's up stays up\", function()\n\tlocal app = open()\n\trun(app, \"waiting.two\")\n\trun(app, \"waiting.loading\")\n\texpect(app:count(REVIEW)).to_be(2)\nend)\n\ntest(\"waiting: a template waiting has its notice, whose Review opens its window, until it's decided\", function()\n\tlocal app = open()\n\trun(app, \"waiting.template\")\n\texpect(shows(app, \"Dusk is waiting for you to allow it\")).to_be(true)\n\texpect(shows(app, \"A template from someone else.\")).to_be(true)\n\tpress(app, in_card(app, \"A template from someone else.\", \"button\", \"Review\"))\n\texpect(calls(app)).to_be(\"template:dusk-1\")\n\texpect(shows(app, \"Dusk is waiting for you to allow it\")).to_be(true)\n\trun(app, \"waiting.template_done\")\n\texpect(shows(app, \"Dusk is waiting for you to allow it\")).to_be(false)\nend)\n\ntest(\"waiting: a template whose window opened as it came has no notice as well\", function()\n\tlocal app = open()\n\trun(app, \"waiting.template_here\")\n\texpect(shows(app, \"Dusk is waiting for you to allow it\")).to_be(false)\nend)\n\ntest(\"waiting: an action no module declared shows no toast; a function's button does what it says\", function()\n\tlocal app = open()\n\trun(app, \"waiting.unknown_action\")\n\texpect(app:has('\"Nowhere\"')).to_be(false)\n\trun(app, \"waiting.function_toast\")\n\tpress(app, in_card(app, \"Branch deleted\", \"button\", \"Undo\"))\n\texpect(calls(app)).to_be(\"undo\")\n\t-- (Pressed, it's done: this one goes.)\n\texpect(app:has('\"Branch deleted\"')).to_be(false)\nend)\n",
		["apps/zgx/ui/themes_fixture_data.luau"] = "-- Themes as src/themes.rs lists them, for fixtures (ui/themes_fixture.luau,\n-- ui/templates_fixture.luau, the gallery's Themes page): a few of Zeron's\n-- built in, their seeds as crates/theme builtins.rs has them; Ledger's own\n-- (a template's theme.luau, dark only); and what src/themes.rs makes of\n-- tests/fixtures/themes/Harbor Night.json.\n\nlocal M = {}\n\nM.BUILTIN = {\n\t{ id = \"zeron-light\", name = \"Keiki Light\", kind = \"light\", background = \"#ffffff\", raised = \"#ededf0\", text = \"#303035\", muted = \"#62626a\", faint = \"#797981\", accent = \"#5b43e8\", danger = \"#dc2626\", warning = \"#a16207\", success = \"#15803d\", syntax = { \"#6b7280\", \"#5b43e8\", \"#15803d\", \"#a16207\", \"#7e22ce\", \"#2563eb\", \"#be185d\", \"#303035\", \"#52525b\", \"#be185d\", \"#0e7490\", \"#b91c1c\" }, entry = \"zeron\" },\n\t{ id = \"zeron-dark\", name = \"Keiki Dark\", kind = \"dark\", background = \"#060606\", raised = \"#343438\", text = \"#e8e8ea\", muted = \"#a9a9ae\", faint = \"#85858a\", accent = \"#8b7cf6\", danger = \"#f87171\", warning = \"#facc15\", success = \"#34d399\", syntax = { \"#92929a\", \"#8b7cf6\", \"#34d399\", \"#facc15\", \"#c084fc\", \"#60a5fa\", \"#f472b6\", \"#e8e8ea\", \"#a1a1aa\", \"#f472b6\", \"#22d3ee\", \"#f87171\" }, entry = \"zeron\" },\n\t{ id = \"gruvbox-light\", name = \"Gruvbox Light\", kind = \"light\", background = \"#fbf1c7\", raised = \"#d5c4a1\", text = \"#3c3836\", muted = \"#665c54\", faint = \"#7c6f64\", accent = \"#076678\", danger = \"#9d0006\", warning = \"#b57614\", success = \"#79740e\", syntax = { \"#928374\", \"#9d0006\", \"#79740e\", \"#8f3f71\", \"#b57614\", \"#076678\", \"#427b58\", \"#3c3836\", \"#665c54\", \"#9d0006\", \"#af3a03\", \"#cc241d\" }, entry = \"gruvbox\" },\n\t{ id = \"gruvbox-dark\", name = \"Gruvbox Dark\", kind = \"dark\", background = \"#282828\", raised = \"#504945\", text = \"#ebdbb2\", muted = \"#bdae93\", faint = \"#928374\", accent = \"#