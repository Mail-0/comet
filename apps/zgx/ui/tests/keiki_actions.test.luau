local function open(): any
	local app = mount("keiki_fixture.luau")
	app:resize(1240, 850)
	app:command("keiki.signed_in"); app:frames(25)
	app:click('role:button "Design team"'); app:frames(15)
	app:click('role:button "Nova"'); app:frames(15)
	return app
end
local function menu(app: any)
	app:click('role:button "Conversation actions: Release plan"'); app:frames(25)
end
test("Keiki actions rename, pin and archive only the local entry and can restore it", function()
	local app = open(); menu(app)
	app:click('role:button "Rename local entry"'); app:frames(15)
	app:fill('role:textbox "Local conversation title"', "Launch brief")
	app:click('role:button "Save title"'); app:frames(20)
	expect(app:state("keiki.fixture.calls")).to_contain("action:rename:Launch brief")
	app:click('role:button "Pin conversation"'); app:frames(20)
	expect(app:has('role:button "Unpin conversation"')).to_be(true)
	app:click('role:button "Archive local entry"'); app:frames(20)
	expect(app:has('role:button "Restore local entry"')).to_be(true)
	app:click('role:button "Restore local entry"'); app:frames(20)
	expect(app:state("keiki.fixture.calls")).to_contain("action:restore:")
end)
test("Keiki actions deletion requires confirmation and leaves remote history alone", function()
	local app = open(); menu(app)
	app:click('role:button "Delete local entry"'); app:frames(15)
	expect(app:has('~"It does not delete or clear the Keiki conversation"')).to_be(true)
	expect(app:state("keiki.fixture.calls"):find("action:deleteLocal", 1, true) == nil).to_be(true)
	app:click('role:button "Confirm"'); app:frames(20)
	expect(app:state("keiki.fixture.calls")).to_contain("action:deleteLocal:")
	expect(app:state("keiki.fixture.calls"):find("clearHistory", 1, true) == nil).to_be(true)
end)
test("Keiki actions report request errors and retry without losing the dialog", function()
	local app = open(); menu(app)
	app:command("keiki.action_fail"); app:click('role:button "Pin conversation"'); app:frames(20)
	expect(app:has('~"offline"')).to_be(true)
	app:click('role:button "Pin conversation"'); app:frames(20)
	expect(app:has('role:button "Unpin conversation"')).to_be(true)
end)
test("Keiki actions expose takeover only for contacts and end only for peer threads", function()
	local app = open(); app:command("keiki.contact"); menu(app)
	expect(app:has('role:button "Take over conversation"')).to_be(true)
	expect(app:has('role:button "End peer thread"')).to_be(false)
	app:click('role:button "Take over conversation"'); app:frames(20)
	expect(app:state("keiki.fixture.calls")).to_contain("takeover:true")
	app:command("keiki.peer"); menu(app)
	expect(app:has('role:button "End peer thread"')).to_be(true)
	expect(app:has('role:button "Take over conversation"')).to_be(false)
	app:click('role:button "End peer thread"'); app:frames(15)
	app:click('role:button "Confirm"'); app:frames(20)
	expect(app:state("keiki.fixture.calls")).to_contain("action:end:")
end)
test("Keiki group roster shows activity, usage and confirmation before ending work", function()
	local app = open(); app:click('role:button "Group roster: Design team"'); app:frames(20)
	expect(app:has('~"hub · running · 1 turns · 2 asks · 1 tasks"')).to_be(true)
	expect(app:has('~"1200 in / 300 out tokens · $0.04"')).to_be(true)
	app:click('role:button "End group work"'); app:frames(15)
	expect(app:state("keiki.fixture.calls"):find("EndKeikiGroup", 1, true) == nil).to_be(true)
	app:click('role:button "Confirm"'); app:frames(20)
	expect(app:state("keiki.fixture.calls")).to_contain("ended:team:true")
end)
test("Keiki group roster has empty and retryable error states", function()
	local app = open(); app:command("keiki.roster_empty"); app:click('role:button "Group roster: Design team"'); app:frames(20)
	expect(app:has('~"No agents in this group"')).to_be(true)
	app:command("keiki.action_fail"); app:click('role:button "Refresh roster"'); app:frames(20)
	expect(app:has('~"offline"')).to_be(true)
	app:click('role:button "Refresh roster"'); app:frames(20)
	expect(app:has('~"No agents in this group"')).to_be(true)
end)
test("Keiki agent workspace defers Desktop and Browser without starting transports", function()
	local app = open(); app:click('role:button "Agent workspace: Nova"'); app:frames(20)
	expect(app:has('~"Desktop view coming soon"')).to_be(true)
	expect(app:has('~"Browser view coming soon"')).to_be(true)
	expect(app:state("keiki.fixture.calls"):find("Desktop", 1, true) == nil).to_be(true)
	expect(app:state("keiki.fixture.calls"):find("Browser", 1, true) == nil).to_be(true)
	expect(app:state("keiki.fixture.calls")).to_contain("GetKeikiAvatar:nova")
end)
test("Keiki creation lists existing templates and submits the selected template", function()
	local app = open(); app:click('role:button "Create Keiki agent"'); app:frames(20)
	app:click('role:button "Agent template"'); app:frames(15)
	app:click('~"✦ Research partner"'); app:frames(10)
	app:type('role:textbox "Agent name (optional)"', "Sage")
	app:click('role:button "Create agent"'); app:frames(20)
	expect(app:state("keiki.fixture.calls")).to_contain("created:research:Sage")
end)
test("Keiki creation handles empty templates and load errors", function()
	local app = open(); app:command("keiki.templates_empty"); app:click('role:button "Create Keiki agent"'); app:frames(20)
	expect(app:has('~"No templates available"')).to_be(true)
	app:command("keiki.action_fail"); app:click('role:button "Retry templates"'); app:frames(20)
	expect(app:has('~"offline"')).to_be(true)
	expect(app:has('~"Loading templates…"')).to_be(false)
end)
test("Keiki actions close on signout and ignore in-flight completions", function()
	local app = open(); menu(app); app:click('role:button "Pin conversation"'); app:command("keiki.expired"); app:frames(20)
	expect(app:state("keiki.controls.open")).to_be(false)
	app:command("keiki.signed_in"); app:frames(20)
	expect(app:has('role:button "Unpin conversation"')).to_be(false)
end)
test("Keiki pending MCP connections open through the engine and refresh status", function()
	local app = open(); app:command("keiki.open"); app:frames(25); app:command("keiki.mcp"); app:frames(15)
	app:click('role:button "Authorize connection"'); app:frames(20)
	expect(app:has('~"Authorization opened in your browser"')).to_be(true)
	app:click('role:button "Check authorization"'); app:frames(20)
	expect(app:has('~"Connected · reply in composer to continue"')).to_be(true)
	expect(app:state("keiki.fixture.calls")).to_contain("connection:docs:true")
	expect(app:state("keiki.connections")["keiki-bound-demo/docs"].authorizationUrl).to_be(nil)
end)
test("Keiki background tasks show an empty state and cancel only after confirmation", function()
	local app = open(); app:command("keiki.open"); app:frames(25)
	app:command("keiki.tasks_empty"); app:click('role:button "Background tasks"'); app:frames(15)
	expect(app:has('~"No background tasks"')).to_be(true)
	app:command("keiki.tasks"); app:frames(15)
	expect(app:has('~"Review the launch checklist"')).to_be(true)
	app:click('role:button "Cancel task"'); app:frames(15)
	expect(app:state("keiki.fixture.calls"):find("CancelKeikiTask", 1, true) == nil).to_be(true)
	app:command("keiki.action_fail"); app:click('role:button "Confirm"'); app:frames(15)
	expect(app:has('~"offline"')).to_be(true)
	app:click('role:button "Confirm"'); app:frames(20)
	expect(app:state("keiki.fixture.calls")).to_contain("cancelled:review")
end)
test("Keiki sandbox terminal opens the existing terminal panel for its bound chat", function()
	local app = open(); app:command("keiki.open"); app:frames(25)
	app:click('role:button "Sandbox terminal"'); app:frames(15)
	local panel = app:state("panel_sessions")["chat:keiki-bound-demo"]
	expect(panel.tabs[1].kind).to_be("terminal")
end)
