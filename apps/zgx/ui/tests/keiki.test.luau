local function open(signed: boolean?): any
	local app = mount("keiki_fixture.luau")
	app:resize(1200, 850)
	if signed then app:command("keiki.signed_in") end
	app:frames(30)
	return app
end
local function agent(app: any)
	app:click('role:button "Design team"'); app:frames(15)
	app:click('role:button "Nova"'); app:frames(15)
end
local function box(app: any, target: string): any
	local x, y, w, h = app:tree(target):match(" (%-?[%d.]+),(%-?[%d.]+) ([%d.]+)x([%d.]+)")
	return { x = tonumber(x), y = tonumber(y), w = tonumber(w), h = tonumber(h) }
end
test("Keiki section headers align and conversations sit one level below their agent", function()
	local app = open(true)
	agent(app)
	local header = box(app, 'role:text "Keiki"')
	expect(box(app, '~"Ungrouped"').x).to_be(header.x)
	expect(box(app, '~"Local chats"').x).to_be(header.x)
	local group = box(app, 'role:button "Design team"')
	local agent = box(app, 'role:button "Nova"')
	expect(box(app, 'role:button "Release plan"').x - agent.x).to_be(agent.x - group.x)
end)
test("Keiki gate asks engine Auth to sign in and can cancel", function()
	local app = open()
	expect(app:has("#keiki-gate")).to_be(true)
	expect(app:has("#keiki-navigation")).to_be(false)
	app:click('role:button "Sign in to Keiki"'); app:frames(5)
	expect(app:state("keiki.fixture.calls")).to_contain("SignIn")
	expect(app:has('~"Waiting for your browser…"')).to_be(true)
	app:click('role:button "Cancel"'); app:frames(5)
	expect(app:has('role:button "Sign in to Keiki"')).to_be(true)
end)
test("Keiki organization gate uses the engine organization picker", function()
	local app = open()
	app:command("keiki.needs_org"); app:frames(15)
	expect(app:has('~"Choose your organization"')).to_be(true)
	app:click('role:button "Organization"'); app:frames(5)
	app:click('~"Research"'); app:frames(20)
	expect(app:state("keiki.fixture.calls")).to_contain("SelectOrg:research")
	expect(app:has("#keiki-navigation")).to_be(true)
end)
test("Keiki gate retains the existing shell through sign-out and another sign-in", function()
	local app = open(true)
	app:click('role:button "Keiki account"'); app:frames(20)
	app:click('role:button "Sign out"'); app:frames(20)
	expect(app:has('role:button "Sign in to Keiki"')).to_be(true)
	app:command("keiki.signed_in"); app:frames(20)
	expect(app:state("keiki.fixture.builds")).to_be(1)
	expect(app:has('role:button "Fern"')).to_be(true)
end)
test("Keiki account menu contains the organization picker", function()
	local app = open(true)
	app:click('role:button "Keiki account"'); app:frames(20)
	expect(app:has('~"demo@keiki.test"')).to_be(true)
	app:click('role:button "Organization"'); app:frames(5)
	expect(app:has('~"Research"')).to_be(true)
	app:click('~"Research"'); app:frames(20)
	expect(app:state("keiki.account.open")).to_be(false)
	app:click('role:button "Keiki account"'); app:frames(15)
	expect(app:has('role:button "Organization"')).to_be(true)
end)
test("Keiki session expiry closes the account menu and restores the gate", function()
	local app = open(true)
	app:click('role:button "Keiki account"'); app:frames(20)
	app:command("keiki.expired"); app:frames(20)
	expect(app:state("keiki.account.open")).to_be(false)
	expect(app:has('role:button "Sign in to Keiki"')).to_be(true)
end)
test("Keiki grouped agents have paginated conversations and ungrouped agents stay separate", function()
	local app = open(true)
	expect(app:has('role:button "Nova"')).to_be(false)
	expect(app:has('role:button "Fern"')).to_be(true)
	agent(app)
	expect(app:has('role:button "Release plan"')).to_be(true)
	app:click('role:button "Load more conversations"'); app:frames(20)
	expect(app:has('role:button "Earlier ideas"')).to_be(true)
	expect(app:state("keiki.fixture.calls")).to_contain("ListKeikiConversations:nova:50")
	expect(app:has('~"Local chats"')).to_be(true)
end)
test("Keiki loading error and retry states recover without changing Local chats", function()
	local app = open(true)
	app:command("keiki.loading"); app:frames(5)
	expect(app:has('~"Loading your agents…"')).to_be(true)
	app:command("keiki.error"); app:frames(5)
	expect(app:has('role:button "Retry Keiki"')).to_be(true)
	app:click('role:button "Retry Keiki"'); app:frames(15)
	expect(app:has('role:button "Design team"')).to_be(true)
	expect(app:has('~"Local chats"')).to_be(true)
end)
test("Keiki conversation pagination errors offer retry", function()
	local app = open(true)
	app:command("keiki.fail_page"); agent(app)
	expect(app:has('role:button "Retry conversations"')).to_be(true)
	app:click('role:button "Retry conversations"'); app:frames(15)
	expect(app:has('role:button "Release plan"')).to_be(true)
end)
test("Keiki empty organization has an empty state instead of stale agents", function()
	local app = open(true)
	app:command("keiki.empty"); app:frames(10)
	expect(app:has('~"No agents yet."')).to_be(true)
	expect(app:has('role:button "Fern"')).to_be(false)
end)
test("Keiki opens imported history and requests older history on scroll", function()
	local app = open(true)
	app:command("keiki.open"); app:frames(30)
	expect(app:has('~"Imported from your Keiki conversation."')).to_be(true)
	app:command("keiki.scroll_up"); app:frames(20)
	expect(app:state("keiki.fixture.calls")).to_contain("LoadKeikiHistory:keiki-bound-demo:50")
	expect(app:has('~"Earlier imported history"')).to_be(true)
end)
test("Keiki streams through the existing transcript and sends steers through the composer", function()
	local app = open(true)
	app:command("keiki.open"); app:frames(30)
	app:command("keiki.stream"); app:frames(20)
	expect(app:has('~"A streamed Keiki reply"')).to_be(true)
	app:type("role:textbox", "Use the second option"); app:key("Enter"); app:frames(30)
	expect(app:state("keiki.fixture.calls")).to_contain("Steer:keiki-bound-demo:Use the second option")
end)
test("Keiki bound chats use the existing send and stop controls", function()
	local app = open(true)
	app:command("keiki.open"); app:frames(30)
	app:type("role:textbox", "Plan the release"); app:key("Enter"); app:frames(20)
	expect(app:state("keiki.fixture.calls")).to_contain("Send:keiki-bound-demo:Plan the release")
	app:command("keiki.stream"); app:frames(15)
	app:click('role:button "Stop"'); app:frames(20)
	expect(app:state("calls")).to_contain("interrupt:keiki-bound-demo")
end)
test("Keiki opening another conversation preserves the draft and blocks sending to the previous chat", function()
	local app = open(true)
	app:command("keiki.open"); app:frames(30)
	app:type("role:textbox", "Keep this draft")
	app:command("keiki.opening"); app:frames(10)
	app:key("Enter"); app:frames(10)
	expect(app:tree()).to_contain('="Keep this draft"')
	app:command("keiki.opened"); app:frames(10)
	app:click("role:textbox"); app:key("Enter"); app:frames(20)
	expect(app:state("keiki.fixture.calls")).to_contain("Send:keiki-bound-demo:Keep this draft")
end)
test("Keiki question cards are read-only with a composer fallback and resolve into chips", function()
	local app = open(true)
	app:command("keiki.open"); app:frames(30)
	app:command("keiki.question"); app:frames(15)
	expect(app:has('~"Which direction should we take?"')).to_be(true)
	app:command("keiki.question_updated"); app:frames(10)
	expect(app:has('~"Start with a useful example?"')).to_be(true)
	app:command("keiki.question"); app:frames(10)
	expect(app:has('~"Read-only"')).to_be(true)
	local question = box(app, "#keiki-questions")
	local field = box(app, "role:textbox")
	local imported = box(app, '~"Imported from your Keiki conversation."')
	expect(question.y + question.h <= field.y).to_be(true)
	expect(imported.y + imported.h <= question.y).to_be(true)
	expect(app:has('role:button "Submit answer"')).to_be(false)
	app:click('role:button "Reply in composer"'); app:frames(5)
	local focused = ""
	for line in app:tree():gmatch("[^\n]+") do if line:find(" focused", 1, true) then focused = line end end
	expect(focused).to_contain('textbox "Message"')
	app:command("keiki.resolved"); app:frames(15)
	expect(app:has('~"Resolved · Which direction should we take?"')).to_be(true)
	expect(app:has('role:button "Reply in composer"')).to_be(false)
	app:command("keiki.question"); app:frames(15)
	expect(app:has('~"Resolved · Which direction should we take?"')).to_be(false)
	app:command("keiki.resolved"); app:frames(15)
	expect(app:has('~"Resolved · Which direction should we take?"')).to_be(true)
end)
