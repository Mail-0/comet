{
  // Landing page: pure static assets, no worker script. Deploy with
  // `npx wrangler deploy` from this dir. (The worker keeps its historical
  // "comet-landing" name; renaming a worker means a new worker.
  // comet.zeron.sh stays attached for old links.)
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "comet-landing",
  "compatibility_date": "2026-07-01",
  "routes": [
    { "pattern": "zeron.sh", "custom_domain": true },
    { "pattern": "comet.zeron.sh", "custom_domain": true }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "public"
  }
}
